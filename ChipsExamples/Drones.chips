logical Trajectory() init{
    int ticks = 0;
    float setup_altitude = 5.;
    int setup_time = 3000;
    float required_altitude;
} then {
    if(ticks < setup_time){
        required_altitude = setup_altitude;
    } else {
        if (ticks < 6000) {
            required_altitude = required_altitude + 0.001;
        }else{
            if (ticks > 8000){
                required_altitude = required_altitude - 0.003;
            }
        }
    }
    ticks = ticks +1;
    probe(required_altitude);
} ->command(required_altitude)

// Default of this model, 
// - maybe a little to straightforward
// - assumes the drone stays aligned to the horizontal plan
physical Drone(float u = 0., 
    float dt = 0., float windz = 0.)
with {
    Chan previous;
    Chan next;
} init {
    float m = 0.2;
    float GRAVITY = 9.81;
    float altitude = 0.;
    float velocity = 0.;
    float DRAG_COEF = 0.0147;
}then{
    float drag_dir = 1.;
    if(velocity>0.){ drag_dir = -1.; }
    float drag = DRAG_COEF * 
        velocity * velocity * drag_dir;
    float Fp = windz + u + drag;
    float a = (Fp / m) - GRAVITY;
    velocity = velocity + a * dt;
    altitude = altitude + velocity * dt;
    if(altitude < 0.){
        altitude = 0.;
        velocity = 0.;
    }
    probe(altitude);
} -> alt_out(altitude)

logical Wind(float dt)
init {
    float t = 0.;
    float A = .2;
} then {
    t = t + dt;
}
-> pow(sin(t)*A)

spread (float target = input) formation among Drone {} 
-> @(target)
-> previous(target+0.5)
-> next(target-0.5)

spread (float wind_power = input) windspread among Drone {
    float new_amp = 1.1;
} ->@(wind_power)
->next(wind_power/new_amp)
->previous(wind_power*new_amp)


collect (float sum = 0., int number = 0) avg among Drone {
    sum = sum + previous.sum + next.sum + input;
    number = previous.number + next.number + 1;
}->@(sum / ((float) number))
->default(sum, number)

system {

    int nb_drones = 10;
    float dt = 0.01;

    Trajectory traj;

    Wind wind;
    wind.dt(dt);

    Drone [nb_drones] drones;
    PID_CI [nb_drones] local_ctrl;


    for i in range(nb_drones) {

        drones[i].windz((windspread) wind.pow);
        //drones[i].windz(0.);
        local_ctrl[i].goal((formation) traj.command);
        local_ctrl[i].dt(dt);
        local_ctrl[i].measure(drones[i].alt_out);
        local_ctrl[i].Kp(1.3);
        local_ctrl[i].Ki(0.4);
        local_ctrl[i].Kd(.3);
        local_ctrl[i].min(0.);
        local_ctrl[i].max(100.);

        drones[i].u(local_ctrl[i].correction);
        
        drones[i].dt(dt);
        link local_ctrl[i] to drones[i];
        
        if(i < nb_drones -1) {
            drones[i+1].previous(drones[i].next);
            drones[i].next(drones[i+1].previous);
        }
    }
    link traj to drones[nb_drones/2];
    link wind to drones[nb_drones/2];
}