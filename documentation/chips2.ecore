<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="chips" nsURI="http://chips" nsPrefix="chips">
  <eClassifiers xsi:type="ecore:EClass" name="program">
    <eStructuralFeatures xsi:type="ecore:EReference" name="preambles" upperBound="-1"
        eType="#//definitions/definition" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="system" upperBound="-1"
        eType="#//statements/system_statement" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eSubpackages name="instances" nsURI="http://chips/instances" nsPrefix="chips.instances">
    <eClassifiers xsi:type="ecore:EClass" name="variable" abstract="true">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
          iD="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="int_variable" eSuperTypes="#//instances/dataflow_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="float_variable" eSuperTypes="#//instances/dataflow_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="bool_variable" eSuperTypes="#//instances/dataflow_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="collective_variable" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" lowerBound="1"
          eType="#//instances/collective_specific_value"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="value" eType="#//rvalues/dataflow_expression"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="collective_specific_value">
      <eLiterals name="variable"/>
      <eLiterals name="input" value="1"/>
      <eLiterals name="stop" value="2"/>
      <eLiterals name="contextual" value="3"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="dataflow_variable" eSuperTypes="#//instances/variable"/>
    <eClassifiers xsi:type="ecore:EClass" name="channel_variable" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="type_identifier" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="feeds" eType="#//instances/channel_variable"
          eOpposite="#//instances/channel_variable/fedby"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="fedby" eType="#//instances/channel_variable"
          eOpposite="#//instances/channel_variable/feeds"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="related_object" lowerBound="1"
          eType="#//instances/object_variable" eOpposite="#//instances/object_variable/channels"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="contextual_variable" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EReference" name="related_object" lowerBound="1"
          eType="#//instances/object_variable" eOpposite="#//instances/object_variable/context"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="value" eType="#//rvalues/dataflow_expression"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="object_variable" abstract="true" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EReference" name="context" upperBound="-1"
          eType="#//instances/contextual_variable" containment="true" eOpposite="#//instances/contextual_variable/related_object"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="channels" upperBound="-1"
          eType="#//instances/channel_variable" containment="true" eOpposite="#//instances/channel_variable/related_object"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="implemented_by" eType="#//instances/object_variable"
          eOpposite="#//instances/object_variable/implementing"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="implementing" eType="#//instances/object_variable"
          eOpposite="#//instances/object_variable/implemented_by"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="logical_function_variable" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EReference" name="outputs" upperBound="-1"
          eType="#//instances/dataflow_variable" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="inner_variables" upperBound="-1"
          eType="#//instances/dataflow_variable" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="node_variable" eSuperTypes="#//instances/object_variable"/>
    <eClassifiers xsi:type="ecore:EClass" name="physical_function_variable" eSuperTypes="#//instances/object_variable #//instances/logical_function_variable"/>
    <eClassifiers xsi:type="ecore:EClass" name="dataflow_array_variable" abstract="true"
        eSuperTypes="#//instances/array_variable"/>
    <eClassifiers xsi:type="ecore:EClass" name="int_array" eSuperTypes="#//instances/dataflow_array_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="values" upperBound="-1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="float_array" eSuperTypes="#//instances/dataflow_array_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="values" upperBound="-1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="bool_array" eSuperTypes="#//instances/dataflow_array_variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="values" upperBound="-1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="function_array" eSuperTypes="#//instances/array_variable"/>
    <eClassifiers xsi:type="ecore:EClass" name="node_array" eSuperTypes="#//instances/array_variable">
      <eStructuralFeatures xsi:type="ecore:EReference" name="values" upperBound="-1"
          eType="#//instances/node_variable"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="array_variable" abstract="true" eSuperTypes="#//instances/variable">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="collective_array" eSuperTypes="#//instances/array_variable">
      <eStructuralFeatures xsi:type="ecore:EReference" name="values" upperBound="-1"
          eType="#//rvalues/dataflow_expression"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="types" upperBound="-1"
          eType="#//instances/collective_specific_value"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="logical_array" eSuperTypes="#//instances/function_array">
      <eStructuralFeatures xsi:type="ecore:EReference" name="values" upperBound="-1"
          eType="#//instances/logical_function_variable"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="physical_array" eSuperTypes="#//instances/function_array">
      <eStructuralFeatures xsi:type="ecore:EReference" name="values" upperBound="-1"
          eType="#//instances/physical_function_variable"/>
    </eClassifiers>
  </eSubpackages>
  <eSubpackages name="statements" nsURI="http://chips/statements" nsPrefix="chips.statements">
    <eClassifiers xsi:type="ecore:EClass" name="system_statement" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="object_statement" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="dataflow_statement" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="collective_statement" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="implementation_statement" abstract="true"/>
    <eSubpackages name="dataflow" nsURI="http://chips/statements/dataflow" nsPrefix="chips.statements.dataflow">
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_declaration" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/dataflow_variable" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_assignment" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/dataflow_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_foreach" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterator" lowerBound="1"
            eType="#//statements/dataflow/dataflow_declaration" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="statements" upperBound="-1"
            eType="#//statements/dataflow_statement" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterable_expr" lowerBound="1"
            eType="#//rvalues/dataflow_iterable_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_if" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="condition" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="if_statements" upperBound="-1"
            eType="#//statements/dataflow_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_if_else" eSuperTypes="#//statements/dataflow/dataflow_if">
        <eStructuralFeatures xsi:type="ecore:EReference" name="else_statements" upperBound="-1"
            eType="#//statements/dataflow_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="dataflow_array_declaration" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="array" lowerBound="1"
            eType="#//instances/dataflow_array_variable" containment="true"/>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="collective" nsURI="http://chips/statements/collective" nsPrefix="chips.statements.collective">
      <eClassifiers xsi:type="ecore:EClass" name="collective_assignment" eSuperTypes="#//statements/collective_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/collective_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
            eType="#//rvalues/collective_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="collective_foreach" eSuperTypes="#//statements/collective_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterator" lowerBound="1"
            eType="#//statements/dataflow/dataflow_declaration" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="statements" upperBound="-1"
            eType="#//statements/collective_statement" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterable_expr" lowerBound="1"
            eType="#//rvalues/collective_iterable_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="collective_if" eSuperTypes="#//statements/collective_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="condition" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="if_statements" upperBound="-1"
            eType="#//statements/collective_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="collective_if_else" eSuperTypes="#//statements/collective/collective_if">
        <eStructuralFeatures xsi:type="ecore:EReference" name="else_statements" upperBound="-1"
            eType="#//statements/collective_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="collective_declaration" eSuperTypes="#//statements/collective_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/collective_variable" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="collective_array_declaration" eSuperTypes="#//statements/collective_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="array" lowerBound="1"
            eType="#//instances/collective_array" containment="true"/>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="system" nsURI="http://chips/statements/system" nsPrefix="chips.statements.system">
      <eClassifiers xsi:type="ecore:EClass" name="system_node_declaration" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="node" lowerBound="1"
            eType="#//instances/node_variable" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="def" lowerBound="1"
            eType="#//definitions/node_definition"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_node_foreach" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterator" lowerBound="1"
            eType="#//statements/system/system_node_declaration" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="statements" upperBound="-1"
            eType="#//statements/system_statement" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterable_expr" lowerBound="1"
            eType="#//instances/node_array" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_if" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="condition" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="if_statements" upperBound="-1"
            eType="#//statements/system_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_if_else" eSuperTypes="#//statements/system/system_if">
        <eStructuralFeatures xsi:type="ecore:EReference" name="else_statements" upperBound="-1"
            eType="#//statements/system_statement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="implements_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="implemented_object"
            lowerBound="1" eType="#//instances/object_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="implementing_object"
            lowerBound="1" eType="#//instances/object_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="implmentation" lowerBound="1"
            eType="#//definitions/implementation_definition"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_dataflow_declaration" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/dataflow_variable" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_dataflow_assignment" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/dataflow_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_function_declaration" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="function" lowerBound="1"
            eType="#//instances/logical_function_variable" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="definition" lowerBound="1"
            eType="#//definitions/function_definition"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_function_foreach" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterator" lowerBound="1"
            eType="#//statements/system/system_function_declaration" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="statements" upperBound="-1"
            eType="#//statements/system_statement" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterable_expr" lowerBound="1"
            eType="#//rvalues/function_iterable_expression" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_dataflow_array_declaration"
          eSuperTypes="#//statements/system_statement"/>
      <eClassifiers xsi:type="ecore:EClass" name="channel_plugging" eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="eating_channel" lowerBound="1"
            eType="#//instances/channel_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="feeding_channel" lowerBound="1"
            eType="#//rvalues/feeding_channel"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_dataflow_array_assignment"
          eSuperTypes="#//statements/system_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="variable" lowerBound="1"
            eType="#//instances/dataflow_array_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
            eType="#//rvalues/dataflow_expression" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="index" lowerBound="1"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="system_dataflow_foreach" eSuperTypes="#//statements/dataflow_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterator" lowerBound="1"
            eType="#//statements/dataflow/dataflow_declaration" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="statements" upperBound="-1"
            eType="#//statements/dataflow_statement" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="iterable_expr" lowerBound="1"
            eType="#//rvalues/dataflow_iterable_expression" containment="true"/>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="implementation" nsURI="http://chips/statements/implementation"
        nsPrefix="chips.statements.implementation">
      <eClassifiers xsi:type="ecore:EClass" name="channel_aliasing" eSuperTypes="#//statements/implementation_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="implementing_channel"
            lowerBound="1" eType="#//instances/channel_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="implemented_channel"
            lowerBound="1" eType="#//instances/channel_variable"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="contextual_aliasing" eSuperTypes="#//statements/implementation_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="implementing_channel"
            lowerBound="1" eType="#//instances/channel_variable"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="implemented_channel"
            lowerBound="1" eType="#//instances/channel_variable"/>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="object" nsURI="http://chips/statements/object" nsPrefix="chips.statements.object">
      <eClassifiers xsi:type="ecore:EClass" name="channel_declaration" eSuperTypes="#//statements/object_statement">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="type_identifier" lowerBound="1"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="contextual_declaration" eSuperTypes="#//statements/object_statement">
        <eStructuralFeatures xsi:type="ecore:EReference" name="value" eType="#//rvalues/dataflow_expression"
            containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="identifier" lowerBound="1"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eClassifiers>
    </eSubpackages>
  </eSubpackages>
  <eSubpackages name="parameters" nsURI="http://chips/parameters" nsPrefix="chips.parameters">
    <eClassifiers xsi:type="ecore:EClass" name="parameter" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="dataflow_parameter" eSuperTypes="#//parameters/parameter">
      <eStructuralFeatures xsi:type="ecore:EReference" name="default_value" eType="#//rvalues/dataflow_expression"
          containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="physical_parameter" eSuperTypes="#//parameters/parameter">
      <eStructuralFeatures xsi:type="ecore:EReference" name="default_value" eType="#//rvalues/dataflow_expression"
          containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="sensor" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="collective_parameter" eSuperTypes="#//parameters/parameter">
      <eStructuralFeatures xsi:type="ecore:EReference" name="default_value" lowerBound="1"
          eType="#//rvalues/collective_expression" containment="true"/>
    </eClassifiers>
  </eSubpackages>
  <eSubpackages name="outputs" nsURI="http://chips/outputs" nsPrefix="chips.outputs">
    <eClassifiers xsi:type="ecore:EClass" name="output" abstract="true"/>
    <eClassifiers xsi:type="ecore:EClass" name="pure_output" eSuperTypes="#//outputs/output">
      <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
          eType="#//rvalues/dataflow_expression" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="logical_output" eSuperTypes="#//outputs/function_output"/>
    <eClassifiers xsi:type="ecore:EClass" name="physical_output" eSuperTypes="#//outputs/function_output">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="actuator" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="collective_output" abstract="true"
        eSuperTypes="#//outputs/output">
      <eStructuralFeatures xsi:type="ecore:EReference" name="expr" lowerBound="1"
          eType="#//rvalues/collective_expression"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="default_output" eSuperTypes="#//outputs/collective_output"/>
    <eClassifiers xsi:type="ecore:EClass" name="target_output" eSuperTypes="#//outputs/collective_output"/>
    <eClassifiers xsi:type="ecore:EClass" name="channeled_output" eSuperTypes="#//outputs/collective_output">
      <eStructuralFeatures xsi:type="ecore:EReference" name="channel" lowerBound="1"
          eType="#//statements/object/channel_declaration"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="function_output" abstract="true" eSuperTypes="#//outputs/output">
