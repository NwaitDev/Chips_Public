@cpp(src="../../../utils/printing.cpp,blinky_processes.cpp,../../ControllerBIPInterface.cpp,../PIDController.cpp", include="../../../utils/printing.hpp,blinky_processes.hpp,../../ControllerBIPInterface.hpp,../PIDController.hpp")

package blinky

    extern data type CppOutStream
    extern data type ControllerPtr
    extern function CppOutStream openStream(string)
    extern function printInStream(CppOutStream, string)
    extern function printInStream(CppOutStream, float)
    extern function printInStream(CppOutStream, int)
    extern function closeStream(CppOutStream)
    extern function loop_process(ControllerPtr pid, int rx1,int tx2,int tx5,int tx6, int r, int g, int b, int rB, int gB, int bB, int sound)
    extern function ControllerPtr create_pid_controller(float kp, float ki, float kd)
    extern function float execute_controller(ControllerPtr controller, float targetValue, float currentValue, float dt)
    extern function destroy_controller(ControllerPtr controller)
    extern function float cast_as_float(int)

    port type port1int_t(int v)
    port type internal_port_t()
    
    connector type flow1int_t(port1int_t src, port1int_t target)
        define src target
        on src target down { target.v = src.v; }
    end

    atom type microphone_t()
        data int sound
        export port port1int_t external_sound(sound)
        export port port1int_t transmission(sound)
        place LISTEN, TRANSMIT
        initial to LISTEN do { sound = 0; }
        on external_sound from LISTEN to TRANSMIT
        on transmission from TRANSMIT to LISTEN
    end

    atom type mcu_t(int id)
        data int nb_loops
        data CppOutStream fileStream
        data ControllerPtr myController
        data int rx1
        data int tx2, tx5, tx6
        data int r, g, b
        data int rB, gB, bB
        data int sound

        port internal_port_t compute()
        port internal_port_t saveData()
        port internal_port_t stop()

        export port port1int_t microphone(sound)

        place IDLE, READY_CALC, SAVE_DATA, FINISHED

        initial to IDLE do {
            nb_loops = 0;
            fileStream = openStream("dataPID");
            printInStream(fileStream, "time sound r g b tx2 rx1\n");
            myController = create_pid_controller(0.6,0.1,0.01);
            rx1 = 0; rB = 0; gB = 0; bB = 0; r = 0; g = 0; b = 0; tx2 = 0; tx5 = 0; tx6 = 0; sound = 0;
        }

        on microphone from IDLE to READY_CALC

        on compute from READY_CALC to SAVE_DATA do {
            rx1 = rB + gB + bB;
            loop_process(
                myController,
                rx1, tx2, tx5, tx6, r, g, b, rB, gB, bB, sound
            );
        }

        on saveData from SAVE_DATA to IDLE provided (nb_loops < 500) do {
            printInStream(fileStream, nb_loops);
            printInStream(fileStream, sound);
            printInStream(fileStream, cast_as_float(r));
            printInStream(fileStream, cast_as_float(g));
            printInStream(fileStream, cast_as_float(b));
            printInStream(fileStream, cast_as_float(tx2));
            printInStream(fileStream, cast_as_float(rx1));
            printInStream(fileStream, "\n");
            nb_loops = nb_loops + 1;
        }

        on stop from SAVE_DATA to FINISHED provided (nb_loops >= 500) do {
            closeStream(fileStream);
            destroy_controller(myController);
        }
    end

    compound type BlinkyBlock(int id)
        component mcu_t mcu(id)
        component microphone_t microphone()
        connector flow1int_t mic2mcu(microphone.transmission, mcu.microphone)
        export port microphone.external_sound as sound_input
    end
end