import "math_utils" as math;

pure myFunction -> (int result)
myFunction(int x, int y) {
    result = x + y;
}

virtual myObject -> (float output)
myObject(int input) init {
    myVar = input * 2;
} then {
    this.knobs.threshold = 10;
}

SYSTEM dimensions(4) {
    link sensor1 to actuator1;
    foreach idx in 10 {
        if (idx < 5) {
            myVar = myFunction(idx, 2);
        } else {
            myVar = math.sqrt(idx);
        }
    }
}
