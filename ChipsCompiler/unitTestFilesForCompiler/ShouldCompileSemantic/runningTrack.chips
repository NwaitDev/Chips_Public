// Control of Hierarchizable Interconnected Programmable Systems

import "BlinkyBlock.json" as BlinkyBlock;

pure pcoef() -> (0.5)
pure icoef() -> (0.5)
pure dcoef() -> (0.6)

pure pid(float error, float ierror, float derror) 
		-> (pcoef()*error+icoef()*ierror+dcoef()*derror)

pure errorf(float expected, float received) 
		-> (expected - received)


// control operation from the control theory perspective
virtual control(float expected, float received) init {
    float derivative = 0;
    float integral = 0;
    float lasterror = 0;
    float error = 0;
    float out = pid(error, integral, derivative);
} then {
    error = errorf(expected, received);
    derivative = (lasterror-error)/dt;
    integral = integral+error*dt;
    lasterror = error;
    out = pid(error, integral, derivative);
} -> (out)


// System input and output 
// (in a future version, will allow to 
//  hierarchically instanciate chips subsystems)
pure input() -> (sin(t)*sin(t))
pure output(float any) -> (any)


// Motif profile operator
virtual profile (float knob, int nbdevices) init {
	int oldnbdevices = nbdevices;
	int [nbdevices] subknobs = 0;
	int current = 0;
} then {
	if(nbdevices == oldnbdevices){
		subknobs[current] = 0;
	}else{
		oldnbdevices = nbdevices;
		subknobs = zeros(nbdevices);
	}
	current = int(knob*nbdevices);
	subknobs[current] = 1;
} -> (subknobs)

// Types de tableaux en fonction de leur description ?
// eg : subknobs = {0,0,0,1,0,0} -> indicator 4
// eg : subknobs = {0,1,2,3,4,5} -> linear 0 1
// eg : subknob = {2,1,0,-1,-2} -> linear 2 -1
// eg : subknob = {3,3,3,3,3,3} -> cst 3

// description de tableaux en compréhension ?
// eg : subknobs = { i==4 ? 1 : 0 | i in length } 
// eg : subknobs = { i | i in length }
// eg : subknobs = { 2-i | i in length }
// eg : subknobs = { 3 | i in length }



// Motif aggregation operator
virtual aggregation (int[] outputs, int nbdevices) init {
	int out = 0;
} then {
    out = aggregate(outputs, posmax);
} -> (float(out)/nbdevices)


// Counting resilient operator
virtual count (int[] outputs) init {
    int nbdevices = 0;
    int updt = 0;
} then {
    if(updt==0){
        nbdevices = aggregate(outputs, sum);
    }
    updt = (updt+1)%3;
} -> (nbdevices)


// Blinky block function representation
physical BlinkyBlock(int input) init {
    this.actuators.lightR = 0;
} then {
    this.actuators.lightR = input;
} -> (this.actuators.lightR, 1)



SYSTEM dimensions(1) {
    int devices = 12;
    control controller;
    profile profiler;
    aggregation aggregator;
    count counter;

    BlinkyBlock[devices] blinkies;
    int[devices] blinkiesOutputs;
    int[devices] blinkiesPresence;

    link counter to aggregator;
    link counter to profiler;
    link controller to profiler;
    link controller to aggregator;

    controller.in(input.out, aggregator.out);
    profiler.in(controller.out, counter.out);    

    int i = 0;
    foreach blinky in blinkies {
        blinky at (i);
        blinky.in(profile.out[i]);
        blinkiesOutputs[i] = blinky.out[0];
        blinkiesPresence[i] = blinky.out[1];
        link profiler to blinky;
        link aggregator to blinky;
        i = i + 1;
    }

    aggregator.in(blinkiesOutputs, counter.out);
    counter.in(blinkiesPresence);
    output.in(aggregator.out);
}