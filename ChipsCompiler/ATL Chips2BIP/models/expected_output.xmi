          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="time"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="cacheSearching"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="oneLessPendingRequest_inner"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="userID_o"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="cacheRequest"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="oneLessPendingRequest"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="timeSpentOnReq"/>
          <parameters xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="enableTimeReading"/>
