      <dataParameters parameterDeclaration="v3" type="float" dataDeclarationReference="timeSpentOnReq"/>
      <dataParameters parameterDeclaration="v4" type="bool" dataDeclarationReference="enableTimeReading"/>
    </internalPortDeclarations>
    <behavior initStates="INIT">
      <states name="INIT"/>
      <states name="RECEIVING"/>
      <states name="THEN"/>
      <states name="SENDING"/>
      <transitions sources="INIT" destinations="RECEIVING" triggerPort="start">
        <guard xsi:type="bip2.ujf.verimag.bip.actionlang:UnaryOpExpression" operator="!">
          <operand xsi:type="bip2.ujf.verimag.bip.actionlang:DirectDataDeclarationReferenceExpression" dataDeclaration="isSource"/>
        </guard>
