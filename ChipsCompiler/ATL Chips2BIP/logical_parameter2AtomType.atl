module chips2bip;

-- @path Chips=/Chips2Bip/Chips1.1.ecore
-- @path BIP=/Chips2Bip/BIP.ecore

create OUT: BIP from IN: Chips;

helper context String def : serialized() : String = 
	self.replaceAll('_','__');


abstract rule logical_parameter2ReceiverAtomType {
	from 
		lp: Chips!logical_parameter
	to
		at:BIP!AtomType(
			name <- lp.name.serialized(),
			native <- false,
		)
		
}

unique lazy rule int_logical_parameter2ReceiverAtomType extends logical_parameter2ReceiverAtomType {
	from 
		lp: Chips!int_logical_parameter
	to
		at:BIP!AtomType(
			internalDataDeclaration <- , -- TODO
			internalPortDeclaration <- , -- TODO
			exportedPortDeclarations <- , --TODO
			behavior <- , -- TODO (petri net)
		)
}

