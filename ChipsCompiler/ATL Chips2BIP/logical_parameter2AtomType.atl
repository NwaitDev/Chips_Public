abstract rule primitive_declaration2internalDataDeclarations {
	from
		primdecl: Chips!primitive_declaration
	to
		idd:BIP!AtomInternalPortDeclaration(
			const <- false -- first inherited attribute from DataDeclaration
		)
}

unique lazy rule int_declaration2internalDataDeclarations extends primitive_declaration2internalDataDeclarations {
	from
		intdecl: Chips!int_declaration
	to
		idd:BIP!AtomInternalPortDeclaration(
			dataType <- , --TODO -- first inherited attribute from DataDeclaration
