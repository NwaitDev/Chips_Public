-- getNames helpers
-------------------

helper context chips!physical_collective_cast def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.collective_function.name + '_on_' + self.physical_feeder_expression.getName(memory);

helper context chips!int_physical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

helper context chips!physical_int_eater def: getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.variable.variable.name+
	self.variable.index->getName(memory)
	+'_'+self.parameter.name;

helper context chips!float_physical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

helper context chips!physical_float_eater def: getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.variable.variable.name+
	self.variable.index->getName(memory)
	+'_'+self.parameter.name;

helper context chips!bool_physical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

helper context chips!physical_bool_eater def: getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.variable.variable.name+
	self.variable.index->getName(memory)
	+'_'+self.parameter.name;

helper context chips!logical_collective_cast def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.collective_function.name + '_on_' + self.logical_feeder_expression.getName(memory);

helper context chips!int_logical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
