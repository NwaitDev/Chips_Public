			type <- conntype,
			portParameters <- portparameters,
			name <- name
		)
}



unique lazy rule FunctionDefinition2CompoundType {
	from 
		chipsfunction: chips!function_definition

	using {
		all_inputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_inputs;
		all_outputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_outputs;

		only_parameter : bip!ComponentDataParameterDeclaration = 
			thisModule.MakeComponentDataParameterDeclaration('compound_starts','bool');

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = 
			thisModule.MakeCoreComponentDeclaration(chipsfunction);
			
		input_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_input_buffer',
				thisModule.MakeInputBufferType(all_inputs)
			);

		output_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_output_buffer',
				thisModule.MakeOutputBufferType(all_outputs)
			);

	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name,
		-- dataParameterDeclarations <- Sequence{thisModule.MakeStartParameter(thisModule.makeCoreScope(chipsfunction))},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(input_buffer_declaration)
			->append(output_buffer_declaration)--,
		--connectorDeclarations<- Sequence{flow_input_to_core}--,
		--exportPortDeclarations <- exportedportdecl
	)
}

unique lazy rule MakeInputBufferType{
	from parameters : Sequence(TupleType(type:String,name:String))

	using{
		monotype_buffers : Sequence(bip!ComponentDeclaration) = 
			parameters->collect(t | thisModule.MakeMonoTypeBufferComponentDeclaration(t.type,t.name));

		connector_type : bip!ConnectorType =
			thisModule.MakeMany2OneConnectorType(parameters->collect(t | t.type));
		
		all_inputs : Sequence(TupleType(type:String,iindex:Integer,name:String)) =
			parameters->augmentWithIindex()
			->collect(t | Tuple{type=t.data.type,iindex=t.iindex,name=t.data.name});

		input_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			all_inputs->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.MakeMany2OnePortDeclarationReferenceParameter(
						all_inputs->collect(t2|t2.type),
						t.iindex
					),
					thisModule.MakeAtomSubPortDeclarationReference(
						thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(
							t.type,
							false -- because this connector transmits data FROM the buffer to the core component 
						),
						monotype_buffers->get(t.iindex)
					)
				)
			);

		input_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				parameters->iterate(s ; acc:String = '' | acc+s.type)+'_input_connector',
				thisModule.MakeMany2OneConnectorType(all_inputs->collect(t|t.type)),
				input_connector_port_parameters
			);
		
		exported_many : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'many',
				all_inputs->collect(t|t.type),
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.MakeMany2OneExportedPortDeclaration(
							all_inputs->collect(t| Tuple{type=t.type,iindex=t.iindex}),
							all_inputs->collect(t| thisModule.MakeMany2OneConnectorDataDeclaration(
								t.type,t.iindex,all_inputs->collect(t2|t2.type)
							))
						),
						input_connector_decl
					)
				}
			);
		exported_monotype_inputs : Sequence(bip!CompoundExportPortDeclaration) =
			all_inputs->collect(t | 
				thisModule.MakeCompoundExportPortDeclaration(
					t.name+'_exin',
					Sequence{t.type},
					Sequence{
						thisModule.MakeAtomSubPortDeclarationReference(
							thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(
								t.type,
								true -- this is an input, its the port exposed to the rest of the system
							),
							monotype_buffers->get(t.iindex)
						)
					}
				)
			);
	}

	to ibt : bip!CompoundType(
		name <- parameters->iterate(s ; acc:String = ''| acc+s.type)+'_input_buffer_t',
        native <- false,
        exportedPortDeclarations <- exported_monotype_inputs->append(exported_many), -- export the outer port of the connector
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- monotype_buffers,
		connectorDeclarations <- Sequence{input_connector_decl},
		exportPortDeclarations <- exported_monotype_inputs->append(exported_many)
	)
}

unique lazy rule MakeOutputBufferType{
	from parameters : Sequence(TupleType(type:String,name:String))

	using{
		monotype_buffers : Sequence(bip!ComponentDeclaration) = 
			parameters->collect(t | thisModule.MakeMonoTypeBufferComponentDeclaration(t.type,t.name));

		connector_type : bip!ConnectorType =
			thisModule.MakeOne2ManyConnectorType(parameters->collect(t | t.type));
		
		all_outputs : Sequence(TupleType(type:String,iindex:Integer,name:String)) =
			parameters->augmentWithIindex()
			->collect(t | Tuple{type=t.data.type,iindex=t.iindex,name=t.data.name});

		output_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			all_outputs->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.MakeOne2ManyPortDeclarationReferenceParameter(
						all_outputs->collect(t2|t2.type),
						t.iindex
					),
					thisModule.MakeAtomSubPortDeclarationReference(
						thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(
							t.type,
							true -- because this connector transmits data from the core component TO the buffer 
						),
						monotype_buffers->get(t.iindex)
					)
				)
			);

		output_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				parameters->iterate(s ; acc:String = '' | acc+s.type)+'_output_connector',
				thisModule.MakeOne2ManyConnectorType(all_outputs->collect(t|t.type)),
				output_connector_port_parameters
			);
		
		exported_one : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'one',
				all_outputs->collect(t|t.type),
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.MakeOne2ManyExportedPortDeclaration(
							all_outputs->collect(t| Tuple{type=t.type,iindex=t.iindex}),
							all_outputs->collect(t| thisModule.MakeOne2ManyConnectorDataDeclaration(
								t.type,t.iindex,all_outputs->collect(t2|t2.type)
							))
						),
						output_connector_decl
					)
				}
			);
		exported_monotype_outputs : Sequence(bip!CompoundExportPortDeclaration) =
			all_outputs->collect(t | 
				thisModule.MakeCompoundExportPortDeclaration(
					t.name+'_exout',
					Sequence{t.type},
					Sequence{
						thisModule.MakeAtomSubPortDeclarationReference(
							thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(
								t.type,
								false -- this is NOT an input, its the port exposed to the rest of the system
							),
							monotype_buffers->get(t.iindex)
						)
					}
				)
			);
	}

	to ibt : bip!CompoundType(
		name <- parameters->iterate(s ; acc:String = ''| acc+s.type)+'_output_buffer_t',
        native <- false,
        exportedPortDeclarations <- exported_monotype_outputs->append(exported_one), -- export the outer port of the connector
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- monotype_buffers,
		connectorDeclarations <- Sequence{output_connector_decl},
		exportPortDeclarations <- exported_monotype_outputs->append(exported_one)
	)
}

