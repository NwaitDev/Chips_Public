helper context chips!function_definition def : extractInputPDeclsRefParams() : Sequence(bip!PortDeclarationReferenceParameter) = 
	let input_is_many2one:Boolean = true in
	let parameters_of_input_buffer_list : Sequence(TupleType(datatype: String,dataname: String)) = 
		self.all_decl_params->collect(param | Tuple{datatype = param.type, dataname=param.name}) in
	let input_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
		parameters_of_input_buffer_list->collect(
			param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(
					param.datatype,	
					param.dataname,
					thisModule.makeInputCoreScope(
						parameters_of_input_buffer_list->collect(t|t.datatype)
					)
				)
			}
		) in
	let input_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = 
		parameters_of_input_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex}) in
	let input_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = 
		input_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,input_is_many2one)) in
	let input_datadecls: Sequence(bip!ConnectorDataDeclaration) =
		input_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t.type, t.iindex)) in
	let	input_epdecl: bip!ConnectorExportedPortDeclaration =
		thisModule.MakeConnectorExportedPortDeclaration(input_indexed_types, input_is_many2one, input_datadecls) in 
	let input_connector_type : bip!ConnectorType = 
		thisModule.MakeMany2OneConnectorType(input_indexed_types->collect(t | t.type)) in 
	input_indexed_types->asPortDeclRefParamSequence(
		input_one_type_buffer_list->collect(p | p.component),
		input_epdecl,
		input_is_many2one,
		self.name
	);

helper context chips!function_definition def: extractInputConnExportPortDecl() : bip!CompoundExportPortDeclaration = 
	let input_is_many2one:Boolean = true in
	let parameters_of_input_buffer_list : Sequence(TupleType(datatype: String,dataname: String)) = 
		self.all_decl_params->collect(param | Tuple{datatype = param.type, dataname=param.name}) in
	let input_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
		parameters_of_input_buffer_list->collect(
			param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(
					param.datatype,	
					param.dataname,
					thisModule.makeInputCoreScope(
						parameters_of_input_buffer_list->collect(t|t.datatype)
					)
				)
			}
		) in
	let input_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = 
		parameters_of_input_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex}) in
	let input_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = 
		input_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,input_is_many2one)) in
	let input_datadecls: Sequence(bip!ConnectorDataDeclaration) =
		input_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t.type, t.iindex)) in
	let	input_epdecl: bip!ConnectorExportedPortDeclaration =
		thisModule.MakeConnectorExportedPortDeclaration(input_indexed_types, input_is_many2one, input_datadecls) in 
	let input_connector_type : bip!ConnectorType = 
		thisModule.MakeMany2OneConnectorType(input_indexed_types->collect(t | t.type)) in 
	let input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) = 
		input_indexed_types->asPortDeclRefParamSequence(
			input_one_type_buffer_list->collect(p | p.component),
			input_epdecl,
			input_is_many2one,
			self.name
		) in 
	let input_conndecl:bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			input_connector_type,
			input_pdeclsrefparam,
			'to_the_core'
		) in
	let input_connsubportdecl: bip!SubPortDeclarationReference = 
		thisModule.MakeConnectorSubPortDeclarationReference(
			input_epdecl,
			input_conndecl
		) in
	thisModule.MakeCompoundSubConnExportPortDeclaration(
		thisModule.MakePortType(input_indexed_types->collect(t | t.type)),
		'to_the_core',
		input_connsubportdecl
	);

helper context chips!function_definition def: extractInputBufferCompoundType() : bip!CompoundType =
	let input_is_many2one:Boolean = true in
	let parameters_of_input_buffer_list : Sequence(TupleType(datatype: String,dataname: String)) = 
		self.all_decl_params->collect(param | Tuple{datatype = param.type, dataname=param.name}) in
	let input_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
		parameters_of_input_buffer_list->collect(
			param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(
					param.datatype,	
					param.dataname,
					thisModule.makeInputCoreScope(
						parameters_of_input_buffer_list->collect(t|t.datatype)
					)
				)
			}
		) in
	let input_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = 
		parameters_of_input_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex}) in
	let input_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = 
		input_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,input_is_many2one)) in
	let input_datadecls: Sequence(bip!ConnectorDataDeclaration) =
		input_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t.type, t.iindex)) in
	let	input_epdecl: bip!ConnectorExportedPortDeclaration =
		thisModule.MakeConnectorExportedPortDeclaration(input_indexed_types, input_is_many2one, input_datadecls) in 
	let input_connector_type : bip!ConnectorType = 
		thisModule.MakeMany2OneConnectorType(input_indexed_types->collect(t | t.type)) in 
	let input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) = 
		input_indexed_types->asPortDeclRefParamSequence(
			input_one_type_buffer_list->collect(p | p.component),
			input_epdecl,
			input_is_many2one,
			self.name
		) in 
	let input_conndecl:bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			input_connector_type,
			input_pdeclsrefparam,
			'to_the_core'
		) in
	let input_connsubportdecl: bip!SubPortDeclarationReference = 
		thisModule.MakeConnectorSubPortDeclarationReference(
			input_epdecl,
			input_conndecl
		) in
	let input_connexportportdecl: bip!CompoundExportPortDeclaration = 
		thisModule.MakeCompoundSubConnExportPortDeclaration(
			thisModule.MakePortType(input_indexed_types->collect(t | t.type)),
			'to_the_core',
			input_connsubportdecl
		) in
	let input_subcompoundexportportdecl: Sequence(bip!CompoundExportPortDeclaration) = 
		parameters_of_input_buffer_list->collect(
			parameter | thisModule.MakeCompoundSubCompExportPortDeclaration(
				parameter.datatype,
				parameter.dataname,
				thisModule.MakeAEPD(
					'from_the_outside',
					Sequence{parameter.datatype},
					Sequence{parameter.dataname},
					thisModule.makeOutputCoreScope(
						parameters_of_input_buffer_list->collect(t | t.datatype)
					)
				), 
				input_one_type_buffer_list->any(comp | comp.name = parameter.dataname).component
			)
		) in
		thisModule.MakeCompoundType(
			self.name+'RX',
			Sequence{},
			input_one_type_buffer_list->collect(t | t.component),
			Sequence{input_conndecl},
			input_subcompoundexportportdecl->union(Sequence{input_connexportportdecl})
		);


helper context chips!function_definition def : extractOutputPDeclsRefParams() : Sequence(bip!PortDeclarationReferenceParameter) = 
	let output_is_many2one:Boolean = false in
	let parameters_of_output_buffer_list : Sequence(TupleType(datatype: String,dataname: String)) = 
		self.all_decl_params->collect(param | Tuple{datatype = param.type, dataname=param.name}) in
