	memory->including(Tuple{
		key='from_'+self.feeder->evaluate(memory)->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='int_connector', 
