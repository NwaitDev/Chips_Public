helper context Sequence(TupleType(type: String)) def : 
AllParametersToNiceTuple(sort:String) : 
Sequence(
	TupleType(
		datatype:String, 
		aidd: bip!AtomInternalDataDeclaration, 
		ddrdp: bip!DataDeclarationReferenceDataParameter, 
		aipd: bip!AtomInternalPortDeclaration,
		aepd: bip!AtomExportPortDeclaration 
	)
) =
	let all_aidd : Sequence(
		TupleType(
			datatype : String,
			aidd:bip!AtomInternalDataDeclaration
		)
	) = self->collect(tuple | 
			Tuple{
				datatype = tuple.type,
				aidd = thisModule.MakeAtomInternalDataDeclaration(tuple.type)
			}
		) in 
	let all_ddrdp : Sequence(
		TupleType(
			datatype:String,
			aidd:bip!AtomInternalDataDeclaration,
			ddrdp:bip!DataDeclarationReferenceDataParameter
		)
	) = all_aidd->collect(tuple | 
			Tuple{
				datatype = tuple.datatype,
				aidd = tuple.aidd,
				ddrdp = thisModule.MakeAtomDataDeclarationReferenceDataParameter(tuple.datatype,tuple.aidd)
			}
		) in
	let all_aipd : Sequence(
		TupleType(
			datatype:String,
			aidd:bip!AtomInternalDataDeclaration,
			ddrdp:bip!DataDeclarationReferenceDataParameter,
			aipd:bip!AtomInternalPortDeclaration
		)
	) = all_ddrdp->collect(tuple | 
			Tuple{
				datatype = tuple.datatype,
				aidd = tuple.aidd,
				ddrdp = tuple.ddrdp,
				aipd = thisModule.MakeAtomInternalPortDeclaration(tuple.datatype, '_'+sort,tuple.ddrdp)
			}
		) in
	all_aipd->collect(tuple | 
		Tuple{
			datatype = tuple.datatype,
			aidd = tuple.aidd,
			ddrdp = tuple.ddrdp,
			aipd = tuple.aipd,
			aepd = thisModule.MakeAtomExternalPortDeclaration(tuple.datatype, sort, tuple.ddrdp, tuple.aipd)
		}
	);

lazy rule MakeConnectorDeclaration{
	from 
		conntype : bip!ConnectorType,
		portparameters: Sequence(bip!PortDeclarationReferenceParameter),
		name:String
	to 
		conn:bip!ConnectorDeclaration(
			type <- conntype,
			portParameters <- portparameters,
			name <- name
		)
}

unique lazy rule MakeCompoundType{
	from
		n:String,
		dpd : Sequence(bip!ComponentDataParameterDeclaration),
		compd: Sequence(bip!ComponentDeclaration),
		connd: Sequence(bip!ConnectorDeclaration),
		epd: Sequence(bip!CompoundExportPortDeclaration)
	to
		ct:bip!CompoundType(
			name <- n,
			dataParameterDeclarations <- dpd,
			componentDeclarations <- compd,
			connectorDeclarations <- connd,
			exportPortDeclarations <- epd
		)
}

unique lazy rule FunctionDefinition2CompoundType {
	from 
		chipsfunction: chips!function_definition

	using {

		rx_name: String = 'input_parameters';
		all_params: Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = chipsfunction.all_decl_params;
		
		core_atom_input_referenceable_elements: Sequence(
			TupleType(
				datatype:String, 
				aidd: bip!AtomInternalDataDeclaration, 
				ddrdp: bip!DataDeclarationReferenceDataParameter, 
				aipd: bip!AtomInternalPortDeclaration,
				aepd: bip!AtomExportPortDeclaration,
				iindex: Integer
			)
		) = all_params
		->AllParametersToNiceTuple('input')
		->sortedBy(t | t.datatype)
		->iterate(
			tuple ;
			accuTupleSequence:Sequence(
				TupleType(
					datatype:String, 
					aidd: bip!AtomInternalDataDeclaration, 
					ddrdp: bip!DataDeclarationReferenceDataParameter, 
					aipd: bip!AtomInternalPortDeclaration,
					aepd: bip!AtomExportPortDeclaration,
					iindex: Integer
				)
			) = Sequence{
				Tuple{
					datatype= '', 
					aidd= OclUndefined, 
					ddrdp= OclUndefined , 
					aipd= OclUndefined,
					aepd= OclUndefined,
					iindex= -1
				}
			} 
			| accuTupleSequence->append(
				Tuple{
					datatype= tuple.datatype, 
					aidd= tuple.aidd, 
					ddrdp= tuple.ddrdp, 
					aipd= tuple.aipd,
					aepd= tuple.aepd,
					iindex = accuTupleSequence->last().iindex+1
				}
			)
		)->select(t | t.iindex >=0);
		
		param_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
			all_params->collect(param | Tuple{name=param.name,component=thisModule.MakeBufferComponentDeclaration(param.type,param.name,chipsfunction.name)});

		input_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = core_atom_input_referenceable_elements->collect(t | Tuple{type=t.datatype, iindex=t.iindex});

		input_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = input_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,true));

		input_datadecls: Sequence(bip!ConnectorDataDeclaration) = input_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		epdecl: bip!ConnectorExportedPortDeclaration = thisModule.MakeConnectorExportedPortDeclaration(input_indexed_types, true, input_datadecls);

		input_connector_type : bip!ConnectorType = thisModule.MakeMany2OneConnectorType(input_indexed_types->collect(t | t.type));

		input_fwd_port_decl : bip!PortDeclaration = epdecl;

		input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) =
			input_indexed_types->asPortDeclRefParamSequence(param_one_type_buffer_list->collect(p | p.component),input_fwd_port_decl,true, chipsfunction.name);

		input_conndecl:bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				input_connector_type,
				input_pdeclsrefparam,
				'to_the_core'
			);
		
		input_connsubportdecl: bip!SubPortDeclarationReference = thisModule.MakeConnectorSubPortDeclarationReference(input_fwd_port_decl, input_conndecl);

		input_compoundexportportdecl: bip!CompoundExportPortDeclaration = thisModule.MakeCompoundSubConnExportPortDeclaration(input_connsubportdecl);

		input_compoundtype:bip!CompoundType = thisModule.MakeCompoundType(
			chipsfunction.name+'RX',
			Sequence{},
			param_one_type_buffer_list->collect(t | t.component),
			Sequence{input_conndecl},
			Sequence{input_compoundexportportdecl}
		);
		

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		tx_name: String = 'output_parameters';
		all_outputs: Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = chipsfunction.all_decl_params;
		
		core_atom_output_referenceable_elements: Sequence(
			TupleType(
				datatype:String, 
				aidd: bip!AtomInternalDataDeclaration, 
				ddrdp: bip!DataDeclarationReferenceDataParameter, 
				aipd: bip!AtomInternalPortDeclaration,
				aepd: bip!AtomExportPortDeclaration,
				iindex: Integer
			)
		) = all_outputs
		->AllParametersToNiceTuple('output')
		->sortedBy(t | t.datatype)
		->iterate(
			tuple ;
			accuTupleSequence:Sequence(
				TupleType(
					datatype:String, 
					aidd: bip!AtomInternalDataDeclaration, 
					ddrdp: bip!DataDeclarationReferenceDataParameter, 
					aipd: bip!AtomInternalPortDeclaration,
					aepd: bip!AtomExportPortDeclaration,
					iindex: Integer
				)
			) = Sequence{
				Tuple{
					datatype= '', 
					aidd= OclUndefined, 
					ddrdp= OclUndefined , 
					aipd= OclUndefined,
					aepd= OclUndefined,
					iindex= -1
				}
			} 
			| accuTupleSequence->append(
				Tuple{
					datatype= tuple.datatype, 
					aidd= tuple.aidd, 
					ddrdp= tuple.ddrdp, 
					aipd= tuple.aipd,
					aepd= tuple.aepd,
					iindex = accuTupleSequence->last().iindex+1
				}
			)
		)->select(t | t.iindex >=0);
		
		output_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
			all_outputs->collect(output | Tuple{name=output.name,component=thisModule.MakeBufferComponentDeclaration(output.type,output.name,chipsfunction.name)});

		output_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = core_atom_output_referenceable_elements->collect(t | Tuple{type=t.datatype, iindex=t.iindex});

		output_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = output_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,false));

		output_datadecls: Sequence(bip!ConnectorDataDeclaration) = output_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		output_epdecl: bip!ConnectorExportedPortDeclaration = thisModule.MakeConnectorExportedPortDeclaration(output_indexed_types, true, output_datadecls);

		output_connector_type : bip!ConnectorType = thisModule.MakeMany2OneConnectorType(output_indexed_types->collect(t | t.type));

		output_fwd_port_decl : bip!PortDeclaration = output_epdecl;

		output_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) =
			output_indexed_types->asPortDeclRefParamSequence(param_one_type_buffer_list->collect(p | p.component),output_fwd_port_decl,true, chipsfunction.name);

		output_conndecl:bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				output_connector_type,
				output_pdeclsrefparam,
				'from_the_core'
			);
		
		output_connsubportdecl: bip!SubPortDeclarationReference = thisModule.MakeConnectorSubPortDeclarationReference(output_fwd_port_decl, output_conndecl);

		output_compoundexportportdecl: bip!CompoundExportPortDeclaration = thisModule.MakeCompoundSubConnExportPortDeclaration(output_connsubportdecl);

		output_compoundtype:bip!CompoundType = thisModule.MakeCompoundType(
			chipsfunction.name+'TX',
			Sequence{},
			output_one_type_buffer_list->collect(t | t.component),
			Sequence{output_conndecl},
			Sequence{output_compoundexportportdecl}
		);


		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) = 
		-- all_params->collect(param | thisModule.MakeCompoundSubCompExportPortDeclaration(param, rx_name))
		-- ->union(all_outputs->collect(output | thisModule.MakeCompoundSubCompExportPortDeclaration(output, tx_name)));
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name,
		dataParameterDeclarations <- Sequence{start_parameter},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(output_parameters_decl)
			->append(input_parameters_decl)--,
		-- need to add the connectors
		--exportPortDeclarations <- exportedportdecl.debug()
	),

	core_component_declaration: bip!ComponentDeclaration(
		type <- chipsfunction,
		parameters <- Sequence{starts_valued_expression},
		name <- 'core'
	),

	input_parameters_decl : bip!ComponentDeclaration(
		name<-rx_name,
		parameters<- Sequence{},
		type<- input_compoundtype
	),

	output_parameters_decl : bip!ComponentDeclaration(
		name<-tx_name,
		parameters<- Sequence{},
		type<- output_compoundtype
	),

	starts_valued_expression: bip!DirectDataDeclarationReferenceExpression (
		dataDeclaration <- start_parameter
	),

	start_parameter:  bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBaseDataType('bool'),
		name <- 'starts',
		const <- true
	)
}

