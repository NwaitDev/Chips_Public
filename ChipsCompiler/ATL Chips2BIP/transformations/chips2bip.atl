unique lazy rule MakeOne2ManyConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		datadecls:Sequence(bip!ConnectorDataDeclaration) = 
			indexed_types->collect(t | thisModule.MakeOne2ManyConnectorDataDeclaration(t.type,t.iindex,ordered_types));

		cppd : Sequence(bip!ConnectorPortParameterDeclaration) = 
			indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(indexed_types, t.iindex,datadecls));

		downinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						cppd->get(n.value),
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n.value),
							n.value,
							ordered_types
						)
					),
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n.value)
					)
				)
			);
		
		exported:bip!ConnectorExportedPortDeclaration = 
			thisModule.MakeOne2ManyExportedPortDeclaration(indexed_types, datadecls);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'one2many_'| accu_name+iter )+'_t',
		exportedPortDeclaration <- exported,
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(cppd),
		ports <- cppd
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- cppd, --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
	do {
		thisModule.temp_dic <- thisModule.dictionary->get('One2ManyConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('datadecls', datadecls),
					('cppd', cppd),
					('epd', exported)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('One2ManyConnectorTypes', thisModule.temp_dic);
		
		one;
	}
}


unique lazy rule MakeFlowPortDeclarationReferenceParameter{
	from 
		ordered_types : Sequence(String),
		src:Boolean

	to cppd: bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(ordered_types),
		name<-if src then 's' else 'r' endif
	)
}

unique lazy rule MakeFlowConnectorType{
	from 
		ordered_types:Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		send_port : bip!ConnectorPortParameterDeclaration = 
			thisModule.MakeFlowPortDeclarationReferenceParameter(ordered_types, true);

		recv_port : bip!ConnectorPortParameterDeclaration =
			thisModule.MakeFlowPortDeclarationReferenceParameter(ordered_types, false);

		downports : Sequence(bip!ConnectorPortParameterDeclaration) = 
			Sequence{send_port, recv_port}; 

		downinteraction : Sequence(bip!Expression) =
			thisModule.range(Sequence{ordered_types->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						recv_port,
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n.value),
							n.value,
							ordered_types
						)
					),
					thisModule.MakeAssignmentSubDataOperand(
						send_port,
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n.value),
							n.value,
							ordered_types
						)
					)
				)
			);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'flow_'| accu_name+iter )+'_t',
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(downports),
		ports <- downports
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports, --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
	do {

		thisModule.temp_dic <- thisModule.dictionary->get('FlowConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('s_port', send_port),
					('r_port', recv_port)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('FlowConnectorTypes', thisModule.temp_dic);

		one;
	}
}

lazy rule MakeConnectorSubPortDeclarationReference{
	from 
		portdecl : bip!ConnectorExportedPortDeclaration,
		conndecl : bip!ConnectorDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, -- (AtomExportedPortDeclaration/ConnectorExportedPortDeclaration)
		--componentDeclaration <-  --(ComponentDeclaration)
		-- or 
		connectorDeclaration <- conndecl --(ConnectorDeclaration)
	)
}

lazy rule MakeComponentSubPortDeclarationReference{
	from 
		portdecl : bip!PortDeclaration,
		compdecl : bip!ComponentDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, -- (AtomExportedPortDeclaration?)/(ConnectorExportedPortDeclaration)
		componentDeclaration <- compdecl --(ComponentDeclaration)
		-- or 
		--connectorDeclaration <- --(ConnectorDeclaration)
	)
}

unique lazy rule MakePortDeclarationReferenceParameter{
	from 
		portdecl:bip!PortDeclaration, -- coming from the definition of the connector
		subpdrp:bip!SubPortDeclarationReference -- the actual port that gets connected via this declaration
		
	to pdrp:bip!PortDeclarationReferenceParameter(
		parameterDeclaration <- portdecl, 
		subPortDeclarationReference <- subpdrp 
	)
}

lazy rule MakeConnectorDeclaration{
	from 
		name:String,
		conntype : bip!ConnectorType,
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)
	to 
		conn:bip!ConnectorDeclaration(
			type <- conntype,
			portParameters <- portparameters,
			name <- name.protect()+'_cd'
		)
}


unique lazy rule MakeMany2OneConnectorDeclaration{
	from 
		chipsparameters : Sequence(TupleType(type:String,name:String)),
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)
	using{
		types:Sequence(String) = chipsparameters->collect(t | t.type);
	}
	to conn:bip!ConnectorDeclaration(
		type<- thisModule.MakeMany2OneConnectorType(types),
		portParameters <- portparameters,
		name <- types->iterate(s ; acc:String = '' | acc+s)+'_input_connector'
	)
}

unique lazy rule MakeOne2ManyConnectorDeclaration{
	from 
		chipsparameters : Sequence(TupleType(type:String,name:String)),
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)
	using{
		types:Sequence(String) = chipsparameters->collect(t | t.type);
	}
	to conn:bip!ConnectorDeclaration(
		type<- thisModule.MakeOne2ManyConnectorType(types),
		portParameters <- portparameters,
		name <- types->iterate(s ; acc:String = '' | acc+s)+'_output_connector'
	)
}


unique lazy rule MakeInputBufferType{
	from parameters : Sequence(TupleType(type:String,name:String))

	using{
		indexed_named_typed_monotype_buffers 
		: Sequence(TupleType(iindex:Integer, type:String,name:String,buf:bip!ComponentDeclaration)) = 
			parameters->augmentWithIindex()
			->collect(t | 
				Tuple{
					iindex = t.iindex,
					type=t.data.type,
					name=t.data.name,
					buf = thisModule.MakeMonoTypeBufferComponentDeclaration(t.data.type,t.data.name)
				}
			);

		connector_type : bip!ConnectorType =
			thisModule.MakeMany2OneConnectorType(parameters->collect(t | t.type));
		
		
		input_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			indexed_named_typed_monotype_buffers->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.dictionary
						->get('Many2OneConnectorTypes')
						->get(parameters->collect(t | t.type))
						->get('cppd')
						->get(t.iindex),
					thisModule.MakeComponentSubPortDeclarationReference(
						thisModule.dictionary
							->get('MonotypeBufferTypes')
							->get(t.type)
							->get('aepd_out'),
						t.buf
					)
				)
			);

		input_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeMany2OneConnectorDeclaration(
				parameters,
				input_connector_port_parameters
			);
		
		exported_one : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'one',
				indexed_named_typed_monotype_buffers->collect(t|t.type),
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.dictionary
							->get('Many2OneConnectorTypes')
							->get(parameters->collect(t | t.type))
							->get('epd'),
						input_connector_decl
					)
				}
			);
		exported_monotype_inputs : Sequence(bip!CompoundExportPortDeclaration) =
			indexed_named_typed_monotype_buffers->collect(t | 
				thisModule.MakeCompoundExportPortDeclaration(
					t.name.protect()+'_exin',
					Sequence{t.type},
					Sequence{
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('MonotypeBufferTypes')
								->get(t.type)
								->get('aepd_in'),
							t.buf
						)
					}
				)
			);
	}

	to ibt : bip!CompoundType(
		name <- parameters->iterate(s ; acc:String = ''| acc+s.type)+'_input_buffer_t',
        native <- false,
        exportedPortDeclarations <- exported_monotype_inputs->append(exported_one),
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- indexed_named_typed_monotype_buffers->collect(t|t.buf),
		connectorDeclarations <- Sequence{input_connector_decl},
		exportPortDeclarations <- exported_monotype_inputs->append(exported_one)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('InputBufferTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				parameters,
				Map{
					('einputs', exported_monotype_inputs),
					('eoutput', exported_one)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('InputBufferTypes', thisModule.temp_dic);

		ibt;
	}
}

unique lazy rule MakeOutputBufferType{
	from parameters : Sequence(TupleType(type:String,name:String))

	using{
		monotype_buffers : Sequence(bip!ComponentDeclaration) = 
			parameters->collect(t | thisModule.MakeMonoTypeBufferComponentDeclaration(t.type,t.name));

		connector_type : bip!ConnectorType =
			thisModule.MakeOne2ManyConnectorType(parameters->collect(t | t.type));
		
		all_outputs : Sequence(TupleType(type:String,iindex:Integer,name:String)) =
			parameters->augmentWithIindex()
			->collect(t | Tuple{type=t.data.type,iindex=t.iindex,name=t.data.name});

		output_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			all_outputs->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.dictionary
						->get('One2ManyConnectorTypes')
						->get(parameters->collect(t | t.type))
						->get('cppd')
						->get(t.iindex),
					thisModule.MakeComponentSubPortDeclarationReference(
						thisModule.dictionary
							->get('MonotypeBufferTypes')
							->get(t.type)
							->get('aepd_in'),
						monotype_buffers->get(t.iindex)
					)
				)
			);

		output_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeMany2OneConnectorDeclaration(
				parameters,
				output_connector_port_parameters
			);
		
		exported_one : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'one',
				all_outputs->collect(t|t.type),
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.dictionary
							->get('One2ManyConnectorTypes')
							->get(parameters->collect(t | t.type))
							->get('epd'),
						output_connector_decl
					)
				}
			);
		exported_monotype_outputs : Sequence(bip!CompoundExportPortDeclaration) =
			all_outputs->collect(t | 
				thisModule.MakeCompoundExportPortDeclaration(
					t.name.protect()+'_exout',
					Sequence{t.type},
					Sequence{
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('MonotypeBufferTypes')
								->get(t.type)
								->get('aepd_out'),
							monotype_buffers->get(t.iindex)
						)
					}
				)
			);
	}

	to obt : bip!CompoundType(
		name <- parameters->iterate(s ; acc:String = ''| acc+s.type)+'_output_buffer_t',
        native <- false,
        exportedPortDeclarations <- exported_monotype_outputs->append(exported_one), -- export the outer port of the connector
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- monotype_buffers,
		connectorDeclarations <- Sequence{output_connector_decl},
		exportPortDeclarations <- exported_monotype_outputs->append(exported_one)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('OutputBufferTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				parameters,
				Map{
					('eoutputs', exported_monotype_outputs),
					('einput', exported_one)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('OutputBufferTypes', thisModule.temp_dic);

		obt;
	}
}


unique lazy rule MakeFunctionalBlockCompoundType {
	from 
		chipsfunction: chips!function_definition

	using {
		all_inputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_inputs;
		all_outputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_outputs;

		all_indexed_input_types : Sequence(TupleType(iindex:Integer,type:String)) =
			all_inputs->augmentWithIindex()->collect(t | Tuple{type=t.data.type, iindex=t.iindex});
		all_indexed_output_types : Sequence(TupleType(iindex:Integer,type:String)) =
			all_outputs->augmentWithIindex()->collect(t | Tuple{type=t.data.type, iindex=t.iindex});

		all_input_ordered_types : Sequence(String) = all_inputs->collect(t|t.type);
		all_output_ordered_types : Sequence(String) = all_outputs->collect(t|t.type);

		only_parameter : bip!ComponentDataParameterDeclaration = 
			thisModule.MakeComponentDataParameterDeclaration('starts','bool',chipsfunction);

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = 
			thisModule.MakeCoreComponentDeclaration(chipsfunction);
			
		input_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_input_buffer',
				thisModule.MakeInputBufferType(all_inputs)
			);

		output_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_output_buffer',
				thisModule.MakeOutputBufferType(all_outputs)
			);

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		connector_input_buffer_to_core: bip!ConnectorDeclaration =
			thisModule.MakeConnectorDeclaration(
				'input_to_core',
				thisModule.MakeFlowConnectorType(all_inputs->collect(t|t.type)),
				Sequence{
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('s_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('InputBufferTypes')
								->get(all_inputs)
								->get('eoutput'),
							input_buffer_declaration
						)
					),
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('r_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('CoreAtomTypes')
								->get(chipsfunction)
								->get('aepd')
								->get('input'),
							core_component_declaration
						)
					)
				}
			);

		connector_core_to_output_buffer: bip!ConnectorDeclaration =
			thisModule.MakeConnectorDeclaration(
				'core_to_output',
				thisModule.MakeFlowConnectorType(all_outputs->collect(t|t.type)),
				Sequence{
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_output_ordered_types)
							->get('s_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('CoreAtomTypes')
								->get(chipsfunction)
								->get('aepd')
								->get('output'),
							core_component_declaration
						)
					),
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('r_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('OutputBufferTypes')
								->get(all_outputs)
								->get('einput'),
							output_buffer_declaration
						)
					)
				}
			);
		
		exported_inputs : Sequence(bip!CompoundExportPortDeclaration) = 
			Sequence{

			};

		exported_outputs : Sequence(bip!CompoundExportPortDeclaration) = 
			Sequence{

			};

		-- still need to handle contextuals
		exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) =
			exported_inputs->union(exported_outputs);
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name.protect()+'_compoundtype',
		dataParameterDeclarations <- Sequence{only_parameter},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(input_buffer_declaration)
			->append(output_buffer_declaration),
		connectorDeclarations<- Sequence{
			connector_input_buffer_to_core,
			connector_core_to_output_buffer
		},
		exportPortDeclarations <- exportedportdecl
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('FunctionalBlockCompoundTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				chipsfunction,
				Map{
					('einputs', exported_inputs),
					('eoutputs', exported_outputs)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('FunctionalBlockCompoundTypes', thisModule.temp_dic);

		compound_type;
	}
}

lazy rule MakeBufferCompoundDeclaration{
	from 
		name:String,
		type:bip!CompoundType

	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name+'_buffercompounddecl',
		parameters<- Sequence{},
		type <- type
	)
}

lazy rule MakeCoreComponentDeclaration {
	from 
		chipsfunction: chips!function_definition

	to core_component_declaration: bip!ComponentDeclaration(
		type <- thisModule.MakeCoreAtomType(chipsfunction),
		parameters <- Sequence{starts_valued_expression},
		name <- 'core'
	),
	
	starts_valued_expression: bip!DirectDataDeclarationReferenceExpression (
		dataDeclaration <- thisModule.MakeComponentDataParameterDeclaration('starts','bool',chipsfunction)
	)
}


unique lazy rule MakeComponentDataParameterDeclaration{
	from name:String, type:String, fd:chips!function_definition

	to cdpd: bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeChipsDataType(type),
		name <- name+'_componentdataparameterdeclaration',
		const <- true
	)
}


lazy rule MakeCompoundDeclaration{
	from 
		name:String,
		chipsfunction:chips!function_definition,
		parameters:Sequence(OclAny)
		
	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name+'_compounddecl',
		parameters<- parameters,
		type <- thisModule.MakeFunctionalBlockCompoundType(chipsfunction)
	)
}

lazy rule MakeDirectBooleanExpression{
	from exp : Boolean

	to dbe:bip!DirectBooleanExpression(
		value <- exp
	)
}


helper context TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer)) def :
intoCompoundDeclarations(starts : Boolean ) : Sequence(bip!componentDeclaration) =
let linearized_total: Integer = 
	if self.dimensions->isEmpty() then
		1
	else 
		self.dimensions->iterate( i ; acc:Integer = 1| acc*(i+1))-1
	endif 
in	thisModule.range(Sequence{linearized_total})
	->collect(i | thisModule.MakeCompoundDeclaration(
		self.key+i.value.toString(),
		self.type,
		Sequence{thisModule.MakeDirectBooleanExpression(starts)}
	));


unique lazy rule MakeSystemCompoundType{
	from 
		all_compounds: Bag(bip!ComponentDeclaration),
		all_connectors: Bag(bip!connectorDeclaration)

	to compound : bip!CompoundType(
		name <- 'SYSTEM_COMPOUND',
        native <- false,
        superTypes <- Sequence{},
        castableTypes <- Sequence{},
        exportedPortDeclarations <- Sequence{},
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- all_compounds,
		connectorDeclarations <- all_connectors,
		exportPortDeclarations <- Sequence{},
		exportDataDeclarations <- Sequence{},
		priorities <- Sequence{}
	)
}

unique lazy rule MakeConstantAtomType{
	from
		type:String

	using {
		dataname : String = type+'_value';
	}

	to 
		cst:bip!AtomType(
			name <- type + '_constant_t',
	        native <- false,
	        superTypes <- Sequence{},
	        castableTypes <- Sequence{},
	        exportedPortDeclarations <- Sequence{aepd},
	        exportedDataDeclarations <- Sequence{}, 
	        dataParameterDeclarations <- Sequence{},
	        internalPortDeclarations <- Sequence{port},
	        behavior <- thisModule.MakeConstantPetriNet(port),
	        internalDataDeclarations <- Sequence{datadecl},
	        exportPortDeclarations <- Sequence{aepd}
		),

	aepd: bip!AtomExportPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <-'output'+'_aepd',
		portDeclarationReferences <- Sequence{port}
	),

	port : bip!AtomInternalPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <- 'output'+'_aipd',
		dataParameters <- Sequence{thisModule.MakeAtomDataDeclarationReferenceDataParameter(0,type, datadecl)}
	),

	datadecl:bip!AtomInternalDataDeclaration(
		dataType <- thisModule.MakeChipsDataType(type),
		name <-dataname+'_aidd'
	)

	do{

		thisModule.temp_dic <- thisModule.dictionary->get('ConstantAtomTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				type,
				Map{
					('aidd',datadecl),
					('aipd',port),
					('aepd',aepd)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('ConstantAtomTypes', thisModule.temp_dic);

		cst;
	}
}

helper context OclAny def : makeUniqueConstantName() : String = 
	'cst_'+self.toString()+'__'+thisModule.id.toString()+'__';

unique lazy rule MakeIntegerConstantDeclaration{
	from 
		int : Integer

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('int'),
		parameters <- Sequence{valued_expression}
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)
	do {
		cst_component_decl.name <- int.makeUniqueConstantName();
		thisModule.id <- thisModule.id+1;
		cst_component_decl;
	}

}

unique lazy rule MakeFloatConstantDeclaration{
	from 
		float : Real

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('float'),
		parameters <- Sequence{valued_expression}
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)
	do {
		cst_component_decl.name <- float.makeUniqueConstantName();
		thisModule.id <- thisModule.id+1;
		cst_component_decl;
	}
}

unique lazy rule MakeBoolConstantDeclaration{
	from 
		bool : Boolean

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('bool'),
		parameters <- Sequence{valued_expression}
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)
	do {
		cst_component_decl.name <- bool.makeUniqueConstantName();
		thisModule.id <- thisModule.id+1;
		cst_component_decl;
	}
}

rule Program2BipPackage {
	from chipsprogram: chips!program
	
	using {

		data_types: Sequence(bip!DataType) = 
			Sequence{'int','float','bool'}->collect(t | thisModule.MakeChipsDataType(t))
			->union(Sequence{thisModule.MakeBackendDataType('bool')}); -- only needed to decide which fsm starts


		base_port_types: Sequence(bip!PortType) = 
			Sequence{Sequence{'int'},Sequence{'float'},Sequence{'bool'},Sequence{}}
				->collect( t | thisModule.MakePortType(t));



		all_chips_function_defs : Sequence(chips!function_definition) = 
			chipsprogram.preamble.definitions->select(d | d.oclIsKindOf(chips!function_definition));
		

		system_specific_input_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_inputs->collect(t | t.type)
				)
			);
		
		system_specific_output_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_outputs->collect(t | t.type)
				)
			);

		core_atom_types: Sequence(bip!AtomType) = all_chips_function_defs->collect(d |  thisModule.MakeCoreAtomType(d));

		all_monotype_buffer_atom_types : Sequence(bip!AtomType) =
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeMonotypeBufferType(t));
		
		constants_atom_types: Sequence(bip!AtomType) = 
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeConstantAtomType(t));


		functional_blocks_types: Sequence(bip!CompoundType) = 
			all_chips_function_defs
			->collect(d | thisModule.MakeFunctionalBlockCompoundType(d));
		
		functional_input_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeInputBufferType(d.all_inputs));
		
		functional_output_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeOutputBufferType(d.all_outputs));


		all_exporting_connector_types: Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeMany2OneConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeOne2ManyConnectorType(d.all_outputs->collect(o | o.type))
				)
			);
		all_flow_connector_types:Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeFlowConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeFlowConnectorType(d.all_outputs->collect(o | o.type))
				)
			);
		

		memory: Set(TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer))) = 
			chipsprogram.system.system_statements->iterate( 
				stt ; mem : Set(TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer))) = Set{}
				| stt.evaluate(mem)
			);--.debug('\n----------------------memory state------------------------\n');
		


		--- Currently here for the overall compilation

		all_int_constants :  Bag(bip!ComponentDeclaration) =
		memory->select(elem | elem.type = 'logical_int_connector')
			->select(elem | elem.value->get(0).oclIsKindOf(Integer))
			->collect(elem | elem.value->get(0))
			->asSequence()
			->augmentWithIindex()
			->collect(t | thisModule.MakeIntegerConstantDeclaration(t.data))
			->asBag();
		
		all_float_constants :  Bag(bip!ComponentDeclaration) =
		memory->select(elem | elem.type = 'logical_float_connector')
			->select(elem | elem.value->get(0).oclIsKindOf(Real))
			->collect(elem | elem.value->get(0))
			->asSequence()
			->augmentWithIindex()
			->collect(t | thisModule.MakeFloatConstantDeclaration(t.data))
			->asBag();
		
		all_bool_constants :  Bag(bip!ComponentDeclaration) =
		memory->select(elem | elem.type = 'logical_bool_connector')
			->select(elem | elem.value->get(0).oclIsKindOf(Boolean))
			->collect(elem | elem.value->get(0))
			->asSequence()
			->augmentWithIindex()
			->collect(t | thisModule.MakeBoolConstantDeclaration(t.data))
			->asBag();
		
		all_compounds_decl: Bag(bip!ComponentDeclaration) = 
			memory
			->select( elem | elem.type.oclIsKindOf(chips!function_definition))
			->collect(elem | elem.intoCompoundDeclarations(true))
			->flatten();

		all_components_decl: Bag(bip!ComponentDeclaration) = 
			all_compounds_decl
			->union(all_bool_constants)
			->union(all_float_constants)
			->union(all_int_constants);
		
		int_dataflows : Bag(bip!ConnectorDeclaration) =  
			memory->select(elem | elem.type = 'logical_int_connector')
			->collect(elem | thisModule.MakeConnectorDeclaration(
				elem.key,
				thisModule.MakeFlowConnectorType(Sequence{'int'}),
				Sequence{}-- Sequence(bip!PortDeclarationReferenceParameter)
			))
			->union(
				memory->select(elem | elem.type = 'physical_int_connector')
				->collect(elem | thisModule.MakeConnectorDeclaration(
					elem.key,
					thisModule.MakeFlowConnectorType(Sequence{'int'}),
					Sequence{}-- Sequence(bip!PortDeclarationReferenceParameter)
				))	
			);

		all_dataflows : Bag(bip!ConnectorDeclaration) = int_dataflows;
		system_compoud: bip!CompoundType = thisModule.MakeSystemCompoundType(
			all_components_decl, all_dataflows
		);
		
	}
	to 
		bippackage: bip!BipPackage(
			name <- chipsprogram.fileName.split('\\.')->get(0),
			atomTypes <- core_atom_types
				->union(all_monotype_buffer_atom_types)
				->union(constants_atom_types),
			compoundTypes <- functional_blocks_types
				->union(functional_input_buffer_types)
				->union(functional_output_buffer_types)
			 	->union(Sequence{system_compoud}),
			connectorTypes <- all_exporting_connector_types
				->union(all_flow_connector_types),
			portTypes <- base_port_types
				->union(system_specific_input_port_types)
				->union(system_specific_output_port_types),
			dataTypes <- data_types
			-- used_packages <- Sequence{},
			-- constData <- Sequence{}, -- what for ? oh wait, yes
			-- prototypes <- Sequence{} -- for importing functions from cpp backend
		)
}

-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------
----------------MEMORY EVALUATION FOR INTERPRETATION OF CHIPS MODELS---------------------
-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------


-- Declaration of components in system context
----------------------------------------------

helper context chips!"chips::statements::system::physical_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

helper context chips!"chips::statements::system::logical_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

helper context chips!"chips::statements::system::object_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

-- Declarations of primitive variables in system context
--------------------------------------------------------

helper context chips!"chips::statements::system::int_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = 0,
			type='int',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);

helper context chips!"chips::statements::system::float_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = 0.0,
			type='float',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);

helper context chips!"chips::statements::system::bool_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = false,
			type='bool',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);


-- assignment of primitive variables in system context
--------------------------------------------------------

helper context chips!"chips::statements::system::int_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

helper context chips!"chips::statements::system::float_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

helper context chips!"chips::statements::system::bool_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

-- linking instructions evaluation in system context
----------------------------------------------------

helper context chips!link def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory; -- currently doing nothing because not a priority to make models runnable

-- channel plugging evaluation in system context
------------------------------------------------

helper context chips!channel_plugging def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder,self.eater}, 
		type='channel_plug', 
		dimensions=Sequence{}
	});

-- Flow control structures interpretation in system section
-------------------------------------------

helper context chips!"chips::statements::system::foreach" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let iterable : Sequence(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = self.iterable_expr.evaluate(memory) in
	iterable->iterate(
		iterator ; 
		m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
		self.statements->iterate( 
			stt ; 
			m2: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) 
				= m1->including(Tuple{key=self.iterator.variable.name, value=iterator.value, type=iterator.type, dimensions=iterator.dimensions}) | 
			stt.evaluate(m2)
		)->reject(e | (e.key = self.iterator.variable.name) and (e.type = iterator.type))
	);


helper context chips!"chips::statements::system::if" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let condition : Boolean = self.condition.evaluate(memory) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	else
		memory
	endif;

helper context chips!"chips::statements::system::if_else" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let condition : Boolean = self.condition.evaluate(memory) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	else
		self.else_section.else_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	endif;

