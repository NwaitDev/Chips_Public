		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='bool_connector', 
		dimensions=Sequence{}
	});

helper context chips!physical_collective_cast def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny, children:Sequence(OclAny)) =
	Tuple{
		type='collective',
		value=self.collective_function,
		children=self.physical_feeder_expression.evaluate(memory)
	};

helper context chips!int_physical_output def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny) =
	Tuple{
		type='output',
		value=Tuple{var = self.variable_expression, output = self.output}
	};

helper context chips!physical_int_eater def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny) =
	Tuple{
		type='input',
		value=Tuple{var = self.variable, input = self.parameter}
	};


helper context chips!"chips::statements::system::feeding_logical_int" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->evaluate(memory)->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='int_connector', 
		dimensions=Sequence{}
	});

helper context chips!"chips::statements::system::feeding_logical_float" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->evaluate(memory)->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='float_connector', 
		dimensions=Sequence{}
	});

helper context chips!"chips::statements::system::feeding_logical_bool" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->evaluate(memory)->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='bool_connector', 
		dimensions=Sequence{}
	});

helper context chips!logical_collective_cast def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny, children:Sequence(OclAny)) =
	Tuple{
		type='collective',
		value=self.collective_function,
