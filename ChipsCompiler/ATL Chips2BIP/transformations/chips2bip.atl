unique lazy rule FunctionDefinition2CompoundType {
	from 
		chipsfunction: chips!function_definition

	using {

		input_compound_type : bip!CompoundType = OclUndefined;--chipsfunction.extractInputBufferCompoundType();
		output_compound_type : bip!CompoundType = OclUndefined; --chipsfunction.extractOutputBufferCompoundType();

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = OclUndefined; -- thisModule.MakeCoreComponent(chipsfunction);
		input_buffer_declaration : bip!ComponentDeclaration = OclUndefined; --thisModule.MakeBufferCompoundDeclaration('input_parameters',input_compound_type,chipsfunction);
		output_buffer_declaration : bip!ComponentDeclaration = OclUndefined; --thisModule.MakeBufferCompoundDeclaration('output_parameters',output_compound_type,chipsfunction);


		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- need to extract :
		input_connexportportdecl : bip!CompoundExportPortDeclaration = OclUndefined; --chipsfunction.extractInputConnExportPortDecl();
		input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) = OclUndefined; --chipsfunction.extractInputPDeclsRefParams();


		from_the_outside : bip!SubPortDeclarationReference = OclUndefined; --thisModule.MakeAtomSubPortDeclarationReference(input_connexportportdecl,input_buffer_declaration);
		--to_the_core : bip!SubPortDeclarationReference = thisModule.MakeAtomSubPortDeclarationReference(,);

		flow_input_to_core: bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			thisModule.MakeFlowConnectorType(chipsfunction.all_inputs->collect(t | t.type)),
			input_pdeclsrefparam,--->union(Sequence{from_the_outside,to_the_core}),
			'RX_to_core'
		);


		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) = ;
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name,
		dataParameterDeclarations <- Sequence{thisModule.MakeStartParameter(thisModule.makeCoreScope(chipsfunction))},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(input_buffer)
			->append(output_buffer),
		connectorDeclarations<- Sequence{flow_input_to_core}--,
		--exportPortDeclarations <- exportedportdecl
	)
}

