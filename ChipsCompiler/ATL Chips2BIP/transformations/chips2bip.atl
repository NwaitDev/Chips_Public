	self.variable_expression.index->getName(memory)
	+'_'+self.parameter.name;


helper context chips!bool_logical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

helper context chips!logical_bool_eater def: getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.parameter.name;

helper context chips!"chips::rvalues::system::direct_int" def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.value.toString();

helper context Integer def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.toString();

helper context Real def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.toString();

helper context chips!physical def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.name;

helper context chips!channel_feeder def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.node.variable->getName(memory)
	+self.node.index->getName(memory)
	+self.feeding_channel->getName(memory);

helper context chips!channel_eater def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.node.variable->getName(memory)
	+self.node.index->getName(memory)
	+self.eating_channel->getName(memory);

helper context Sequence(OclAny) def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self->toString(memory);

helper context chips!channel_declaration def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.name;

helper context TupleType(type:String, value:OclAny) def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	if (self.type = 'output') then 
		self.value.output->getName(memory)
	else
		'unsupported yet'
	endif;

helper context chips!"chips::outputs::logical::int_output" def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.name;

helper context chips!"chips::outputs::logical::float_output" def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.name;

helper context chips!"chips::outputs::logical::bool_output" def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.name;

-- evaluation of an expression in system context
--------------------------------------------------------
helper context chips!"chips::rvalues::system::direct_int" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Integer =
	self.value;

helper context chips!"chips::rvalues::system::direct_float" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Real =
	self.value;

helper context chips!"chips::rvalues::system::direct_bool" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Boolean =
	self.value;

helper context chips!"chips::xvalues::system::int_variable_expression" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Integer =
	memory->any(e | (e.key = self.variable.name) and (e.type = 'int')).value;

helper context chips!"chips::xvalues::system::float_variable_expression" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Real =
	memory->any(e | (e.key = self.variable.name) and (e.type = 'float')).value;

helper context chips!"chips::xvalues::system::bool_variable_expression" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Boolean =
	memory->any(e | (e.key = self.variable.name) and (e.type = 'bool')).value;


helper context chips!"chips::rvalues::system::operators::float::plus" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Real =
	self.left_operand->evaluate(memory) + self.right_operand->evaluate(memory);

helper context chips!"chips::rvalues::system::operators::int::plus" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Integer =
	self.left_operand->evaluate(memory) + self.right_operand->evaluate(memory);


helper context chips!"chips::rvalues::system::operators::float::minus" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Real =
	self.left_operand->evaluate(memory) - self.right_operand->evaluate(memory);

helper context chips!"chips::rvalues::system::operators::int::minus" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Integer =
	self.left_operand->evaluate(memory) - self.right_operand->evaluate(memory);


helper context chips!"chips::rvalues::system::operators::bool::lt_int" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Boolean =
	self.left_operand->evaluate(memory) < self.right_operand->evaluate(memory);

helper context chips!"chips::rvalues::system::operators::bool::lt_float" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Boolean =
	self.left_operand->evaluate(memory) < self.right_operand->evaluate(memory);

helper context chips!"chips::rvalues::system::function" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : OclAny =
	if (self.name = 'zeros') then
		thisModule.zeros(self.parameters->collect(e | e.evaluate(memory)))
	else 
		if(self.name = 'ones') then
			thisModule.ones(self.parameters->collect(e | e.evaluate(memory)))
		else 
			if(self.name = 'range') then
				thisModule.range(self.parameters->collect(e | e.evaluate(memory)))
			else 
				Sequence{}
			endif
		endif
	endif;

