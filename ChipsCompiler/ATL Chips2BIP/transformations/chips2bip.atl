	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.parameter.name;


helper context chips!float_logical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

helper context chips!logical_float_eater def: getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.parameter.name;


