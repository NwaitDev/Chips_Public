-- @atlcompiler emftvm
-- @path chips=/Chips2bip/Chips1.1.ecore
-- @path bip=/Chips2Bip/bip.ecore
module chips2bip;

create OUT: bip from IN: chips;

helper def: primitiveTypes : Sequence(String) = Sequence{'int','float','bool'};

helper def: nbPrimitiveTypes : Integer = thisModule.primitiveTypes.size();

helper context Integer def : toString: String = self.toString();

helper context Integer def : toString(memory : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self.toString;

helper context chips!"chips::xvalues::system::int_variable_expression" def : toString(memory : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	self->evaluate(memory).toString;

helper context Sequence(OclAny) def : toString(memory : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String =
	if (self->size()<=0) then
		''
	else
		self->subSequence(1,self->size()-1)->toString(memory)+'_'+self->last()->evaluate(memory)->toString(memory)
	endif;

helper context String  def : typeToInt : Integer =
	thisModule.primitiveTypes->indexOf(self);

helper def: zeros(dims : Sequence(Integer)) : Sequence(OclAny) = 
	if (dims->size() > 1 ) then
		if (dims->last()=0 ) then 
			Sequence{}
		else
			Sequence{thisModule.zeros(dims->subSequence(0,dims->size()-1))}->union(thisModule.zeros(dims->subSequence(0,dims->size()-1).append(dims->last()-1)))
		endif
	else
		if (dims->isEmpty() or dims->last()=0 ) then 
			Sequence{}
		else
			Sequence{Tuple{key = 'zero', value = 0, type = 'int', dimensions = Sequence{}}}->union(thisModule.zeros(Sequence{dims->last()-1}))
		endif
	endif;

helper def: ones(dims : Sequence(Integer)) : Sequence(OclAny) = 
	if (dims->size() > 1 ) then
		if (dims->last()=0 ) then 
			Sequence{}
		else
			Sequence{thisModule.ones(dims->subSequence(0,dims->size()-1))}->union(thisModule.ones(dims->subSequence(0,dims->size()-1).append(dims->last()-1)))
		endif
	else
		if (dims->isEmpty() or dims->last()=0 ) then 
			Sequence{}
		else
			Sequence{Tuple{key = 'one', value = 1, type = 'int', dimensions = Sequence{}}}->union(thisModule.ones(Sequence{dims->last()-1}))
		endif
	endif;

helper def: range(dims : Sequence(Integer)) : Sequence(OclAny) = 
	if (dims->size() > 1 ) then
		if (dims->last()=0 ) then 
			Sequence{}
		else
			Sequence{Tuple{key = 'range', value = thisModule.range(dims->subSequence(0,dims->size()-1)), type = 'int', dimensions = dims->subSequence(0,dims->size()-1)}}->union(thisModule.range(dims->subSequence(0,dims->size()-1).append(dims->last()-1)))
		endif
	else
		if (dims->isEmpty() or dims->last()=0 ) then 
			Sequence{}
		else
			thisModule.range(Sequence{dims->last()-1})->union(Sequence{Tuple{key = 'range', value = dims->last()-1, type = 'int', dimensions = Sequence{}}})
		endif
	endif;

helper context chips!logical_parameter  def : typeToInt : Integer =
	Sequence{
		chips!int_logical_parameter,
		chips!float_logical_parameter,
		chips!bool_logical_parameter
	}->indexOf(self.oclType());

helper context chips!logical_output  def : typeToInt : Integer =
	Sequence{
		chips!"chips::outputs::logical::int_output",
		chips!"chips::outputs::logical::float_output",
		chips!"chips::outputs::logical::bool_output"
	}->indexOf(self.oclType());
	
helper context chips!physical_parameter  def : typeToInt : Integer =
	Sequence{
		chips!int_physical_parameter,
		chips!float_physical_parameter,
		chips!bool_physical_parameter
	}->indexOf(self.oclType());

helper context chips!physical_output  def : typeToInt : Integer =
	Sequence{
		chips!"chips::outputs::physical::int_output",
		chips!"chips::outputs::physical::float_output",
		chips!"chips::outputs::physical::bool_output"
	}->indexOf(self.oclType());


helper context chips!function_definition def : all_decl_params : Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = 
	self.parameters->union(
		if self.oclIsTypeOf(chips!physical_definition) then
			self.sensor
		else
			Sequence{}
		endif
	)->collect(param | param.toTuple)->sortedBy(t | t.type);

helper context chips!function_definition def : all_decl_outputs : Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = 
	self.outputs->union(
		if self.oclIsTypeOf(chips!physical_definition) then
			self.actuator
		else
			Sequence{}
		endif 
	)->sortedBy(o | o.extractTypeAsString)->collect(output | output.toTuple);

helper context String def : toIntType : Integer =
    if thisModule.primitiveTypes->exists(t | (t = self) ) then
        thisModule.primitiveTypes->indexOf(self)
    else
        0
    endif;
	
	
helper context Integer def : toStringType : String =
    if self >= 1 and self <= thisModule.nbPrimitiveTypes then
        thisModule.primitiveTypes->at(self)
    else
        'unknown_type'
    endif;

helper context chips!logical_parameter  def : extractTypeAsString : String =
	if self.oclIsTypeOf(chips!int_logical_parameter)
	then thisModule.primitiveTypes->at(1)
	else if self.oclIsTypeOf(chips!float_logical_parameter)
		then thisModule.primitiveTypes->at(2)
		else if self.oclIsTypeOf(chips!bool_logical_parameter)
			then thisModule.primitiveTypes->at(3)
			else 'unknown_type'
			endif
		endif
	endif;

helper context chips!logical_output  def : extractTypeAsString : String =
	if self.oclIsTypeOf(chips!"chips::outputs::logical::int_output")
	then thisModule.primitiveTypes->at(1)
	else if self.oclIsTypeOf(chips!"chips::outputs::logical::float_output")
		then thisModule.primitiveTypes->at(2)
		else if self.oclIsTypeOf(chips!"chips::outputs::logical::bool_output")
			then thisModule.primitiveTypes->at(3)
			else 'unknown_type'
			endif
		endif
	endif;

helper context chips!physical_parameter  def : extractTypeAsString : String =
	if self.oclIsTypeOf(chips!int_physical_parameter)
	then thisModule.primitiveTypes->at(1)
	else if self.oclIsTypeOf(chips!float_physical_parameter)
		then thisModule.primitiveTypes->at(2)
		else if self.oclIsTypeOf(chips!bool_physical_parameter)
			then thisModule.primitiveTypes->at(3)
			else 'unknown_type'
			endif
		endif
	endif;

helper context chips!physical_output  def : extractTypeAsString : String =
	if self.oclIsTypeOf(chips!"chips::outputs::physical::int_output")
	then thisModule.primitiveTypes->at(1)
	else if self.oclIsTypeOf(chips!"chips::outputs::physical::float_output")
		then thisModule.primitiveTypes->at(2)
		else if self.oclIsTypeOf(chips!"chips::outputs::physical::bool_output")
			then thisModule.primitiveTypes->at(3)
			else 'unknown_type'
			endif
		endif
	endif;

helper context chips!primitive_declaration  def : extractTypeAsString : String =
	if self.oclIsTypeOf(chips!"chips::statements::primitive::int_declaration")
	then thisModule.primitiveTypes->at(1)
	else if self.oclIsTypeOf(chips!"chips::statements::primitive::float_declaration")
		then thisModule.primitiveTypes->at(2)
		else if self.oclIsTypeOf(chips!"chips::statements::primitive::bool_declaration")
			then thisModule.primitiveTypes->at(3)
			else 'unknown_type'
			endif
		endif
	endif;

helper context chips!primitive_rvalue def : uses_contextuals() : Set(TupleType(type:String, name:String, suffix:String, exported:Boolean)) =
	if self.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_bool_expression") then
		Set{Tuple{ type='bool', name=self.variable.name, suffix='_ctx', exported=true}}
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::leq_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::geq_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::lt_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::gt_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::neq_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::eq_int") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::leq_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::geq_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::lt_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::gt_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::neq_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::eq_float") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::not") then
		self.operand->uses_contextuals()
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::or") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::and") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::neq_bool") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::bool::eq_bool") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_int_expression") then
		Set{Tuple{ type='int', name=self.variable.name, suffix='_ctx', exported=true}}
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::minus") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::plus") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::mult") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::div") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::mod") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::int::cast_as_int") then
		self.numeric->uses_contextuals()
	else if self.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_float_expression") then
		Set{Tuple{ type='float', name=self.variable.name, suffix='_ctx', exported=true}}
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::float::minus") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::float::plus") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::float::mult") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::float::div") then
		self.left_operand->uses_contextuals()->union(self.right_operand->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::rvalues::primitive::operators::float::cast_as_float") then
		self.numeric->uses_contextuals()
	else 
		Set{}
	endif endif endif endif endif endif	endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif;


helper context chips!primitive_statement def : uses_contextuals() : Set(TupleType(type:String, name:String, suffix:String, exported:Boolean)) =
	if self.oclIsTypeOf(chips!"chips::statements::primitive::int_assignment")
	or self.oclIsTypeOf(chips!"chips::statements::primitive::float_assignment")
	or self.oclIsTypeOf(chips!"chips::statements::primitive::bool_assignment") then
		Set{self.lvalue->uses_contextuals()}
		->union(self.rvalue->uses_contextuals())
	else if self.oclIsTypeOf(chips!"chips::statements::primitive::if_else") then
		self.condition->uses_contextuals()
		->union(self.if_section.if_statements->uses_contextuals()->asSet())
		->union(self.else_section.else_statements->uses_contextuals()->asSet())
	else if self.oclIsTypeOf(chips!"chips::statements::primitive::if") then
		self.condition->uses_contextuals()
		->union(self.if_section.if_statements->uses_contextuals()->asSet())
	else if self.oclIsTypeOf(chips!"chips::statements::primitive::foreach") then
		self.iterable_expr->uses_contextuals()
		->union(self.statements->uses_contextuals()->asSet())
	else 
		Set{}
	endif endif endif endif;

helper context Sequence(chips!primitive_statement) def : uses_contextuals() : Sequence(TupleType(type:String, name:String, suffix:String, exported:Boolean)) =
	self->collect(stt | stt->uses_contextuals()->asSequence())->asSequence();


helper def: allDataTypeNames : Set(String) =
    chips!function_definition.allInstances()
        ->collect(f | f.parameters->collect(p | p.extractTypeAsString))
		->union(
			chips!function_definition.allInstances()
			->collect(f | f.outputs->collect(o | o.extractTypeAsString))
		)
		->flatten()
        ->asSet();

helper def: allUsedPortTypes : Map(String, bip!PortType) =
	chips!function_definition.allInstances()
        ->collect(fd | fd.parameters->union(
			if fd.oclIsTypeOf(chips!physical_definition) then
				fd.sensor
			else
				Sequence{}
			endif
		))
		->collect(paramlist | paramlist->collect(param | param.typeToInt))
		->union(
			chips!function_definition.allInstances()
			->collect(fd | fd.outputs->union(
				if fd.oclIsTypeOf(chips!physical_definition) then
					fd.actuator
				else
					Sequence{}
				endif
			))
			->collect(outputlist | outputlist->collect(o | o.typeToInt))
		)
		->union(
			Sequence{
				chips!function_definition.allInstances()
				->collect(fd | fd."then".statements->uses_contextuals())
				->flatten()
				->collect(tuple | tuple.type.toIntType)
			}
		)
		->collect(list_of_type_as_int | list_of_type_as_int->collect(intType | intType.toStringType)->sortedBy(s | s))
		->asSet()
		->iterate(
			typeStringsOrderedSequence ;
			ptypes : Map(String, bip!PortType) = Map{} | 
			ptypes->including(
				typeStringsOrderedSequence.asPortName(),
				thisModule.MakePortType(typeStringsOrderedSequence)
			)
		);


unique lazy rule MakeChipsDataType {
	from datatype : String
	
	to chipsdatatype : bip!DataType(
		name <- 'chips_'+datatype,
		native <- false,
		superTypes <- Sequence{},
		castableTypes <- Sequence{},
		backendName <- 'chips_'+datatype
	)
}

unique lazy rule MakeBaseDataType {
	from datatype: String

	to dt : bip!DataType(
		name <- datatype,
		native <- true,
		superTypes <- Sequence{},
		castableTypes <- Sequence{},
		backendName <- datatype
	)
}

lazy rule MakeBufferPetriNet {
	from seq  : Sequence(bip!AtomInternalPortDeclaration)

	to pn : bip!PetriNet(
		states <- Sequence{rcv_state, snd_state},
		initStates <- Sequence{rcv_state},
		transitions <- Sequence{t_snd_to_rcv, t_rcv_to_snd}
	),

	t_rcv_to_snd : bip!Transition(
		sources <- Sequence{rcv_state},
		destinations <- Sequence{snd_state},
		triggerPort <- seq->at(1)
	),

	t_snd_to_rcv : bip!Transition(
		sources <- Sequence{snd_state},
		destinations <- Sequence{rcv_state},
		triggerPort <- seq->at(2)
		-- actions <- Add the tick clock for chips variables 
	),

	rcv_state : bip!State(
		name <- 'DATA_RECEIVING'
	),

	snd_state : bip!State(
		name <- 'DATA_SENDING'
	)
}

helper def: MakeScope(scopename:String,input:Boolean,output:Boolean,inner:Boolean,contextual:Boolean) : String = 
	scopename+
	if input then 
		':input'
	else 
		if output then 
			':output'
		else 
			if inner then 
				':inner'
			else 
				if contextual then 
					':ctx'
				else 
					':undefined'
				endif
			endif
		endif
	endif;
		

unique lazy rule MakeAIDD{
	from datatype :String, dataname:String, scope:String

	to aidd : bip!AtomInternalDataDeclaration(
		dataType <- thisModule.MakeChipsDataType(datatype),
		name <- dataname,
		const <- false,
		exported <- true
	)
}

unique lazy rule MakeDDRDP{
	from 
		datatype: String,
		aidd:bip!AtomInternalDataDeclaration,
		iindex:Integer,
		scope:String

	to 
		ddrdp: bip!DataDeclarationReferenceDataParameter(
			dataDeclarationReference <- aidd,
			parameterDeclaration <- pdpd,
			type <- thisModule.MakeChipsDataType(datatype)
		),

		pdpd: bip!PortDataParameterDeclaration(
			name <- 'v'+iindex.toString(),
			dataType <- thisModule.MakeChipsDataType(datatype)
		)
}

unique lazy rule MakeAEPD{
	from 
		datatype:Sequence(String), 
		name:String,
		scope:String

	to 	aepd: bip!AtomExportPortDeclaration(
			portType <- thisModule.MakePortType(datatype),
			name <-name,
			dataParameters <- datatype->iterate(
				typeString ; 
				accu : Sequence(TupleType(type:String,iindex:Integer)) = Sequence{Tuple{type='',iindex=-1}}|
				accu->append(Tuple{type=typeString, iindex = accu->last().iindex+1})
			)->select(t | t.iindex >=0)
			->collect(t | thisModule.MakeDDRDP(t.type,thisModule.MakeAIDD(t.type,'v'+t.iindex.toString(),scope),t.iindex,scope)),
			portDeclarationReferences <- Sequence{thisModule.MakeAIPD(name,datatype,scope)}
		)
}

unique lazy rule MakeChipsBufferType{
	from 
		datatype: String,
		scope:String

	using{
		stuff : TupleType(
			datatype:String,
			aidd: bip!AtomInternalDataDeclaration, 
			ddrdp: bip!DataDeclarationReferenceDataParameter, 
			aipd_in: bip!AtomInternalPortDeclaration,
			aipd_out: bip!AtomInternalPortDeclaration,
			aepd_in: bip!AtomExportPortDeclaration, 
			aepd_out: bip!AtomExportPortDeclaration 
		) = datatype.fromTypeToBufferRequiredData(scope);
	}
	
	to 
		buffer: bip!AtomType(
			name <- stuff.datatype + '_buffer_t', -- only for type
	        native <- false, -- only for type
	        superTypes <- Sequence{}, -- only for type
	        castableTypes <- Sequence{}, -- only for type
	        exportedPortDeclarations <- Sequence{stuff.aepd_in, stuff.aepd_out}, -- only for component type
	        exportedDataDeclarations <- Sequence{stuff.aidd}, -- only for component type
	        dataParameterDeclarations <- Sequence{}, -- only for component type
	        internalPortDeclarations <- Sequence{stuff.aipd_in, stuff.aipd_out, stuff.aepd_in, stuff.aepd_out}, -- only for atom type
	        behavior <- thisModule.MakeBufferPetriNet(Sequence{stuff.aipd_in,stuff.aipd_out}), -- only for atom type
	        internalDataDeclarations <- Sequence{stuff.aidd}, -- only for atom type
	        exportPortDeclarations <- Sequence{stuff.aepd_in, stuff.aepd_out}, -- only for atom type
	        priorities <- Sequence{}, -- only for atom type
	        invariants <- Sequence{} -- only for atom type
		)
}

helper context chips!logical_output def : toTuple : TupleType(type: String, name:String, suffix:String, exported:Boolean) =
	Tuple{
		type = self.extractTypeAsString,
		name = self.name,
		suffix = '_out',
		exported = true
	};

helper context chips!logical_parameter def : toTuple : TupleType(type: String, name:String, suffix:String, exported:Boolean) =
	Tuple{
		type = self.extractTypeAsString,
		name = self.name,
		suffix = '_in',
		exported = true
	};


helper context chips!physical_output def : toTuple : TupleType(type: String, name:String, suffix:String, exported:Boolean) =
	Tuple{
		type = self.extractTypeAsString,
		name = self.name,
		suffix = '_out',
		exported = true
	};

helper context chips!physical_parameter def : toTuple : TupleType(type: String, name:String, suffix:String, exported:Boolean) =
	Tuple{
		type = self.extractTypeAsString,
		name = self.name,
		suffix = '_in',
		exported = true
	};

helper context chips!primitive_declaration def : toTuple : TupleType(type: String, name:String, suffix:String, exported:Boolean) =
	Tuple{
		type = self.extractTypeAsString,
		name = self.variable.name,
		suffix = '_inner',
		exported = false
	};
	

unique lazy rule Tuple2AtomInternalDataDeclaration {
	from 
		tuple : TupleType(type: String, name:String, suffix:String, exported:Boolean), 
		fd:chips!function_definition -- to make the rule unique
	
	to aidd: bip!AtomInternalDataDeclaration(
			dataType <- thisModule.MakeChipsDataType(tuple.type),
			name <- tuple.name + tuple.suffix,
			const <- false,
			exported <- tuple.exported
		)
}

helper def : orderedTypeSeqAsPdpdList(type_ordered_sequence : Sequence(String)) : Sequence(bip!PortDataParameterDeclaration) =
	type_ordered_sequence
	->iterate( datatype ; tuples : Sequence(TupleType(stype:String , iindex : Integer)) = Sequence{Tuple{stype='',iindex=0}}
		| tuples.append(Tuple{stype = datatype, iindex = tuples->last().iindex+1})
	)
	->select(t | t.iindex > 0) -- removes the first element
	->collect( tuple | thisModule.TupleAsPortDataParameterDeclaration(tuple,type_ordered_sequence));


helper context Sequence(String) def : asPortName() : String = 
	if self->size() = 0 then 
		'port_t'
	else
		self->iterate(tname ; accu : String = '' | accu+tname)+'_port_t'
	endif;

unique lazy rule MakePortType {
	from 
		type_ordered_sequence : Sequence(String)

	to pt : bip!PortType(
		name <- type_ordered_sequence->asPortName(),
		native <- false,
		superTypes <- Sequence{},
		castableTypes <- Sequence{},
		dataParameterDeclarations <-thisModule.orderedTypeSeqAsPdpdList(type_ordered_sequence) 
	)
}

unique lazy rule TupleAsPortDataParameterDeclaration {
	from 
		t : TupleType(stype:String, iindex:Integer),
		-- specify the typesOrderedSequence to allow duplication of parameter declarations when declaring different port type
 		typesOrderedSequence: Sequence(String)
	to 
		pdpd: bip!PortDataParameterDeclaration(
			name <- 'v'+t.iindex.toString(),
			dataType <- thisModule.MakeChipsDataType(t.stype)
		)
}

lazy rule MakeState{
	from name:String
	to state:bip!State(
		name <- name
	)
}

helper context Sequence(OclAny) def :merge(other:Sequence(OclAny)) : Sequence(TupleType(first:OclAny, second:OclAny)) =
	if self->size() = other->size() then 
		thisModule.range(Sequence{self->size()})->iterate(
			i ; result : Sequence(TupleType(first:OclAny, second:OclAny)) = Sequence{} |
			result->append(Tuple{first=self->get(i.value), second= other->get(i.value)})
		) 
	else 
		OclUndefined 
	endif;

unique lazy rule MakeAIPD{
	from
		name:String,
		alldatatypes: Sequence(String),
		scope:String
	
	to port : bip!AtomInternalPortDeclaration(
		portType <- thisModule.MakePortType(alldatatypes),
		name <- name,
		dataParameters <- alldatatypes->iterate(
			typeString ; 
			accu : Sequence(TupleType(type:String,iindex:Integer)) = Sequence{Tuple{type='',iindex=-1}}|
			accu->append(Tuple{type=typeString, iindex = accu->last().iindex+1})
		)->select(t | t.iindex >=0)->collect(t | thisModule.MakeDDRDP(t.type,thisModule.MakeAIDD(t.type,name,scope),t.iindex,scope))
	)
}

lazy rule MakeTransition{
	from 
		source : bip!State,
		target : bip!State,
		port : bip!AtomInternalPortDeclaration,
		guardedby : OclAny

	to 
		trans : bip!Transition(
			sources <- Sequence{source},
			destinations <- Sequence{target},
			triggerPort <- port,
			guard <- guardedby
		)
}

lazy rule MakeTrivialGuard{
	from b:Boolean
	to g:bip!DirectBooleanExpression(
		value <- b
	)
}



helper def: MakeTransitions(stateslist : Sequence(bip!State), portslist : Sequence(bip!AtomInternalPortDeclaration)) : Sequence(bip!Transition) =

	if (stateslist->size()=6) then 
		Sequence{ -- contextual case
			thisModule.MakeTransition(stateslist->get(0),stateslist->get(1),portslist->get(0),thisModule.MakeTrivialGuard(true)), -- init to rcv / add guard
			thisModule.MakeTransition(stateslist->get(0),stateslist->get(3),portslist->get(0),thisModule.MakeTrivialGuard(true)), -- init to snd / add guard
			thisModule.MakeTransition(stateslist->get(1),stateslist->get(4),portslist->get(3),thisModule.MakeTrivialGuard(true)), -- rcv to readctx
			thisModule.MakeTransition(stateslist->get(4),stateslist->get(2),portslist->get(4),thisModule.MakeTrivialGuard(true)), -- readctx to then
			thisModule.MakeTransition(stateslist->get(2),stateslist->get(5),portslist->get(1),thisModule.MakeTrivialGuard(true)), -- then to writectx
			thisModule.MakeTransition(stateslist->get(5),stateslist->get(3),portslist->get(5),thisModule.MakeTrivialGuard(true)), -- writectx to snd
			thisModule.MakeTransition(stateslist->get(3),stateslist->get(1),portslist->get(2),thisModule.MakeTrivialGuard(true)) -- snd to rcv
		}
	else
		Sequence{ -- regular case
			thisModule.MakeTransition(stateslist->get(0),stateslist->get(1),portslist->get(0),thisModule.MakeTrivialGuard(true)), -- init to rcv
			thisModule.MakeTransition(stateslist->get(0),stateslist->get(3),portslist->get(0),thisModule.MakeTrivialGuard(true)), -- init to snd
			thisModule.MakeTransition(stateslist->get(1),stateslist->get(2),portslist->get(3),thisModule.MakeTrivialGuard(true)), -- rcv to then
			thisModule.MakeTransition(stateslist->get(2),stateslist->get(3),portslist->get(1),thisModule.MakeTrivialGuard(true)), -- then to snd
			thisModule.MakeTransition(stateslist->get(3),stateslist->get(1),portslist->get(2),thisModule.MakeTrivialGuard(true)) -- snd to rcv
		}
	endif;


rule FunctionDefinition2AtomType {
	from 
		chipsfunction: chips!function_definition

	using{

		-- retrieving the list of data that should be declared in the bip component
		-- sorting with names of the types to put in the ports to avoid generation of equivalent port types
		-- e.g. port(int, float) and port(float,int)
		---------------------------------------------------------------------------
		allparamsdecltuples : Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = chipsfunction.all_decl_params;
		
		alloutputsdecltuples : Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) = chipsfunction.all_decl_outputs;
		
		contextual_used : Sequence(TupleType(type: String, name:String, suffix:String, exported:Boolean)) =
			chipsfunction."then".statements->uses_contextuals()->flatten()->asSet()->asSequence()->sortedBy(t | t.type);

		-- Sorted param types
		----------------------------
		spt_input : Sequence(String) = allparamsdecltuples->collect(e | e.type);
		spt_output : Sequence(String) = alloutputsdecltuples->collect(e | e.type);
		spt_ctx : Sequence(String) = contextual_used->collect(e | e.type);


		-- Defining the states for the petri net
		--------------------------------------------------
		all_states : Sequence(bip!State) = Sequence{
			thisModule.MakeState('INIT'),
			thisModule.MakeState('RECEIVE'),
			thisModule.MakeState('THEN'),
			thisModule.MakeState('SEND')
		}->union(
			if (contextual_used->size()>0) then 
				Sequence{
					thisModule.MakeState('READCTX'),
					thisModule.MakeState('WRITECTX')
				}
			else
				Sequence{}
			endif

		);

		-- generating bip data declarations
		-----------------------------------
		aidd_ctx : Sequence(bip!AtomInternalDataDeclaration) = contextual_used->collect(e | thisModule.Tuple2AtomInternalDataDeclaration(e, chipsfunction));
    	aidd_input : Sequence(bip!AtomInternalDataDeclaration) = allparamsdecltuples->collect(e | thisModule.Tuple2AtomInternalDataDeclaration(e, chipsfunction));
		aidd_output : Sequence(bip!AtomInternalDataDeclaration) = alloutputsdecltuples->collect(e | thisModule.Tuple2AtomInternalDataDeclaration(e, chipsfunction));
		aidd_inner : Sequence(bip!AtomInternalDataDeclaration) = 
			chipsfunction.init.statements
			->select(stt | stt.oclIsKindOf(chips!primitive_declaration))
			->collect(primdecl | primdecl.toTuple)
			->collect(e | thisModule.Tuple2AtomInternalDataDeclaration(e, chipsfunction));


		-- generating port parameter declarations
		-----------------------------------------
		pdpd_inputs : Sequence(bip!PortDataParameterDeclaration) = thisModule.orderedTypeSeqAsPdpdList(spt_input);

		pdpd_outputs : Sequence(bip!PortDataParameterDeclaration) = thisModule.orderedTypeSeqAsPdpdList(spt_output);
		
		pdpd_ctx : Sequence(bip!PortDataParameterDeclaration) = thisModule.orderedTypeSeqAsPdpdList(spt_ctx);


		-- generating ports
		-------------------
		all_aipdecl : Sequence(bip!Port) = Sequence{
			thisModule.MakeAIPD('start', Sequence{},thisModule.MakeScope(chipsfunction.name,false,false,false,false)),
			thisModule.MakeAIPD('then',  Sequence{},thisModule.MakeScope(chipsfunction.name,false,false,false,false)),
			thisModule.MakeAIPD('send', spt_output, thisModule.MakeScope(chipsfunction.name,false,false,false,false)),
			thisModule.MakeAIPD('recv', spt_input, thisModule.MakeScope(chipsfunction.name,false,false,false,false))
		}->union(
			if (contextual_used->size()>0) then
				Sequence{
					thisModule.MakeAIPD('readctx', spt_ctx,thisModule.MakeScope(chipsfunction.name,false,false,false,false)),
					thisModule.MakeAIPD('writectx', spt_ctx,thisModule.MakeScope(chipsfunction.name,false,false,false,false))
				}
			else 
				Sequence{}
			endif
		);

		-- generating list of contextuals to export
		-------------------------------------------
		ctx_to_export : Sequence(bip!AtomExportPortDeclaration) = 
			if contextual_used.isEmpty() then 
				Sequence{}
			else 
				Sequence{
					thisModule.MakeAEPD(
						spt_ctx,
						'readctx',
						thisModule.MakeScope(chipsfunction.name,false,false,false,true)
					),
					thisModule.MakeAEPD(
						spt_ctx,
						'writectx',
						thisModule.MakeScope(chipsfunction.name,false,false,false,true)
					)
				}
			endif;
		
	}

	to core_component_type: bip!AtomType(
    	name <- chipsfunction.name + '_core', -- only for type  	OK
        native <- false, -- only for type							OK
        superTypes <- Sequence{}, -- only for type					OK
        castableTypes <- Sequence{}, -- only for type				OK
        exportedPortDeclarations <- Sequence{}, -- only for component type
        exportedDataDeclarations <- Sequence{}, -- only for component type
		dataParameterDeclarations <- Sequence{starts}, -- only for component type
        internalPortDeclarations <- all_aipdecl, -- only for atom type
        externalPortDeclarations <- Sequence{}, -- only for atom type
        behavior <- pn, -- only for atom type
        internalDataDeclarations <- Sequence{aidd_input,aidd_output,aidd_inner, aidd_ctx}->flatten(), -- only for atom type
        exportPortDeclarations <- Sequence{aepd_snd,aepd_rcv}->union(ctx_to_export), -- only for atom type
        priorities <- Sequence{}, -- only for atom type
        invariants <- Sequence{} -- only for atom type
    ),


	starts : bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBaseDataType('bool'),
		name <- 'starts',
		const <- true
	),

	aepd_snd : bip!AtomExportPortDeclaration(
		portType <-thisModule.MakePortType(spt_output),
		name <-'output',
		dataParameters <- Sequence{},
		portDeclarationReferences <- Sequence{}
	),

	aepd_rcv : bip!AtomExportPortDeclaration(
		portType <-thisModule.MakePortType(spt_input),
		name <-'input',
		dataParameters <- Sequence{},
		portDeclarationReferences <- Sequence{}
	),

	pn : bip!PetriNet(
		states <- all_states,
		initStates <- Sequence{all_states->at(1)},
		transitions <- thisModule.MakeTransitions(all_states, all_aipdecl),
		initialActions <- Sequence{} -- put the call to the init function here
	)
}

unique lazy rule MakeBufferComponentDeclaration{
	from 
		datatype: String,
		dataname:String,
		scope:String -- to make one declaration per function, even if parameters have same signature

	to bufferdeclaration : bip!ComponentDeclaration(
		type <- thisModule.MakeChipsBufferType(datatype,scope),
		parameters <- Sequence{},
		name <- dataname
	)
}

lazy rule MakeConnectorDataDeclaration{
	from tuple:TupleType(type:String, iindex:Integer)


	to cdd:bip!ConnectorDataDeclaration(
		dataType <- thisModule.MakeBaseDataType(tuple.type),
		name <- 'v'+tuple.iindex.toString()
		-- value<-
		-- const<-false
	)
}

lazy rule MakeConnectorDataDeclarationReferenceDataParameter {
	from type:String, datadecl:bip!ConnectorDataDeclaration

	to ddrdp:bip!DataDeclarationReferenceDataParameter(
		dataDeclarationReference<-datadecl,
		type<-thisModule.MakeBaseDataType(type),
		parameterDeclaration <- datadecl
	)
}

lazy rule MakeConnectorExportedPortDeclaration{
	from 
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)),
		many2one:Boolean, 
		datadecls:Sequence(bip!ConnectorDataDeclaration)
	
	to b:bip!ConnectorExportedPortDeclaration(
		portType <-thisModule.MakePortType(indexed_types->collect(tuple | tuple.type)),
		name <- if many2one then 'r' else 's' endif +'0',
		dataParameters <- indexed_types->collect(tuple | thisModule.MakeConnectorDataDeclarationReferenceDataParameter(tuple.type,datadecls->get(tuple.iindex))) 
	)
}

lazy rule MakeAssignmentSubDataOperand{
	from port: bip!ConnectorPortParameterDeclaration, datadecl: bip!PortDataParameterDeclaration

	to rhs: bip!SubDataDeclarationReferenceExpression(
		subDataDeclarationRef<-subddr
	),

	subddr:bip!SubDataDeclarationReference(
		forwardDataDeclaration <- datadecl,
		portDeclaration <- port
	)
}

lazy rule MakeAssignmentDataOperand{
	from datadecl:bip!ConnectorDataDeclaration,stype:String

	to dddre:bip!DirectDataDeclarationReferenceExpression(
		--type<-thisModule.MakeBaseDataType(stype),
		dataDeclaration<-datadecl
	)
}

lazy rule MakeAssignment{
	from 
		asslhs:bip!Expression,
		assrhs:bip!Expression
	
	to
		assignment:bip!AssignmentExpression(
			lhs<-asslhs,
			rhs<-assrhs
		)
}

unique lazy rule MakeMany2OneConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = ordered_types->iterate(
			typeString ; 
			accu : Sequence(TupleType(type:String,iindex:Integer)) = Sequence{Tuple{type='',iindex=-1}}|
			accu->append(Tuple{type=typeString, iindex = accu->last().iindex+1})
		)->select(t | t.iindex >=0);

		datadecls:Sequence(bip!ConnectorDataDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		downports : Sequence(bip!ConnectorPortParameterDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,true));

		upinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n.value),
						ordered_types->get(n.value)
					),
					thisModule.MakeAssignmentSubDataOperand(
						downports->get(n.value),
						thisModule.TupleAsPortDataParameterDeclaration(
							Tuple{stype=ordered_types->get(n.value), iindex=0},
							ordered_types
						)
					)
				)
			);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'many2one_'| accu_name+iter )+'_t',
		exportedPortDeclaration <- thisModule.MakeConnectorExportedPortDeclaration(indexed_types, true,datadecls),
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		--interactionDefinition
		ports <- downports
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports, --(ConnectorPortParameterDeclaration)
		up <- upinteraction, --(Expression)
		down <- Sequence{} , --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
}



lazy rule MakeConnectorPortParameterDeclaration{
	from t:TupleType(type:String,iindex:Integer), sender:Boolean

	to cppd: bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(Sequence{t.type}),
		name<- if sender then 's' else 'r' endif +t.iindex.toString()
	)
}

unique lazy rule MakeFlowConnectorType{
	from ordered_datatypes:Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = ordered_datatypes->iterate(
			typeString ; 
			accu : Sequence(TupleType(type:String,iindex:Integer)) = Sequence{Tuple{type='',iindex=-1}}|
			accu->append(Tuple{type=typeString, iindex = accu->last().iindex+1})
		)->select(t | t.iindex >=0);

		downports_src : Sequence(bip!ConnectorPortParameterDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,true));
		downports_rcv : Sequence(bip!ConnectorPortParameterDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,false));

		downinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{ordered_datatypes->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						downports_src->get(n.value),
						thisModule.TupleAsPortDataParameterDeclaration(
							Tuple{stype=ordered_datatypes->get(n.value), iindex=n.value},
							ordered_datatypes
						)
					),
					thisModule.MakeAssignmentSubDataOperand(
						downports_rcv->get(n.value),
						thisModule.TupleAsPortDataParameterDeclaration(
							Tuple{stype=ordered_datatypes->get(n.value), iindex=n.value},
							ordered_datatypes
						)
					)
				)
			);
	}

	to one : bip!ConnectorType(
		name<-ordered_datatypes->iterate( iter ; accu_name : String = 'flow_'| accu_name+iter )+'_t',
		dataDeclarations <- Sequence{},
		interactions<-Sequence{interaction},
		--interactionDefinition
		ports <- downports_src->union(downports_rcv)
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts <- downports_src->union(downports_rcv), --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
}


unique lazy rule MakeOne2ManyConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = ordered_types->iterate(
			typeString ; 
			accu : Sequence(TupleType(type:String,iindex:Integer)) = Sequence{Tuple{type='',iindex=-1}}|
			accu->append(Tuple{type=typeString, iindex = accu->last().iindex+1})
		)->select(t | t.iindex >=0);

		datadecls:Sequence(bip!ConnectorDataDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		downports : Sequence(bip!ConnectorPortParameterDeclaration) = indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,false));

		downinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						downports->get(n.value),
						thisModule.TupleAsPortDataParameterDeclaration(
							Tuple{stype=ordered_types->get(n.value), iindex=n.value},
							ordered_types
						)
					),
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n.value),
						ordered_types->get(n.value)
					)
				)
			);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'one2many_'| accu_name+iter )+'_t',
		exportedPortDeclaration <- thisModule.MakeConnectorExportedPortDeclaration(indexed_types, true,datadecls),
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		--interactionDefinition
		ports <- downports
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports, --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
}

lazy rule MakePortDeclarationsReferenceParameter {
	from 
		tuple:TupleType(type: String, iindex:Integer),
		ordered_types:Sequence(String),
		decls:Sequence(bip!ComponentDeclaration),
		fwd_port_decl : bip!PortDeclaration,
		many2one:Boolean,
		fname:String
	
	using{
		port_decl :TupleType(type:String, iindex:Integer) = 
			thisModule.MakeConnectorPortParameterDeclaration(Tuple{type=tuple.type, iindex = tuple.iindex},many2one);
	}

	to theport: bip!PortDeclarationReferenceParameter(
		parameterDeclaration <- port_decl,
		subPortDeclarationReference <- spdr
	),

	spdr: bip!SubPortDeclarationReference(
		forwardPortDeclaration <- fwd_port_decl,-- to code when export port declaration done 
		componentDeclaration <- decls->at(tuple.iindex+1)
	)
}

helper context Sequence(TupleType(type: String, iindex:Integer)) 
	def : asPortDeclRefParamSequence(
		decls:Sequence(bip!ComponentDeclaration),
		forwardPortDecl:bip!PortDeclaration,
		many2one:Boolean,
		fname:String
	) : Sequence(bip!PortDeclarationReferenceParameter) =
		let sorted_types:Sequence(String) = self->collect(t|t.type) in
		self->collect(tuple | thisModule.MakePortDeclarationsReferenceParameter(tuple, sorted_types, decls,forwardPortDecl,many2one,fname));


lazy rule MakeConnectorSubPortDeclarationReference{
	from 
		portdecl : bip!ConnectorExportedPortDeclaration,
		conndecl : bip!ConnectorDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, --portDeclaration (AtomEportedPortDeclaration?)/(ConnectorExportedPortDeclaration)
		--componentDeclaration <-  --(ComponentDeclaration)
		-- or 
		connectorDeclaration <- conndecl --(ConnectorDeclaration)
	)
}

lazy rule MakeAtomSubPortDeclarationReference{
	from 
		portdecl : bip!PortDeclaration,
		compdecl : bip!ComponentDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, --portDeclaration (AtomEportedPortDeclaration?)/(ConnectorExportedPortDeclaration)
		componentDeclaration <- compdecl --(ComponentDeclaration)
		-- or 
		--connectorDeclaration <- --(ConnectorDeclaration)
	)
}

lazy rule MakeCompoundSubCompExportPortDeclaration{
	from 
		datatype:String,
		dataname:String,
		portdecl : bip!PortDeclaration,
		subcomponent:bip!ComponentDeclaration

	to cepd:bip!CompoundExportPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{datatype}),
		name <- dataname,
		portDeclarationReferences <- Sequence{thisModule.MakeAtomSubPortDeclarationReference(
			portdecl, subcomponent
		)}
	)
}

lazy rule MakeCompoundSubConnExportPortDeclaration{
	from 
		porttype:bip!PortType,
		name:String,
		portdecl: bip!SubPortDeclarationReference

	to cepd:bip!CompoundExportPortDeclaration(
		portType <- porttype,
		name <- name,
		portDeclarationReferences <- Sequence{portdecl}
	)
}

helper context String def : fromTypeToBufferRequiredData(scope:String)
: TupleType(
	datatype:String,
	aidd: bip!AtomInternalDataDeclaration, 
	ddrdp: bip!DataDeclarationReferenceDataParameter, 
	aipd_in: bip!AtomInternalPortDeclaration,
	aipd_out: bip!AtomInternalPortDeclaration,
	aepd_in: bip!AtomExportPortDeclaration,
	aepd_out: bip!AtomExportPortDeclaration 
) = Tuple{
		datatype=self,
		aidd = thisModule.MakeAIDD(self,self+'_data',scope), 
		ddrdp = thisModule.MakeDDRDP(self,self,thisModule.MakeAIDD(self,self+'_data',scope),scope), 
		aipd_in = thisModule.MakeAIPD(self+'_input', Sequence{self}, scope),
		aipd_out = thisModule.MakeAIPD(self+'_output',Sequence{self},scope),
		aepd_in = thisModule.MakeAEPD(Sequence{self}, 'input', scope),
		aepd_out = thisModule.MakeAEPD(Sequence{self}, 'output', scope)
	};

lazy rule MakeConnectorDeclaration{
	from 
		conntype : bip!ConnectorType,
		portparameters: Sequence(bip!PortDeclarationReferenceParameter),
		name:String
	to 
		conn:bip!ConnectorDeclaration(
			type <- conntype,
			portParameters <- portparameters,
			name <- name
		)
}

unique lazy rule MakeCompoundType{
	from
		n:String,
		dpd : Sequence(bip!ComponentDataParameterDeclaration),
		compd: Sequence(bip!ComponentDeclaration),
		connd: Sequence(bip!ConnectorDeclaration),
		epd: Sequence(bip!CompoundExportPortDeclaration)
	to
		ct:bip!CompoundType(
			name <- n,
			dataParameterDeclarations <- dpd,
			componentDeclarations <- compd,
			connectorDeclarations <- connd,
			exportPortDeclarations <- epd,
			exportedPortDeclarations <- epd
		)
}

helper context Sequence(OclAny) def : augmentWithIindex() : Sequence(TupleType(data:OclAny, iindex:Integer)) =
	thisModule.range(Sequence{self->size()})->collect(x | Tuple{data=self->get(x.value), iindex=x.value});

unique lazy rule FunctionDefinition2CompoundType {
	from 
		chipsfunction: chips!function_definition

	using {

		input_is_many2one : Boolean = true;

		parameters_of_input_buffer_list : Sequence(
			TupleType(
				datatype: String,
				dataname: String
			)
		) = chipsfunction.all_decl_params->collect(param | Tuple{datatype = param.type, dataname=param.name});

		input_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
			parameters_of_input_buffer_list->collect(param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(param.datatype,param.dataname,thisModule.MakeScope(chipsfunction.name,true,false,false,false))
			}
		);

		input_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = parameters_of_input_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex});

		input_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = input_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,input_is_many2one));

		input_datadecls: Sequence(bip!ConnectorDataDeclaration) = input_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		input_epdecl: bip!ConnectorExportedPortDeclaration = thisModule.MakeConnectorExportedPortDeclaration(input_indexed_types, input_is_many2one, input_datadecls);

		input_connector_type : bip!ConnectorType = thisModule.MakeMany2OneConnectorType(input_indexed_types->collect(t | t.type));

		input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) =
			input_indexed_types->asPortDeclRefParamSequence(input_one_type_buffer_list->collect(p | p.component),input_epdecl,input_is_many2one, chipsfunction.name);

		input_conndecl:bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				input_connector_type,
				input_pdeclsrefparam,
				'to_the_core'
			);
		
		input_connsubportdecl: bip!SubPortDeclarationReference = thisModule.MakeConnectorSubPortDeclarationReference(input_epdecl, input_conndecl);

		input_connexportportdecl: bip!CompoundExportPortDeclaration = 
		thisModule.MakeCompoundSubConnExportPortDeclaration(
			thisModule.MakePortType(input_indexed_types->collect(t | t.type)),
			'to_the_core',
			input_connsubportdecl
		);

		input_subcompoundexportportdecl: Sequence(bip!CompoundExportPortDeclaration) = 
		parameters_of_input_buffer_list->collect(parameter | 
			let stuff : TupleType(
				datatype:String,
				aidd: bip!AtomInternalDataDeclaration, 
				ddrdp: bip!DataDeclarationReferenceDataParameter, 
				aipd_in: bip!AtomInternalPortDeclaration,
				aipd_out: bip!AtomInternalPortDeclaration,
				aepd_in: bip!AtomExportPortDeclaration, 
				aepd_out: bip!AtomExportPortDeclaration 
			) = parameter.datatype.fromTypeToBufferRequiredData(thisModule.MakeScope(chipsfunction.name,true,false,false,false)) in
			thisModule.MakeCompoundSubCompExportPortDeclaration(
				parameter.datatype,
				parameter.dataname,
				stuff.aepd_in,
				thisModule.MakeBufferComponentDeclaration(parameter.datatype, parameter.dataname, thisModule.MakeScope(chipsfunction.name,true,false,false,false))
			)
		);

		input_compoundtype:bip!CompoundType = thisModule.MakeCompoundType(
			chipsfunction.name+'RX',
			Sequence{},
			input_one_type_buffer_list->collect(t | t.component),
			Sequence{input_conndecl},
			input_subcompoundexportportdecl->union(Sequence{input_connexportportdecl})
		);
		
		

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		
		output_is_many2one : Boolean = false;

		parameters_of_output_buffer_list : Sequence(
			TupleType(
				datatype: String,
				dataname: String
			)
		) = chipsfunction.all_decl_outputs->collect(param | Tuple{datatype = param.type, dataname=param.name});

		output_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
			parameters_of_output_buffer_list->collect(param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(param.datatype,param.dataname, thisModule.MakeScope(chipsfunction.name,false,true,false,false))
			}
		);

		output_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = parameters_of_output_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex});

		output_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = output_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,output_is_many2one));

		output_datadecls: Sequence(bip!ConnectorDataDeclaration) = output_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t));

		output_epdecl: bip!ConnectorExportedPortDeclaration = thisModule.MakeConnectorExportedPortDeclaration(output_indexed_types, output_is_many2one, output_datadecls);

		output_connector_type : bip!ConnectorType = thisModule.MakeOne2ManyConnectorType(output_indexed_types->collect(t | t.type));

		output_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) =
			output_indexed_types->asPortDeclRefParamSequence(
				output_one_type_buffer_list->collect(p | p.component),
				output_epdecl,
				output_is_many2one, 
				chipsfunction.name
			);

		output_conndecl:bip!ConnectorDeclaration = 
			thisModule.MakeConnectorDeclaration(
				output_connector_type,
				output_pdeclsrefparam,
				'from_the_core'
			);
		
		output_connsubportdecl: bip!SubPortDeclarationReference = thisModule.MakeConnectorSubPortDeclarationReference(output_epdecl, output_conndecl);

		output_connexportportdecl: bip!CompoundExportPortDeclaration = 
		thisModule.MakeCompoundSubConnExportPortDeclaration(
			thisModule.MakePortType(output_indexed_types->collect(t | t.type)),
			'from_the_core',
			output_connsubportdecl
		);

		

		output_subcompoundexportportdecl: Sequence(bip!CompoundExportPortDeclaration) = 
		parameters_of_output_buffer_list->collect(parameter | 
			let stuff : TupleType(
				datatype:String,
				aidd: bip!AtomInternalDataDeclaration, 
				ddrdp: bip!DataDeclarationReferenceDataParameter, 
				aipd_in: bip!AtomInternalPortDeclaration,
				aipd_out: bip!AtomInternalPortDeclaration,
				aepd_in: bip!AtomExportPortDeclaration, 
				aepd_out: bip!AtomExportPortDeclaration 
			) = parameter.datatype.fromTypeToBufferRequiredData(thisModule.MakeScope(chipsfunction.name,false,true,false,false)) in
			thisModule.MakeCompoundSubCompExportPortDeclaration(
				parameter.datatype,
				parameter.dataname,
				stuff.aepd_out,
				thisModule.MakeBufferComponentDeclaration(parameter.datatype, parameter.dataname, thisModule.MakeScope(chipsfunction.name,false,true,false,false))
			)
		);

		
		output_compoundtype:bip!CompoundType = thisModule.MakeCompoundType(
			chipsfunction.name+'TX',
			Sequence{},
			output_one_type_buffer_list->collect(t | t.component),
			Sequence{output_conndecl},
			output_subcompoundexportportdecl->union(Sequence{output_connexportportdecl})
		);

		
		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = thisModule.MakeCoreComponent(chipsfunction);
		input_buffer_declaration : bip!ComponentDeclaration = thisModule.MakeBufferCompoundDeclaration('input_parameters',input_compoundtype,chipsfunction);
		output_buffer_declaration : bip!ComponentDeclaration = thisModule.MakeBufferCompoundDeclaration('output_parameters',output_compoundtype,chipsfunction);


		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		from_the_outside : bip!SubPortDeclarationReference = thisModule.MakeAtomSubPortDeclarationReference(input_connexportportdecl,input_buffer_declaration);
		--to_the_core : bip!SubPortDeclarationReference = thisModule.MakeAtomSubPortDeclarationReference(,);

		flow_input_to_core: bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			thisModule.MakeFlowConnectorType(chipsfunction.all_decl_params->collect(t | t.type)),
			input_pdeclsrefparam,--->union(Sequence{from_the_outside,to_the_core}),
			'RX_to_core'
		);

		--from_the_core : bip!SubPortDeclarationReference = ;
		--to_the_outside : bip!SubPortDeclarationReference = ;

		flow_core_to_output: bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			thisModule.MakeFlowConnectorType(chipsfunction.all_decl_outputs->collect(t | t.type)),
			output_pdeclsrefparam,--->union(Sequence{from_the_core, to_the_outside}),
			'core_to_TX'
		);

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) = ;
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name,
		dataParameterDeclarations <- Sequence{thisModule.MakeStartParameter(thisModule.MakeScope(chipsfunction.name,false,false,false,false))},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(thisModule.MakeBufferCompoundDeclaration('input_parameters',input_compoundtype,chipsfunction))
			->append(thisModule.MakeBufferCompoundDeclaration('output_parameters',output_compoundtype,chipsfunction)),
		connectorDeclarations<- Sequence{flow_input_to_core, flow_core_to_output}--,--need to add the connectors
		--exportPortDeclarations <- exportedportdecl
	)
}
unique lazy rule MakeBufferCompoundDeclaration{
	from 
		name:String,
		type:bip!CompoundType,
		chipsfunction:chips!function_definition
		
	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name,
		parameters<- Sequence{},
		type <- type
	)
}

unique lazy rule MakeCoreComponent {
	from 
		chipsfunction: chips!function_definition

	to core_component_declaration: bip!ComponentDeclaration(
		type <- chipsfunction,
		parameters <- Sequence{starts_valued_expression},
		name <- 'core'
	),
	
	starts_valued_expression: bip!DirectDataDeclarationReferenceExpression (
		dataDeclaration <- thisModule.MakeStartParameter(thisModule.MakeScope(chipsfunction.name,false,false,false,false))
	)
}

unique lazy rule MakeStartParameter{
	from scope:String

	to start_parameter:  bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBaseDataType('bool'),
		name <- 'starts',
		const <- true
	)
}
