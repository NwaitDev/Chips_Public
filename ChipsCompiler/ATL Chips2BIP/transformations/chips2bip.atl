-- @atlcompiler emftvm
-- @path chips=/Chips2bip/Chips1.1.ecore
-- @path bip=/Chips2Bip/bip.ecore
module chips2bip;

create OUT: bip from IN: chips;

helper context chips!logical_parameter  def : extractTypeAsInt() : Integer =
	Sequence{chips!int_logical_parameter,chips!float_logical_parameter,chips!bool_logical_parameter}->indexOf(self.oclType());


helper def : intAsStringType(nb : Integer) : String =
    let types : Sequence(String) = Sequence{'int','float','bool'} in
    if nb >= 1 and nb <= types->size() then
        types->at(nb)
    else
        'unknown'
    endif;

helper context chips!logical_parameter  def : extractTypeAsString() : String =
	if self.oclIsTypeOf(chips!int_logical_parameter)
	then
		'int'
	else
		if self.oclIsTypeOf(chips!float_logical_parameter)
		then 
			'float'
		else
			'bool'
		endif
	endif;


helper def: allDataTypes : Set(String) =
    chips!function_definition.allInstances()
        ->collect(f | f.parameters->collect(p | p.extractTypeAsString()))
        ->flatten()
        ->asSet();

helper def: allPortTypes : Set(bip!PortType) =
	chips!function_definition.allInstances()
        ->collect(fd | fd.parameters)
		->collect(paramlist | paramlist->collect(param | param.extractTypeAsInt())->asBag())
		->asSet()
		->collect(paramAsIntBag | paramAsIntBag->collect(paramAsInt | thisModule.intAsStringType(paramAsInt)))
		->collect(typesBag | thisModule.typesBagAsPortType(typesBag));

unique lazy rule typesBagAsPortType {
	from tb : Bag(String)
	
	to pt : bip!PortType(
		name <- tb->iterate(tname ; accu : String = '' | accu+tname),
		dataParameterDeclarations <- tb->collect( typename | thisModule.TypeNameAsPortDataParameterDeclaration(typename))
	)
}

lazy rule TypeNameAsPortDataParameterDeclaration {
	from typename: String
	
	to pdpd: bip!PortDataParameterDeclaration(
		name <- 'v0',
		dataType <- thisModule.MakeChipsDataType(typename)
	)
}

lazy rule MakeChipsDataType {
	from typename : String
	
	to chipsdatatype : bip!DataType(
		name <- 'chips_'+typename,
		native <- false,
		superTypes <- Sequence{},
		castableTypes <- Sequence{},
		backendName <- 'chips_'+typename
	)
}

rule Program2BipPackage {
	from chipsprogram: chips!program
	
	to bippackage: bip!BipPackage(
		name <- chipsprogram.fileName,
		atomTypes <- Sequence{},--chipsprogram.preamble.definitions->select(d | d.oclIsKindOf(chips!function_definition)),
		compoundTypes <- Sequence{},
		connectorTypes <- Sequence{},
		portTypes <- thisModule.allPortTypes->asSequence(),
		dataTypes <- thisModule.allDataTypes->collect(t | thisModule.MakeChipsDataType(t)),
		used_packages <- Sequence{},
		constData <- Sequence{},
		prototypes <- Sequence{}
	)
}

