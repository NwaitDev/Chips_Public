	);

helper context chips!function_definition def: extractOutputBufferCompoundType() : bip!CompoundType =
	let output_is_many2one:Boolean = false in
	let parameters_of_output_buffer_list : Sequence(TupleType(datatype: String,dataname: String)) = 
		self.all_decl_outputs->collect(param | Tuple{datatype = param.type, dataname=param.name}) in
	let output_one_type_buffer_list: Sequence(TupleType(name: String, component:bip!ComponentDeclaration)) =
		parameters_of_output_buffer_list->collect(
			param | Tuple{
				name=param.dataname,
				component=thisModule.MakeBufferComponentDeclaration(
					param.datatype,	
					param.dataname,
					thisModule.makeInputCoreScope(
						parameters_of_output_buffer_list->collect(t|t.datatype)
					)
				)
			}
		) in
	let output_indexed_types: Sequence(TupleType(type:String,iindex:Integer)) = 
		parameters_of_output_buffer_list->augmentWithIindex()->collect(t | Tuple{type=t.data.datatype, iindex=t.iindex}) in
	let output_manyports: Sequence(bip!ConnectorPortParameterDeclaration) = 
		output_indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(t,output_is_many2one)) in
	let output_datadecls: Sequence(bip!ConnectorDataDeclaration) =
		output_indexed_types->collect(t | thisModule.MakeConnectorDataDeclaration(t.type, t.iindex)) in
	let	output_epdecl: bip!ConnectorExportedPortDeclaration =
		thisModule.MakeConnectorExportedPortDeclaration(output_indexed_types, output_is_many2one, output_datadecls) in 
	let output_connector_type : bip!ConnectorType = 
		thisModule.MakeMany2OneConnectorType(output_indexed_types->collect(t | t.type)) in 
	let output_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) = 
		output_indexed_types->asPortDeclRefParamSequence(
			output_one_type_buffer_list->collect(p | p.component),
			output_epdecl,
			output_is_many2one,
			self.name
		) in 
	let output_conndecl:bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			output_connector_type,
			output_pdeclsrefparam,
			'from_the_core'
		) in
	let output_connsubportdecl: bip!SubPortDeclarationReference = 
		thisModule.MakeConnectorSubPortDeclarationReference(
			output_epdecl,
			output_conndecl
		) in
	let output_connexportportdecl: bip!CompoundExportPortDeclaration = 
		thisModule.MakeCompoundSubConnExportPortDeclaration(
			thisModule.MakePortType(output_indexed_types->collect(t | t.type)),
			'from_the_core',
			output_connsubportdecl
		) in
	let output_subcompoundexportportdecl: Sequence(bip!CompoundExportPortDeclaration) = 
		parameters_of_output_buffer_list->collect(
			parameter | thisModule.MakeCompoundSubCompExportPortDeclaration(
				parameter.datatype,
				parameter.dataname,
				thisModule.MakeAEPD(
					'from_the_outside',
					Sequence{parameter.datatype},
					Sequence{parameter.dataname},
					thisModule.makeOutputCoreScope(
						parameters_of_output_buffer_list->collect(t | t.datatype)
					)
				), 
				output_one_type_buffer_list->any(comp | comp.name = parameter.dataname).component
			)
		) in
		thisModule.MakeCompoundType(
			self.name+'TX',
			Sequence{},
			output_one_type_buffer_list->collect(t | t.component),
			Sequence{output_conndecl},
			output_subcompoundexportportdecl->union(Sequence{output_connexportportdecl})
		);


unique lazy rule FunctionDefinition2CompoundType {
	from 
		chipsfunction: chips!function_definition

	using {

		input_compound_type : bip!CompoundType = chipsfunction.extractInputBufferCompoundType();
		output_compound_type : bip!CompoundType = chipsfunction.extractOutputBufferCompoundType();

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = thisModule.MakeCoreComponent(chipsfunction);
		input_buffer_declaration : bip!ComponentDeclaration = thisModule.MakeBufferCompoundDeclaration('input_parameters',input_compound_type,chipsfunction);
		output_buffer_declaration : bip!ComponentDeclaration = thisModule.MakeBufferCompoundDeclaration('output_parameters',output_compound_type,chipsfunction);


		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- need to extract :
		input_connexportportdecl : bip!CompoundExportPortDeclaration = chipsfunction.extractInputConnExportPortDecl();
		input_pdeclsrefparam : Sequence(bip!PortDeclarationReferenceParameter) = chipsfunction.extractInputPDeclsRefParams();


		from_the_outside : bip!SubPortDeclarationReference = thisModule.MakeAtomSubPortDeclarationReference(input_connexportportdecl,input_buffer_declaration);
		--to_the_core : bip!SubPortDeclarationReference = thisModule.MakeAtomSubPortDeclarationReference(,);

		flow_input_to_core: bip!ConnectorDeclaration = 
		thisModule.MakeConnectorDeclaration(
			thisModule.MakeFlowConnectorType(chipsfunction.all_decl_params->collect(t | t.type)),
			input_pdeclsrefparam,--->union(Sequence{from_the_outside,to_the_core}),
			'RX_to_core'
		);

		--from_the_core : bip!SubPortDeclarationReference = ;
		--to_the_outside : bip!SubPortDeclarationReference = ;

		-- flow_core_to_output: bip!ConnectorDeclaration = 
		-- thisModule.MakeConnectorDeclaration(
		-- 	thisModule.MakeFlowConnectorType(chipsfunction.all_decl_outputs->collect(t | t.type)),
		-- 	output_pdeclsrefparam,--->union(Sequence{from_the_core, to_the_outside}),
		-- 	'core_to_TX'
		-- );

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------
		-- exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) = ;
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name,
		dataParameterDeclarations <- Sequence{thisModule.MakeStartParameter(thisModule.makeCoreScope(chipsfunction))},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(thisModule.MakeBufferCompoundDeclaration('input_parameters',input_compound_type,chipsfunction))
			->append(thisModule.MakeBufferCompoundDeclaration('output_parameters',output_compound_type,chipsfunction)),
		connectorDeclarations<- Sequence{flow_input_to_core}--,
		--exportPortDeclarations <- exportedportdecl
	)
}

unique lazy rule MakeBufferCompoundDeclaration{
	from 
		name:String,
		type:bip!CompoundType,
		chipsfunction:chips!function_definition
		
	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name,
		parameters<- Sequence{},
		type <- type
	)
}

unique lazy rule MakeCoreComponent {
	from 
		chipsfunction: chips!function_definition

	to core_component_declaration: bip!ComponentDeclaration(
		type <- chipsfunction,
		parameters <- Sequence{starts_valued_expression},
		name <- 'core'
	),
	
	starts_valued_expression: bip!DirectDataDeclarationReferenceExpression (
		dataDeclaration <- thisModule.MakeStartParameter(thisModule.makeCoreScope(chipsfunction))
	)
}

unique lazy rule MakeStartParameter{
	from scope:String

	to start_parameter:  bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBaseDataType('bool'),
		name <- 'starts',
		const <- true
	)
}

lazy rule MakeConstantParameter{
	from type:String

	to parameter:  bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeChipsDataType(type),
		name <- 'param',
		const <- true
	)
}
