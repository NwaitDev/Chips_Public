		value=Tuple{var = self.variable_expression, input = self.parameter}
	};

helper context chips!bool_logical_output def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny) =
	Tuple{
		type='output',
		value=Tuple{var = self.variable_expression, output = self.output}
	};

helper context chips!logical_bool_eater def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : TupleType(type:String, value:OclAny) =
	Tuple{
		type='input',
		value=Tuple{var = self.variable_expression, input = self.parameter}
	};

-- getNames helpers
-------------------

helper context chips!physical_collective_cast def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.collective_function.name + '_on_' + self.physical_feeder_expression.getName(memory);

helper context chips!int_physical_output def : getName(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : String = 
	self.variable_expression.variable.name+
	self.variable_expression.index->getName(memory)
	+'_'+self.output.name;

