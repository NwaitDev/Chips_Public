lazy rule MakeCompoundDeclaration{
	from 
		name:String,
		chipsfunction:chips!function_definition
		
	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name,
		parameters<- Sequence{},
		type <- thisModule.FunctionDefinition2CompoundType(chipsfunction)
	)
}

helper context TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer)) def :
intoCompoundDeclarations() : Sequence(bip!componentDeclaration) =
let linearized_total: Integer = 
	if self.dimensions->isEmpty() then
		1
	else 
		self.dimensions->iterate( i ; acc:Integer = 1| acc*(i+1))-1
	endif 
in	thisModule.range(Sequence{linearized_total})
	->collect(i | thisModule.MakeCompoundDeclaration(self.key+i.value.toString(),self.type));




unique lazy rule MakeSystemCompoundType{
	from 
		all_compounds: Bag(bip!ComponentDeclaration)--,
		--all_connectors: Sequence(bip!connectorDeclaration)

	to compound : bip!CompoundType(
		name <- 'SYSTEM_COMPOUND',
        native <- false,
        superTypes <- Sequence{},
        castableTypes <- Sequence{},
        exportedPortDeclarations <- Sequence{},
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- all_compounds,
		connectorDeclarations <- Sequence{},
		exportPortDeclarations <- Sequence{},
		exportDataDeclarations <- Sequence{},
		priorities <- Sequence{}
	)
}

unique lazy rule MakeConstantAtomType{
	from
		type:String

	using {
		dataname : String = type+'_value';
		aidd:bip!AtomInternalDataDeclaration = 
			thisModule.MakeAtomInternalDataDeclaration(type, dataname);
		aipd_out:bip!AtomInternalDataDeclaration = 
			thisModule.MakeAtomInternalPortDeclaration('output', Sequence{type}, Sequence{aidd});
		aepd_out:bip!AtomExportPortDeclaration = 
			thisModule.MakeAtomExportPortDeclaration('exported_output',Sequence{type},Sequence{aipd_out});
		
	}

	to 
		cst:bip!AtomType(
			name <- type + '_constant_t',
	        native <- false,
	        superTypes <- Sequence{},
	        castableTypes <- Sequence{},
	        exportedPortDeclarations <- Sequence{aepd_out},
	        exportedDataDeclarations <- Sequence{}, 
	        dataParameterDeclarations <- Sequence{}, --Sequence{thisModule.MakePortDataParameterDeclaration('data',type)},
	        internalPortDeclarations <- Sequence{aipd_out},
	        behavior <- thisModule.MakeConstantPetriNet(aipd_out),
	        internalDataDeclarations <- Sequence{aidd},
	        exportPortDeclarations <- Sequence{aepd_out}
		)
}


lazy rule MakeIntegerConstantDeclaration{
	from 
		int : Integer

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('int'),
		parameters <- Sequence{valued_expression},
		name <- 'core'
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)

}

lazy rule MakeFloatConstantDeclaration{
	from 
		float : Real

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('float'),
		parameters <- Sequence{valued_expression},
		name <- 'core'
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)

}

lazy rule MakeBoolegerConstantDeclaration{
	from 
		bool : Boolean

	to cst_component_decl: bip!ComponentDeclaration(
		type <- thisModule.MakeConstantAtomType('bool'),
		parameters <- Sequence{valued_expression},
		name <- 'core'
	),
	
	valued_expression: bip!DirectDataDeclarationReferenceExpression (
		--dataDeclaration <- OclUndefined -- TODO
	)

}

rule Program2BipPackage {
	from chipsprogram: chips!program
	
	using {

		data_types: Sequence(bip!DataType) = 
			Sequence{'int','float','bool'}->collect(t | thisModule.MakeChipsDataType(t))
			->union(Sequence{thisModule.MakeBackendDataType('bool')}); -- only needed to decide which fsm starts
		


		base_port_types: Sequence(bip!PortType) = 
			Sequence{Sequence{'int'},Sequence{'float'},Sequence{'bool'},Sequence{}}
				->collect( t | thisModule.MakePortType(t));



		all_chips_function_defs : Sequence(chips!function_definition) = 
			chipsprogram.preamble.definitions->select(d | d.oclIsKindOf(chips!function_definition));
		


		system_specific_input_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_inputs->collect(t | t.type)
				)
			);
		
		system_specific_output_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_outputs->collect(t | t.type)
				)
			);

		core_atom_types: Sequence(bip!AtomType) = all_chips_function_defs->collect(d |  thisModule.MakeCoreAtomType(d));

		all_monotype_buffer_atom_types : Sequence(bip!AtomType) =
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeMonotypeBufferType(t));
		
		constants_atom_types: Sequence(bip!AtomType) = 
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeConstantAtomType(t));


		functional_blocks_types: Sequence(bip!CompoundType) = 
			all_chips_function_defs
			->collect(d | thisModule.FunctionDefinition2CompoundType(d));
		
		functional_input_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeInputBufferType(d.all_inputs));
		
		functional_output_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeOutputBufferType(d.all_outputs));

		memory: Set(TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer))) = 
			chipsprogram.system.system_statements->iterate( 
				stt ; mem : Set(TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer))) = Set{}
				| stt.evaluate(mem)
			);--.debug('\n----------------------memory state------------------------\n');
		


		--- Currently here for the overall compilation

		-- all_compounds_decl: Bag(bip!ComponentDeclaration) = 
		-- 	memory
		-- 	->select( elem | elem.type.oclIsKindOf(chips!function_definition))
		-- 	->collect(elem | elem.intoCompoundDeclarations())
		-- 	->flatten();

		-- all_dataflows : Bag(OclAny) = --Bag(bip!ConnectorDeclaration) = 
		-- 	memory->select(elem | elem.type = 'int_connector')->debug('int_connectors memory');
		

		-- system_compoud: bip!CompoundType = thisModule.MakeSystemCompoundType(
		-- 	all_compounds_decl--,all_connectors
		-- );
		
	}
	to 
		bippackage: bip!BipPackage(
			name <- chipsprogram.fileName,
			atomTypes <- core_atom_types
				->union(all_monotype_buffer_atom_types)
				->union(constants_atom_types),
			compoundTypes <- functional_blocks_types
				->union(functional_input_buffer_types)
				->union(functional_output_buffer_types),
			-- 	->union(Sequence{system_compoud}),
			-- connectorTypes <- Sequence{},
			portTypes <- base_port_types
				->union(system_specific_input_port_types)
				->union(system_specific_output_port_types),
			dataTypes <- data_types
			-- used_packages <- Sequence{},
			-- constData <- Sequence{}, -- what for ? oh wait, yes
			-- prototypes <- Sequence{} -- for importing functions from cpp backend
		)
}



-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------
----------------MEMORY EVALUATION FOR INTERPRETATION OF CHIPS MODELS---------------------
-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------


-- Declaration of components in system context
----------------------------------------------

helper context chips!"chips::statements::system::physical_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

helper context chips!"chips::statements::system::logical_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

helper context chips!"chips::statements::system::object_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key = self.variable.name,
		value = self.variable.name,
		type =  self."def",
		dimensions = self.variable.dimensions->collect(e | e.evaluate(memory))
	});

-- Declarations of primitive variables in system context
--------------------------------------------------------

helper context chips!"chips::statements::system::int_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = 0,
			type='int',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);

helper context chips!"chips::statements::system::float_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = 0.0,
			type='float',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);

helper context chips!"chips::statements::system::bool_declaration" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(
		Tuple{
			key = self.variable.name,
			value = false,
			type='bool',
			dimensions=self.variable.dimensions->collect(e | e.evaluate(memory))
		}
	);


-- assignment of primitive variables in system context
--------------------------------------------------------

helper context chips!"chips::statements::system::int_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

helper context chips!"chips::statements::system::float_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

helper context chips!"chips::statements::system::bool_assignment" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let oldval : TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)) =  memory->any(e | e.key = self.lvalue.variable.name) in 
	memory->excluding(oldval)->including(
		Tuple{
			key = self.lvalue.variable.name,
			value = self.rvalue->evaluate(memory),
			type = oldval.type,
			dimensions = oldval.dimensions
		}
	);

-- linking instructions evaluation in system context
----------------------------------------------------

helper context chips!link def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory; -- currently doing nothing because not a priority to make models runnable

-- channel plugging evaluation in system context
------------------------------------------------

helper context chips!channel_plugging def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder,self.eater}, 
		type='channel_plug', 
		dimensions=Sequence{}
	});

-- Flow control structures interpretation in system section
-------------------------------------------

helper context chips!"chips::statements::system::foreach" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let iterable : Sequence(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = self.iterable_expr.evaluate(memory) in
	iterable->iterate(
		iterator ; 
		m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
		self.statements->iterate( 
			stt ; 
			m2: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) 
				= m1->including(Tuple{key=self.iterator.variable.name, value=iterator.value, type=iterator.type, dimensions=iterator.dimensions}) | 
			stt.evaluate(m2)
		)->reject(e | (e.key = self.iterator.variable.name) and (e.type = iterator.type))
	);


helper context chips!"chips::statements::system::if" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let condition : Boolean = self.condition.evaluate(memory) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	else
		memory
	endif;

helper context chips!"chips::statements::system::if_else" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	let condition : Boolean = self.condition.evaluate(memory) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	else
		self.else_section.else_statements->iterate(
			stt ;
			m1: Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = memory |
			stt.evaluate(m1)
		)
	endif;

-- feeding interpretation in system section
----------------------------------------------------

helper context chips!"chips::statements::system::feeding_physical_int" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='int_connector', 
		dimensions=Sequence{}
	});

helper context chips!"chips::statements::system::feeding_physical_float" def : evaluate(memory:Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer)))) : Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) = 
	memory->including(Tuple{
		key='from_'+self.feeder->getName(memory)+'_to_'+self.eater->getName(memory),
		value=Sequence{self.feeder->evaluate(memory),self.eater->evaluate(memory)}, 
		type='float_connector', 
		dimensions=Sequence{}
