#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

declare -A DESCRIPTIONS=(
    ["-h"]="Print this message."
    ["-i"]="Print information about this software."
    ["file"]="Source file to work with. Accepted formats are .chips, .chips.xmi or .bip.xmi."
    ["--chips-xmi"]="Stop the compilation after having generated the xmi serialized version of <file> chips model. Only works with .chips files."
    ["--bip-xmi"]="Stop the compilation after having generated the xmi serialized version of <file> equivalent bip model. Only works with .chips and .chips.xmi files."
    ["--cpp-only"]="Stop the compilation after having generated the c++ procedures relative to <file> components. Only works with .chips files."
    ["-o"]="The name of the folder in which to store the model elements generated. If no <folder> is specified, artifacts will be stored in CHIPS_GENERATED."
)

print_usage() {
    echo "Usage: $(basename "$0") [options] <file>"
    echo
    echo "Positional arguments:"
    printf "  %-15s %s\n" "file" "${DESCRIPTIONS["file"]}"
    echo
    echo "Options:"
    printf "  %-15s %s\n" "-h" "${DESCRIPTIONS["-h"]}"
    printf "  %-15s %s\n" "-i" "${DESCRIPTIONS["-i"]}"
    printf "  %-15s %s\n" "--chips-xmi" "${DESCRIPTIONS["--chips-xmi"]}"
    printf "  %-15s %s\n" "--bip-xmi" "${DESCRIPTIONS["--bip-xmi"]}"
    printf "  %-15s %s\n" "--cpp-only" "${DESCRIPTIONS["--cpp-only"]}"
    printf "  %-15s %s\n" "-o <folder>" "${DESCRIPTIONS["-o"]}"
}

print_info() {

    echo "  _                 _                          "
    echo " /  |_  o ._   _   /   _  ._ _  ._  o |  _  ._ "
    echo " \_ | | | |_) _>   \_ (_) | | | |_) | | (/_ |  "
    echo "          |                     |              "
    echo "v1.0.0 September 2026"
    echo "The command line interface for the interpretation of"
    echo "Distributed Cyber-Physical Systems specifications in"
    echo "the Chips language."
}


FILE=""
CHIPS_XMI=0
BIP_XMI=0
CPP_ONLY=0
OUTPUT_DIR=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --chips-xmi)
            CHIPS_XMI=1
            shift
            ;;
        --bip-xmi)
            BIP_XMI=1
            shift
            ;;
        --cpp-only)
            CPP_ONLY=1
            shift
            ;;
        -o)
            if [[ $# -lt 2 ]]; then
                echo "Error: -o requires a value." >&2
                print_usage
                exit 1
            fi
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -h)
            print_usage
            exit 0
            ;;
        -i)
            print_info
            exit 0
            ;;
        -*)
            echo "Error: unknown option '$1'." >&2
            print_usage
            exit 1
            ;;
        *)
            if [[ -n "$FILE" ]]; then
                echo "Error: unexpected extra positional argument '$1'." >&2
                print_usage
                exit 1
            fi
            FILE="$1"
            shift
            ;;
    esac
done

if [[ -z "$FILE" ]]; then
    echo "Error: missing required <file> argument." >&2
    print_usage
    exit 1
fi

case "$FILE" in
    *.chips.xmi)
        FORMAT="chips.xmi"
        ;;
    *.bip.xmi)
        FORMAT="bip.xmi"
        ;;
    *.chips)
        FORMAT="chips"
        ;;
    *)
        echo "Error: unrecognized file format for '$FILE'." >&2
        echo "Accepted formats are .chips, .chips.xmi or .bip.xmi." >&2
        exit 1
        ;;
esac


if [[ "$CHIPS_XMI" -eq 1 && "$FORMAT" != "chips" ]]; then
    echo "Error: --chips-xmi only works with .chips files." >&2
    exit 1
fi
 
if [[ "$BIP_XMI" -eq 1 && "$FORMAT" != "chips" && "$FORMAT" != "chips.xmi" ]]; then
    echo "Error: --bip-xmi only works with .chips and .chips.xmi files." >&2
    exit 1
fi
 
if [[ "$CPP_ONLY" -eq 1 && "$FORMAT" != "chips" ]]; then
    echo "Error: --cpp-only only works with .chips files." >&2
    exit 1
fi

if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="CHIPS_GENERATED"
fi
 
mkdir -p "$OUTPUT_DIR"


# ---------------------------------------------------------------------------
# Pipeline error handling
# ---------------------------------------------------------------------------
STEP_NAMES=()
STEP_DURATIONS=()

run_step() {
    local step_name="$1"
    local log_file="$2"
    shift 2

    echo
    echo "================================================================"
    echo "Running step: $step_name"
    echo "================================================================"
    echo
    echo "running : $@"
    # Run the command and capture stderr in the step-specific log file,
    # timing how long it takes.
    local start_time end_time elapsed
    start_time=$(date +%s.%N)

    set +e
    "$@" 2>"$log_file"
    local status=$?
    set -e

    end_time=$(date +%s.%N)
    elapsed=$(awk -v s="$start_time" -v e="$end_time" 'BEGIN { printf "%.3f", e - s }')

    if [[ $status -ne 0 ]]; then
        echo
        echo "PIPELINE FAILED"
        echo "Step: $step_name"
        echo "Exit code: $status"
        echo "Time elapsed: ${elapsed}s"
        echo "Log file: $log_file"
        echo

        if [[ -f "$log_file" ]]; then
            echo "-------------------- BEGIN LOG --------------------"
            cat "$log_file"
            echo "--------------------- END LOG ---------------------"
        else
            echo "WARNING: Log file '$log_file' does not exist."
        fi

        echo
        exit "$status"
    fi

    STEP_NAMES+=("$step_name")
    STEP_DURATIONS+=("$elapsed")

    echo "Step '$step_name' completed successfully in ${elapsed}s."
}

print_timing_summary() {
    if [[ "${#STEP_NAMES[@]}" -eq 0 ]]; then
        return
    fi

    echo
    echo "================================================================"
    echo "Timing summary"
    echo "================================================================"
    local total
    total=0
    for i in "${!STEP_NAMES[@]}"; do
        printf "  %-25s %ss\n" "${STEP_NAMES[$i]}" "${STEP_DURATIONS[$i]}"
        total=$(awk -v t="$total" -v d="${STEP_DURATIONS[$i]}" 'BEGIN { printf "%.3f", t + d }')
    done
    echo "----------------------------------------------------------------"
    printf "  %-25s %ss\n" "Total" "$total"
}

# ---------------------------------------------------------------------------
# Decide which steps to run
# ---------------------------------------------------------------------------
NO_FLAGS=0
if [[ "$CHIPS_XMI" -eq 0 && "$BIP_XMI" -eq 0 && "$CPP_ONLY" -eq 0 ]]; then
    NO_FLAGS=1
fi
 
DO_CHIPS_XMI=0
DO_BIP_XMI=0
DO_CPP=0
 
if [[ "$CHIPS_XMI" -eq 1 || ("$NO_FLAGS" -eq 1 && "$FORMAT" == "chips") ]]; then
    DO_CHIPS_XMI=1
fi
 
if [[ "$BIP_XMI" -eq 1 || ("$NO_FLAGS" -eq 1 && ("$FORMAT" == "chips" || "$FORMAT" == "chips.xmi")) ]]; then
    DO_BIP_XMI=1
fi
 
if [[ "$CPP_ONLY" -eq 1 || ("$NO_FLAGS" -eq 1 && "$FORMAT" == "chips") ]]; then
    DO_CPP=1
fi
 
# The bip-xmi step reads its input from "$OUTPUT_DIR"/out.chips.xmi, so if we
# start from a .chips file we must generate that intermediate file first,
# even if --chips-xmi was not explicitly requested.
if [[ "$DO_BIP_XMI" -eq 1 && "$FORMAT" == "chips" ]]; then
    DO_CHIPS_XMI=1
fi


# ---------------------------------------------------------------------------
# Run the steps
# ---------------------------------------------------------------------------

if [[ "$DO_CHIPS_XMI" -eq 1 ]]; then
    run_step \
        "CHIPS -> CHIPS XMI" \
        "$OUTPUT_DIR/ChipsXmiGeneratorDebug.log" \
        $SCRIPT_DIR/FullCompileChain/ChipsXmiGenerator/chipsparser \
        "$FILE" \
        "$OUTPUT_DIR/out.chips.xmi"
fi


if [[ "$DO_BIP_XMI" -eq 1 ]]; then
    if [[ "$FORMAT" == "chips.xmi" ]]; then
        BIP_XMI_INPUT="$FILE"
    else
        BIP_XMI_INPUT="$OUTPUT_DIR/out.chips.xmi"
    fi

    run_step \
        "CHIPS XMI -> BIP XMI" \
        "$OUTPUT_DIR/BipXmiGeneratorDebug.log" \
        $SCRIPT_DIR/FullCompileChain/BipXmiGenerator/emftvm.sh \
        $SCRIPT_DIR/FullCompileChain/BipXmiGenerator/metamodels/chips1.1.ecore \
        $SCRIPT_DIR/FullCompileChain/BipXmiGenerator/metamodels/BIP.ecore \
        "$BIP_XMI_INPUT" \
        $SCRIPT_DIR/FullCompileChain/BipXmiGenerator/transformations/chips2bip.atl \
        "$OUTPUT_DIR/out.bip.xmi"
fi


if [[ "$DO_CPP" -eq 1 ]]; then
    run_step \
        "CHIPS -> C++" \
        "$OUTPUT_DIR/CppGeneratorDebug.log" \
        $SCRIPT_DIR/FullCompileChain/CppGenerator/build/Chips2Cpp \
        -o "$OUTPUT_DIR/out.cpp" \
        "$FILE"
fi

print_timing_summary