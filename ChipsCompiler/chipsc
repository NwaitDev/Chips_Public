#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CHIPSC_LIB="$SCRIPT_DIR/chipsc_lib"

for module in config cli sources runner report probes stages; do
    source "$CHIPSC_LIB/$module.sh"
done

parse_args "$@"
validate_args
resolve_includes

OUTPUT_DIR="${OUTPUT_DIR:-$DEFAULT_OUTPUT_DIR}"
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR="$(cd -- "$OUTPUT_DIR" && pwd)"
FILE="$(absolute_path "$FILE")"

merge_sources

if [[ "$FORMAT" == "csv" ]]; then
    process_probes "$FILE"
else
    run_pipeline
fi

print_report
