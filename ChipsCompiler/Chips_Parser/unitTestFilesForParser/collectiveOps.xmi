    xmlns:chips.xvalues.collective="http://chips/xvalues/collective"
    xmlns:chips.xvalues.primitive="http://chips/xvalues/primitive"
    xmlns:chips.xvalues.system="http://chips/xvalues/system"
    xmlns:definitions="http://chips/definitions"
    xsi:schemaLocation="http://chips chips2.ecore
                        http://chips/outputs/logical chips2.ecore#//outputs/logical
                        http://chips/parameters/collective chips2.ecore#//parameters/collective
                        http://chips/parameters/logical chips2.ecore#//parameters/logical
                        http://chips/rvalues/collective chips2.ecore#//rvalues/collective
                        http://chips/rvalues/collective/operators/bool chips2.ecore#//rvalues/collective/operators/bool
                        http://chips/rvalues/collective/operators/int chips2.ecore#//rvalues/collective/operators/int
                        http://chips/rvalues/dataflow/operators/bool chips2.ecore#//rvalues/system/operators/bool
                        http://chips/rvalues/dataflow/operators/int chips2.ecore#//rvalues/system/operators/int
                        http://chips/rvalues/primitive chips2.ecore#//rvalues/primitive
                        http://chips/rvalues/primitive/operators/int chips2.ecore#//rvalues/primitive/operators/int
                        http://chips/rvalues/system chips2.ecore#//rvalues/system
                        http://chips/statements/collective chips2.ecore#//statements/collective
                        http://chips/statements/node chips2.ecore#//statements/node
                        http://chips/statements/primitive chips2.ecore#//statements/primitive
