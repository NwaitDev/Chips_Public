    xmlns:chips.rvalues.dataflow.operators.bool="http://chips/rvalues/dataflow/operators/bool"
    xmlns:chips.rvalues.dataflow.operators.int="http://chips/rvalues/dataflow/operators/int"
    xmlns:chips.rvalues.primitive="http://chips/rvalues/primitive"
