logical KalmanFilter(float targetValues, float currentOutput, float currentState ,int nStates, int nInputs, int nOutput, float F, float B, float H, float Q, float R) init {

    
    int _n = nStates;
    int _m = nOutputs;
    int _c = nInputs;

    // Matrices du système
    float[_n * _n] _F = (float)identity(_n);
    float[_n * _c] _B = (float)zeros(_n * _c);
    float[_m * _n] _H = (float)zeros(_m * _n);
    float[_n * _n] _Q = (float)identity(_n);
    float[_m * _m] _R = (float)identity(_m);

    // Etat interne
    float[_n * _n] _P = (float)identity(_n);
    float[_n] _x = (float)zeros(_n);
    float[_n * _m] _K = (float)zeros(_n * _m);

    // Valeurs initiales (pour reset)
    float[_n * _n] _P0 = _P;
    float[_n] _x0 = _x;

    //Buffers
    float[_n] _x_vec = (float)zeros(_n);
    float[_c] _u_vec = (float)zeros(_c);
    float[_m] _z_vec = (float)zeros(_m)
    float[_n] _ctrl_vec = (float)zeros(_n)

    float[] uncertainy = zeros()

}then{

    float[_c] u = _u_vec;
    float[_m] z = _z_vec;

    float[_n * _n] Ft = transpose(_F, _n, _n);
    float[_m * _n] Ht = transpose(_H, _m, _n);

    // Etape 1 : Prédiction
    float[_n, _n] Fx = _F * _x;
    float[_c * _c] Bu = _B * u;
    float[_n * _n] x_prior = Fx + Bu;

    float[_n * _n] FP = _F * _P;
    float[_n * _n] P_prior = FP * Ft + _Q;

    // Etape 2 : Gain de Kalman
    float[_n * _n] HP_prior = H * P_prior;
    float[_n * _n] HPHt = HP_prior * Ht;
    float[_n * _n] S = HPHt + _R;

    float[_n * _n] P_Ht = P_prior * Ht;
    _K = P_Ht * inv(S);

    // Etape 3 : Mise à jour de l'état
    float[_n * _n] Hx_prior = _H * x_prior;
    float[_n * _n] innovation = z - Hx_prior; 

    _x = x_prior + _K * innovation;

    // Etape 4 : Mise à jour de P (formule de Joseph)
    float[_m * _m] KH = _K * _H;
    float[_m * _m] I_KH = identity(_n) - KH;

    float[_n * _n] I_KHt = transpose(I_KH);
    float[_n * _n] I_KHP_prior = I_KH * P_prior;
    float[_n * _m] Kt = transpose(_K);
    float[_m * _m] KR = _K * _R;

    _P = I_KHP_prior * I_KHt + KR * Kt;

    for i in range(_n){
        _x_vec[i] = _x[i];
        _ctrl_vec[i] = _x[i];
    } 

    for i in range(_n){
        uncertainy[i] = sqrt(_P[i * _n + i]);
    }

} -> getControl(_ctrl_vec)
-> getKalmanGain(_K)
-> getCovariance(_P)
-> getUncertainy(uncertainy)