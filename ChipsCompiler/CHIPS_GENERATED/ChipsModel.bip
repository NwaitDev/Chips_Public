    connector type allDataProvidersOutputs_among_Backend_conn_t (AggrAnswers_t_int_port_t p_next_cppd, AggrAnswers_t_int_port_t p_prev_cppd, int_port_t p_input_cppd)
        data chips_int channel_indicator
        data AggrAnswers_t _accumulator
        data chips_int target_data
        export port AggrAnswers_t_intint_port_t up_accumulator(_accumulator, channel_indicator, target_data)
        define (p_next_cppd
         p_prev_cppd
         p_input_cppd
        )
    
        on p_next_cppd p_prev_cppd p_input_cppd
            up {
                allDataProvidersOutputs(channel_indicator, _accumulator, p_next_cppd.v0, p_prev_cppd.v0, p_input_cppd.v0, target_data);
