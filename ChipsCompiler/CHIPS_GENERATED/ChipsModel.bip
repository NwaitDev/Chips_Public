@cpp(include="bip_importable.hpp", src="bip_importable.cpp")
package ChipsModel



    
    extern data type chips_int
    
    extern data type chips_float
    
    extern data type chips_bool

    
    extern function chips_int create_chips_int(const int native_int_rvalue)
    
    extern function chips_float create_chips_float(const float native_float_rvalue)
    
    extern function chips_bool create_chips_bool(const bool native_bool_rvalue)
    
    extern function int chips_max_ticks()
    
    extern function then_Drone(chips_float dt, chips_float u, chips_float DRAG_COEFF, chips_float GRAVITY, chips_float KP, chips_float altitude, chips_float altitude_max, chips_float m, chips_float prevError, chips_float velocity, chips_float update)
    
    extern function init_Drone(chips_float dt, chips_float u, chips_float DRAG_COEFF, chips_float GRAVITY, chips_float KP, chips_float altitude, chips_float altitude_max, chips_float m, chips_float prevError, chips_float velocity, chips_float update)
    
    extern function then_PID(chips_float current, chips_float dt, chips_float kw_target, chips_float derivative, chips_float integral, chips_float kd, chips_float ki, chips_float kp, chips_float maxOutput, chips_float minOutput, chips_float prevError, chips_float proportional, chips_float correction)
    
    extern function init_PID(chips_float current, chips_float dt, chips_float kw_target, chips_float derivative, chips_float integral, chips_float kd, chips_float ki, chips_float kp, chips_float maxOutput, chips_float minOutput, chips_float prevError, chips_float proportional, chips_float correction)



    
    port type int_port_t (chips_int v0)
    
    port type float_port_t (chips_float v0)
    
    port type bool_port_t (chips_bool v0)
    
    port type port_t ()
    
    port type floatfloat_port_t (chips_float v0, chips_float v1)
    
    port type floatfloatfloat_port_t (chips_float v0, chips_float v1, chips_float v2)

    
    connector type many2one_floatfloat_t (float_port_t p0_cppd, float_port_t p1_cppd)
        data chips_float v0
        data chips_float v1
        export port floatfloat_port_t r_exported_port(v0, v1)
        define (p0_cppd
         p1_cppd
        )
    
        on p0_cppd p1_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
                v1 = p1_cppd.v0;
            }
    end

    
    connector type one2many_float_t (float_port_t p0_cppd)
        data chips_float v0
        export port float_port_t s_exported_port(v0)
        define (p0_cppd
        )
    
        on p0_cppd
            provided (true)
            down {
                p0_cppd.v0 = v0;
            }
    end

    
    connector type flow_floatfloat_t (floatfloat_port_t s, floatfloat_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
                r.v1 = s.v1;
            }
    end

    
    connector type flow_float_t (float_port_t s, float_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type many2one_floatfloatfloat_t (float_port_t p0_cppd, float_port_t p1_cppd, float_port_t p2_cppd)
        data chips_float v0
        data chips_float v1
        data chips_float v2
        export port floatfloatfloat_port_t r_exported_port(v0, v1, v2)
        define (p0_cppd
         p1_cppd
         p2_cppd
        )
    
        on p0_cppd p1_cppd p2_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
                v1 = p1_cppd.v0;
                v2 = p2_cppd.v0;
            }
    end

    
    connector type flow_floatfloatfloat_t (floatfloatfloat_port_t s, floatfloatfloat_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
                r.v1 = s.v1;
                r.v2 = s.v2;
            }
    end

    
    connector type flow_int_t (int_port_t s, int_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type flow_bool_t (bool_port_t s, bool_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    atom type Drone_core (const bool starts_Drone)
    
        
        data chips_float dt_aidd_input
        
        data chips_float u_aidd_input
        
        data chips_float DRAG_COEFF_aidd_inner
        
        data chips_float GRAVITY_aidd_inner
        
        data chips_float KP_aidd_inner
        
        data chips_float altitude_aidd_inner
        
        data chips_float altitude_max_aidd_inner
        
        data chips_float m_aidd_inner
        
        data chips_float prevError_aidd_inner
        
        data chips_float velocity_aidd_inner
        
        data chips_float update_aidd_output
        
        data int ticks
        
        
        export port float_port_t Drone_send_portdecl(update_aidd_output)
        
        export port floatfloat_port_t Drone_recv_portdecl(dt_aidd_input, u_aidd_input)
        
        port port_t starts_Drone_portdecl()
        
        port port_t then_Drone_portdecl()
        
        place INIT, RECEIVE, THEN, SEND, DONE
        initial to INIT
            do {
                ticks = 0;
                dt_aidd_input = create_chips_float(1.0);
                u_aidd_input = create_chips_float(1.0);
                DRAG_COEFF_aidd_inner = create_chips_float(1.0);
                GRAVITY_aidd_inner = create_chips_float(1.0);
                KP_aidd_inner = create_chips_float(1.0);
                altitude_aidd_inner = create_chips_float(1.0);
                altitude_max_aidd_inner = create_chips_float(1.0);
                m_aidd_inner = create_chips_float(1.0);
                prevError_aidd_inner = create_chips_float(1.0);
                velocity_aidd_inner = create_chips_float(1.0);
                update_aidd_output = create_chips_float(1.0);
                init_Drone(dt_aidd_input, u_aidd_input, DRAG_COEFF_aidd_inner, GRAVITY_aidd_inner, KP_aidd_inner, altitude_aidd_inner, altitude_max_aidd_inner, m_aidd_inner, prevError_aidd_inner, velocity_aidd_inner, update_aidd_output);
            }
            
            on starts_Drone_portdecl
                from INIT
                to RECEIVE
                provided (! starts_Drone)
            
            on starts_Drone_portdecl
                from INIT
                to SEND
                provided (starts_Drone)
            
            on Drone_recv_portdecl
                from RECEIVE
                to THEN
                provided (true)
            
            on then_Drone_portdecl
                from THEN
                to SEND
                provided ((ticks  <  chips_max_ticks()))
                do {
                        then_Drone(dt_aidd_input, u_aidd_input, DRAG_COEFF_aidd_inner, GRAVITY_aidd_inner, KP_aidd_inner, altitude_aidd_inner, altitude_max_aidd_inner, m_aidd_inner, prevError_aidd_inner, velocity_aidd_inner, update_aidd_output);
                        ticks = (ticks  +  1);
                }
            
            on Drone_send_portdecl
                from SEND
                to RECEIVE
                provided (true)
            
            on then_Drone_portdecl
                from THEN
                to DONE
                provided ((ticks  >=  chips_max_ticks()))
    
    
    end

    
    atom type PID_core (const bool starts_PID)
    
        
        data chips_float current_aidd_input
        
        data chips_float dt_aidd_input
        
        data chips_float kw_target_aidd_input
        
        data chips_float derivative_aidd_inner
        
        data chips_float integral_aidd_inner
        
        data chips_float kd_aidd_inner
        
        data chips_float ki_aidd_inner
        
        data chips_float kp_aidd_inner
        
        data chips_float maxOutput_aidd_inner
        
        data chips_float minOutput_aidd_inner
        
        data chips_float prevError_aidd_inner
        
        data chips_float proportional_aidd_inner
        
        data chips_float correction_aidd_output
        
        data int ticks
        
        
        export port float_port_t PID_send_portdecl(correction_aidd_output)
        
        export port floatfloatfloat_port_t PID_recv_portdecl(current_aidd_input, dt_aidd_input, kw_target_aidd_input)
        
        port port_t starts_PID_portdecl()
        
        port port_t then_PID_portdecl()
        
        place INIT, RECEIVE, THEN, SEND, DONE
        initial to INIT
            do {
                ticks = 0;
                current_aidd_input = create_chips_float(1.0);
                dt_aidd_input = create_chips_float(1.0);
                kw_target_aidd_input = create_chips_float(1.0);
                derivative_aidd_inner = create_chips_float(1.0);
                integral_aidd_inner = create_chips_float(1.0);
                kd_aidd_inner = create_chips_float(1.0);
                ki_aidd_inner = create_chips_float(1.0);
                kp_aidd_inner = create_chips_float(1.0);
                maxOutput_aidd_inner = create_chips_float(1.0);
                minOutput_aidd_inner = create_chips_float(1.0);
                prevError_aidd_inner = create_chips_float(1.0);
                proportional_aidd_inner = create_chips_float(1.0);
                correction_aidd_output = create_chips_float(1.0);
                init_PID(current_aidd_input, dt_aidd_input, kw_target_aidd_input, derivative_aidd_inner, integral_aidd_inner, kd_aidd_inner, ki_aidd_inner, kp_aidd_inner, maxOutput_aidd_inner, minOutput_aidd_inner, prevError_aidd_inner, proportional_aidd_inner, correction_aidd_output);
            }
            
            on starts_PID_portdecl
                from INIT
                to RECEIVE
                provided (! starts_PID)
            
            on starts_PID_portdecl
                from INIT
                to SEND
                provided (starts_PID)
            
            on PID_recv_portdecl
                from RECEIVE
                to THEN
                provided (true)
            
            on then_PID_portdecl
                from THEN
                to SEND
                provided ((ticks  <  chips_max_ticks()))
                do {
                        then_PID(current_aidd_input, dt_aidd_input, kw_target_aidd_input, derivative_aidd_inner, integral_aidd_inner, kd_aidd_inner, ki_aidd_inner, kp_aidd_inner, maxOutput_aidd_inner, minOutput_aidd_inner, prevError_aidd_inner, proportional_aidd_inner, correction_aidd_output);
                        ticks = (ticks  +  1);
                }
            
            on PID_send_portdecl
                from SEND
                to RECEIVE
                provided (true)
            
            on then_PID_portdecl
                from THEN
                to DONE
                provided ((ticks  >=  chips_max_ticks()))
    
    
    end

    
    atom type int_buffer_t ()
    
        
        data chips_int int_monotype_buffer_data
        
        
        export port int_port_t int_in(int_monotype_buffer_data)
        
        export port int_port_t int_out(int_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                int_monotype_buffer_data = create_chips_int(1);
            }
            
            on int_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on int_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type float_buffer_t ()
    
        
        data chips_float float_monotype_buffer_data
        
        
        export port float_port_t float_in(float_monotype_buffer_data)
        
        export port float_port_t float_out(float_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                float_monotype_buffer_data = create_chips_float(1.0);
            }
            
            on float_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on float_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type bool_buffer_t ()
    
        
        data chips_bool bool_monotype_buffer_data
        
        
        export port bool_port_t bool_in(bool_monotype_buffer_data)
        
        export port bool_port_t bool_out(bool_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                bool_monotype_buffer_data = create_chips_bool(true);
            }
            
            on bool_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on bool_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type int_constant_t (const int val)
    
        
        data chips_int int_value_aidd
        
        
        export port int_port_t int_output_portdecl(int_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                int_value_aidd = create_chips_int(val);
            }
            
            on int_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    atom type float_constant_t (const float val)
    
        
        data chips_float float_value_aidd
        
        
        export port float_port_t float_output_portdecl(float_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                float_value_aidd = create_chips_float(val);
            }
            
            on float_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    atom type bool_constant_t (const bool val)
    
        
        data chips_bool bool_value_aidd
        
        
        export port bool_port_t bool_output_portdecl(bool_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                bool_value_aidd = create_chips_bool(val);
            }
            
            on bool_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    compound type floatfloat_input_buffer_t ()
    
        component float_buffer_t float0_bd ()
        component float_buffer_t float1_bd ()
    
        connector many2one_floatfloat_t floatfloat_input_connector (float0_bd.float_out, float1_bd.float_out)
    
        export port float0_bd.float_in as float0_input_cepd_cepd
        export port float1_bd.float_in as float1_input_cepd_cepd
        export port floatfloat_input_connector.r_exported_port as one_cepd
    
    end

    
    compound type float_output_buffer_t ()
    
        component float_buffer_t float0_bd ()
    
        connector one2many_float_t float_output_connector (float0_bd.float_in)
    
        export port float0_bd.float_out as float0_output_cepd_cepd
        export port float_output_connector.s_exported_port as one_cepd
    
    end

    
    compound type Drone_compoundtype (const bool starts_param_of_Drone)
    
        component Drone_core core (starts_param_of_Drone)
        component floatfloat_input_buffer_t Drone_input_buffer_buffer_compounddecl ()
        component float_output_buffer_t Drone_output_buffer_buffer_compounddecl ()
    
        connector flow_floatfloat_t input_to_core_cd (Drone_input_buffer_buffer_compounddecl.one_cepd, core.Drone_recv_portdecl)
        connector flow_float_t core_to_output_cd (core.Drone_send_portdecl, Drone_output_buffer_buffer_compounddecl.one_cepd)
    
        export port Drone_input_buffer_buffer_compounddecl.float0_input_cepd_cepd as dt_input_cepd
        export port Drone_input_buffer_buffer_compounddecl.float1_input_cepd_cepd as u_input_cepd
        export port Drone_output_buffer_buffer_compounddecl.float0_output_cepd_cepd as update_output_cepd
    
    end

    
    compound type floatfloatfloat_input_buffer_t ()
    
        component float_buffer_t float0_bd ()
        component float_buffer_t float1_bd ()
        component float_buffer_t float2_bd ()
    
        connector many2one_floatfloatfloat_t floatfloatfloat_input_connector (float0_bd.float_out, float1_bd.float_out, float2_bd.float_out)
    
        export port float0_bd.float_in as float0_input_cepd_cepd
        export port float1_bd.float_in as float1_input_cepd_cepd
        export port float2_bd.float_in as float2_input_cepd_cepd
        export port floatfloatfloat_input_connector.r_exported_port as one_cepd
    
    end

    
    compound type PID_compoundtype (const bool starts_param_of_PID)
    
        component PID_core core (starts_param_of_PID)
        component floatfloatfloat_input_buffer_t PID_input_buffer_buffer_compounddecl ()
        component float_output_buffer_t PID_output_buffer_buffer_compounddecl ()
    
        connector flow_floatfloatfloat_t input_to_core_cd (PID_input_buffer_buffer_compounddecl.one_cepd, core.PID_recv_portdecl)
        connector flow_float_t core_to_output_cd (core.PID_send_portdecl, PID_output_buffer_buffer_compounddecl.one_cepd)
    
        export port PID_input_buffer_buffer_compounddecl.float1_input_cepd_cepd as dt_input_cepd
        export port PID_input_buffer_buffer_compounddecl.float2_input_cepd_cepd as kw_target_input_cepd
        export port PID_input_buffer_buffer_compounddecl.float0_input_cepd_cepd as current_input_cepd
        export port PID_output_buffer_buffer_compounddecl.float0_output_cepd_cepd as correction_output_cepd
    
    end

    
    compound type SYSTEM_COMPOUND ()
    
        component float_constant_t cst3 (0.1)
        component float_constant_t cst2 (5.0)
        component PID_compoundtype ctrl_1_compounddecl (false)
        component Drone_compoundtype drone_1_compounddecl (true)
        component float_constant_t cst1 (0.1)
    
        connector flow_float_t from_direct_expression1_to_ctrl_0_dt_cd (cst1.float_output_portdecl, ctrl_1_compounddecl.dt_input_cepd)
        connector flow_float_t from_direct_expression2_to_ctrl_0_kw_target_cd (cst2.float_output_portdecl, ctrl_1_compounddecl.kw_target_input_cepd)
        connector flow_float_t from_drone_0_update_to_ctrl_0_current_cd (drone_1_compounddecl.update_output_cepd, ctrl_1_compounddecl.current_input_cepd)
        connector flow_float_t from_ctrl_0_correction_to_drone_0_u_cd (ctrl_1_compounddecl.correction_output_cepd, drone_1_compounddecl.u_input_cepd)
        connector flow_float_t from_direct_expression3_to_drone_0_dt_cd (cst3.float_output_portdecl, drone_1_compounddecl.dt_input_cepd)
    
    end
end
