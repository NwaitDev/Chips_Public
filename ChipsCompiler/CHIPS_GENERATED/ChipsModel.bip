@cpp(include="bip_importable.hpp", src="bip_importable.cpp")
package ChipsModel



    
    extern data type chips_int
    
    extern data type chips_float
    
    extern data type chips_bool

    
    extern function chips_int create_chips_int(const int native_int_rvalue)
    
    extern function chips_float create_chips_float(const float native_float_rvalue)
    
    extern function chips_bool create_chips_bool(const bool native_bool_rvalue)
    
    extern function int chips_max_ticks()
    
    extern function then_addi(chips_int a, chips_int b, chips_int ticks, chips_int out)
    
    extern function init_addi(chips_int a, chips_int b, chips_int ticks, chips_int out)
    
    extern function then_consumer(chips_int kw_data)
    
    extern function init_consumer(chips_int kw_data)



    
    port type int_port_t (chips_int v0)
    
    port type float_port_t (chips_float v0)
    
    port type bool_port_t (chips_bool v0)
    
    port type port_t ()
    
    port type intint_port_t (chips_int v0, chips_int v1)

    
    connector type many2one_intint_t (int_port_t p0_cppd, int_port_t p1_cppd)
        data chips_int v0
        data chips_int v1
        export port intint_port_t r_exported_port(v0, v1)
        define (p0_cppd
         p1_cppd
        )
    
        on p0_cppd p1_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
                v1 = p1_cppd.v0;
            }
    end

    
    connector type one2many_int_t (int_port_t p0_cppd)
        data chips_int v0
        export port int_port_t s_exported_port(v0)
        define (p0_cppd
        )
    
        on p0_cppd
            provided (true)
            down {
                p0_cppd.v0 = v0;
            }
    end

    
    connector type flow_intint_t (intint_port_t s, intint_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
                r.v1 = s.v1;
            }
    end

    
    connector type flow_int_t (int_port_t s, int_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type many2one_int_t (int_port_t p0_cppd)
        data chips_int v0
        export port int_port_t r_exported_port(v0)
        define (p0_cppd
        )
    
        on p0_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
            }
    end

    
    connector type flow_float_t (float_port_t s, float_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type flow_bool_t (bool_port_t s, bool_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    atom type addi_core (const bool starts_addi)
    
        
        data chips_int a_aidd_input
        
        data chips_int b_aidd_input
        
        data chips_int ticks_aidd_inner
        
        data chips_int out_aidd_output
        
        data int ticks
        
        
        export port int_port_t addi_send_portdecl(out_aidd_output)
        
        export port intint_port_t addi_recv_portdecl(a_aidd_input, b_aidd_input)
        
        port port_t starts_addi_portdecl()
        
        port port_t then_addi_portdecl()
        
        place INIT, RECEIVE, THEN, SEND, DONE
        initial to INIT
            do {
                ticks = 0;
                a_aidd_input = create_chips_int(1);
                b_aidd_input = create_chips_int(1);
                ticks_aidd_inner = create_chips_int(1);
                out_aidd_output = create_chips_int(1);
                init_addi(a_aidd_input, b_aidd_input, ticks_aidd_inner, out_aidd_output);
            }
            
            on starts_addi_portdecl
                from INIT
                to RECEIVE
                provided (! starts_addi)
            
            on starts_addi_portdecl
                from INIT
                to SEND
                provided (starts_addi)
            
            on addi_recv_portdecl
                from RECEIVE
                to THEN
                provided (true)
            
            on then_addi_portdecl
                from THEN
                to SEND
                provided ((ticks  <  chips_max_ticks()))
                do {
                        then_addi(a_aidd_input, b_aidd_input, ticks_aidd_inner, out_aidd_output);
                        ticks = (ticks  +  1);
                }
            
            on addi_send_portdecl
                from SEND
                to RECEIVE
                provided (true)
            
            on then_addi_portdecl
                from THEN
                to DONE
                provided ((ticks  >=  chips_max_ticks()))
    
    
    end

    
    atom type consumer_core (const bool starts_consumer)
    
        
        data chips_int kw_data_aidd_input
        
        data int ticks
        
        
        export port int_port_t consumer_recv_portdecl(kw_data_aidd_input)
        
        port port_t starts_consumer_portdecl()
        
        port port_t then_consumer_portdecl()
        
        place INIT, RECEIVE, THEN, DONE
        initial to INIT
            do {
                ticks = 0;
                kw_data_aidd_input = create_chips_int(1);
                init_consumer(kw_data_aidd_input);
            }
            
            on starts_consumer_portdecl
                from INIT
                to RECEIVE
                provided (true)
            
            on consumer_recv_portdecl
                from RECEIVE
                to THEN
                provided (true)
            
            on then_consumer_portdecl
                from THEN
                to RECEIVE
                provided ((ticks  <  chips_max_ticks()))
                do {
                        then_consumer(kw_data_aidd_input);
                        ticks = (ticks  +  1);
                }
            
            on then_consumer_portdecl
                from THEN
                to DONE
                provided ((ticks  >=  chips_max_ticks()))
    
    
    end

    
    atom type int_buffer_t ()
    
        
        data chips_int int_monotype_buffer_data
        
        
        export port int_port_t int_in(int_monotype_buffer_data)
        
        export port int_port_t int_out(int_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                int_monotype_buffer_data = create_chips_int(1);
            }
            
            on int_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on int_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type float_buffer_t ()
    
        
        data chips_float float_monotype_buffer_data
        
        
        export port float_port_t float_in(float_monotype_buffer_data)
        
        export port float_port_t float_out(float_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                float_monotype_buffer_data = create_chips_float(1.0);
            }
            
            on float_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on float_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type bool_buffer_t ()
    
        
        data chips_bool bool_monotype_buffer_data
        
        
        export port bool_port_t bool_in(bool_monotype_buffer_data)
        
        export port bool_port_t bool_out(bool_monotype_buffer_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            do {
                bool_monotype_buffer_data = create_chips_bool(true);
            }
            
            on bool_out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on bool_in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
    atom type int_constant_t (const int val)
    
        
        data chips_int int_value_aidd
        
        
        export port int_port_t int_output_portdecl(int_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                int_value_aidd = create_chips_int(val);
            }
            
            on int_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    atom type float_constant_t (const float val)
    
        
        data chips_float float_value_aidd
        
        
        export port float_port_t float_output_portdecl(float_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                float_value_aidd = create_chips_float(val);
            }
            
            on float_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    atom type bool_constant_t (const bool val)
    
        
        data chips_bool bool_value_aidd
        
        
        export port bool_port_t bool_output_portdecl(bool_value_aidd)
        
        place DATA_SENDING
        initial to DATA_SENDING
            do {
                bool_value_aidd = create_chips_bool(val);
            }
            
            on bool_output_portdecl
                from DATA_SENDING
                to DATA_SENDING
    
    
    end

    
    compound type intint_input_buffer_t ()
    
        component int_buffer_t int0_bd ()
        component int_buffer_t int1_bd ()
    
        connector many2one_intint_t intint_input_connector (int0_bd.int_out, int1_bd.int_out)
    
        export port int0_bd.int_in as int0_input_cepd_cepd
        export port int1_bd.int_in as int1_input_cepd_cepd
        export port intint_input_connector.r_exported_port as one_cepd
    
    end

    
    compound type int_output_buffer_t ()
    
        component int_buffer_t int0_bd ()
    
        connector one2many_int_t int_output_connector (int0_bd.int_in)
    
        export port int0_bd.int_out as int0_output_cepd_cepd
        export port int_output_connector.s_exported_port as one_cepd
    
    end

    
    compound type addi_compoundtype (const bool starts_param_of_addi)
    
        component addi_core core (starts_param_of_addi)
        component intint_input_buffer_t addi_input_buffer_buffer_compounddecl ()
        component int_output_buffer_t addi_output_buffer_buffer_compounddecl ()
    
        connector flow_intint_t input_to_core_cd (addi_input_buffer_buffer_compounddecl.one_cepd, core.addi_recv_portdecl)
        connector flow_int_t core_to_output_cd (core.addi_send_portdecl, addi_output_buffer_buffer_compounddecl.one_cepd)
    
        export port addi_input_buffer_buffer_compounddecl.int0_input_cepd_cepd as a_input_cepd
        export port addi_input_buffer_buffer_compounddecl.int1_input_cepd_cepd as b_input_cepd
        export port addi_output_buffer_buffer_compounddecl.int0_output_cepd_cepd as out_output_cepd
    
    end

    
    compound type int_input_buffer_t ()
    
        component int_buffer_t int0_bd ()
    
        connector many2one_int_t int_input_connector (int0_bd.int_out)
    
        export port int0_bd.int_in as int0_input_cepd_cepd
        export port int_input_connector.r_exported_port as one_cepd
    
    end

    
    compound type consumer_compoundtype (const bool starts_param_of_consumer)
    
        component consumer_core core (starts_param_of_consumer)
        component int_input_buffer_t consumer_input_buffer_buffer_compounddecl ()
    
        connector flow_int_t input_to_core_cd (consumer_input_buffer_buffer_compounddecl.one_cepd, core.consumer_recv_portdecl)
    
        export port consumer_input_buffer_buffer_compounddecl.int0_input_cepd_cepd as kw_data_input_cepd
    
    end

    
    compound type SYSTEM_COMPOUND ()
    
        component addi_compoundtype helloworld_1_compounddecl (false)
        component int_constant_t cst2 (2)
        component int_constant_t cst1 (40)
        component consumer_compoundtype goodbyeworld_1_compounddecl (false)
    
        connector flow_int_t from_helloworld_0_out_to_goodbyeworld_0_kw_data_cd (helloworld_1_compounddecl.out_output_cepd, goodbyeworld_1_compounddecl.kw_data_input_cepd)
        connector flow_int_t from_direct_expression1_to_helloworld_0_a_cd (cst1.int_output_portdecl, helloworld_1_compounddecl.a_input_cepd)
        connector flow_int_t from_direct_expression2_to_helloworld_0_b_cd (cst2.int_output_portdecl, helloworld_1_compounddecl.b_input_cepd)
    
    end
end
