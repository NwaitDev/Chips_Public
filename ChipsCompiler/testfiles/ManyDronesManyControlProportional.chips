logical Trajectory() init{
    int ticks = 0;
    float setup_altitude = 5.;
    int setup_time = 3000;
    float required_altitude;
} then {
    if(ticks < setup_time){
        required_altitude = setup_altitude;
    } else {
        if (ticks < 6000) {
            required_altitude = required_altitude + 0.001;
        }else{
            if (ticks > 8000){
                required_altitude = required_altitude - 0.003;
            }
        }
    }
    ticks = ticks +1;
    probe(required_altitude);
} ->command(required_altitude)

// Defaults of this model :
// - Drag is ignored (it should actually be quadratic in the velocity)
// - Thurst is actually quadratic in the rotor speed
physical Drone(float u = 0., float dt = 0., float windz = 0.)
with {
    Chan previous;
    Chan next;
} init {
    float m = 0.2;
    float GRAVITY = 9.81;
    float K_T = .0000008;
    float altitude = 0.;
    float velocity = 0.;
    float HOVER_RPS = fsqrt((m*GRAVITY)/K_T);
    float DRAG_COEF = 0.0147;
}then{
    float thurst = K_T * HOVER_RPS * (2. * u-HOVER_RPS);
    if (thurst < 0.) { thurst = 0.; }
    float drag_dir = 1.;
    if(velocity>0.){ drag_dir = -1.; }
    float drag = DRAG_COEF * velocity * velocity * drag_dir;
    float Fp = windz + thurst + drag;
    float a = (Fp / m) - GRAVITY;
    velocity = velocity + a * dt;
    altitude = altitude + velocity * dt;
    if(altitude < 0.){
        altitude = 0.;
        velocity = 0.;
    }
    probe(altitude);
} -> alt_out(altitude)

logical Wind()
init {
    float wind_power = 0.;
    float max_windpower = 1.;
    float max_wind_change = .2;
} then {
    wind_power = wind_power + ((randin01()-0.5)*max_wind_change);
    if(wind_power > max_windpower){
        wind_power = max_windpower;
    }
    if(wind_power< -max_windpower) {
        wind_power = -max_windpower;
    }
}
-> pow(wind_power)

spread (float target = input) formation among Drone {} 
-> @(target)
-> previous(target+0.4)
-> next(target-0.4)

spread (float wind_power = input ) windspread among Drone {
    float max_windpower = 1.;
    float max_wind_change = .2;
    float neighbour_wind = wind_power + ((randin01()-0.5)*max_wind_change);
    if(neighbour_wind > max_windpower){
        neighbour_wind = max_windpower;
    }
    if(neighbour_wind< -max_windpower) {
        neighbour_wind = -max_windpower;
    }
} ->@(wind_power)
->default(neighbour_wind)


collect (float sum = 0., int number = 0) avg among Drone {
    sum = sum + previous.sum + next.sum + input;
    number = previous.number + next.number + 1;
}->@(sum / ((float) number))
->default(sum, number)

system {

    // 10 drones : ./CHIPS_GENERATED/output/build/system  259,84s user 112,18s system 69% cpu 8:55,70 total
    // 1 drone : 
    int nb_drones = 1;
    float dt = 0.01;

    Trajectory traj;

    Wind wind;

    Drone [nb_drones] drones;
    PID_CI [nb_drones] local_ctrl;


    for i in range(nb_drones) {

        drones[i].windz((windspread) wind.pow);

        local_ctrl[i].goal((formation) traj.command);
        local_ctrl[i].dt(dt);
        local_ctrl[i].measure(drones[i].alt_out);
        local_ctrl[i].Kp(2000.);
        local_ctrl[i].Ki(200.);
        local_ctrl[i].Kd(100.);
        local_ctrl[i].min(0.);
        local_ctrl[i].max(2500.);

        drones[i].u(local_ctrl[i].correction);
        
        drones[i].dt(dt);
        link local_ctrl[i] to drones[i];
        
        if(i < nb_drones -1) {
            drones[i+1].previous(drones[i].next);
            drones[i].next(drones[i+1].previous);
        }
    }
    link traj to drones[nb_drones/2];
    link wind to drones[0];
}