// Ensemble de controlleurs PID

// Mettre en place clamp(value, lower, upper) -> max(lower, min(value, upper))

// Est-ce qu'on permet à l'utilisateur de wrapper un contrôlleur ?
// Si oui, cela nécéssite d'autoriser l'appel d'un block fonctionnel au sein d'un autre ou alors 
//         transformer en fonction vu que c'est "que des opérations arithmétique"
// Sinon, pourquoi on l'interdirait ?

// On va se l'autoriser mais pour les controlleurs
// pid(...).correction -> renvoie la correction
// pid(...).newError -> renvoie la nouvelle erreur

// On pourrait avoir des surcharges pour faire seulement un PController, PIController
// -> Est-ce que c'est utile ?
//      Si oui, alors faire les controlleurs pour les surcharges
//      Sinon, du travail en moins

// Pas forcément d'utilité en général mais il peut avoir des cas s'en servent

// De même est-ce que c'est utile de mettre un maximum et minimum en output
logical PIDController(float targetValue, float currentValue, float kp, float ki, float kd, float minOutput, float maxOutput, float prevError) init {
    
    float error = 0.;
    float integral = 0.;
    float derivative = 0.;

    float dt = 0.;

}then{

    dt = currentValue;

    // 1. Erreur
    error = targetValue - currentValue;

    // 2. Terme P
    float p_out = kp * dt;

    // 3. Terme I
    integral = integral + error * dt;
    float i_out = ki * integral;

    // 4. Terme D
    if(dt > 0.){
        derivative = (error - prevError) / dt;
    }
    float d_out = kd * derivative;

    // 5. Sortie correction
    float pid = p_out + i_out + d_out;

    float correction = clamp(pid, minOutput, maxOutput); // max(minOutput, min(pid, maxOutput));
} -> newError(error)
-> correction(correction)

// Vraiment utile ?
logical PIController(float targetValue, float currentValue, float kp, float ki, float minOutput, float maxOutput, float prevError) init {
    float error;
    float correction;
} then {
    error = PIDController(targetValue, currentValue, kp, ki, 0., minOutput, maxOutput, prevError).newError;
    correction = PIDController(targetValue, currentValue, kp, ki, 0., minOutput, maxOutput, prevError).correction;
} -> newError(error)
-> correction(correction)

// Vraiment utile ?
logical PDController(float targetValue, float currentValue, float kp, float kd, float minOutput, float maxOutput, float prevError) init {
    float error;
    float correction;
} then {
    error = PIDController(targetValue, currentValue, kp, 0., kd, minOutput, maxOutput, prevError).newError;
    correction = PIDController(targetValue, currentValue, kp, 0., kd, minOutput, maxOutput, prevError).correction;
} -> newError(error)
-> correction(correction)

// Vraiment utile ?
logical PController(float targetValue, float currentValue, float kp, float minOutput, float maxOutput, float prevError) init {
    float error;
    float correction;
} then {
    error = PIDController(targetValue, currentValue, kp, 0., 0., minOutput, maxOutput, prevError).newError;
    correction = PIDController(targetValue, currentValue, kp, 0., 0., minOutput, maxOutput, prevError).correction;
} -> newError(error)
-> correction(correction)


logical PIDControllerEnabled(float defaultValue, float targetValue, float currentValue, float kp, float ki, float kd, float minOutput, float maxOutput, float prevError, bool enabled) init {
    float error = 0;
    float correction = defaultValue;
} then {
    if(enabled){
        error = PIDController(targetValue, currentValue, kp, ki, kd, minOutput, maxOutput, prevError).newError;
        // Au niveau du compilateur PIDController serait appelé qu'une fois et ses sorties garder en mémoire
        // pour éviter d'appeler plusieurs fois la même fonction
        correction = PIDController(targetValue, currentValue, kp, ki, kd, minOutput, maxOutput, prevError).correction;
    }
} -> newError(error)
-> correction(correction)