    atom type UserMachine_core (const bool starts)
    
        
        data chips_int startTime_aidd
        
        data chips_int endTime_aidd
        
        data chips_int id_aidd
        
        data chips_int maxNbData_aidd
        
        data chips_int httpResponse_aidd
        
        data chips_int computerID_aidd
        
        data chips_bool active_aidd
        
        data chips_bool waiting_aidd
        
        data chips_int time_aidd
        
        data chips_bool requiresAuth_aidd
        
        data chips_bool newPage_aidd
        
        data chips_int currentRequest_aidd
        
        data chips_int httpRequest_aidd
        
        data chips_int lastRequest_aidd
        
        data chips_int fromUserToInternet_aidd
        
        
        export port int_port_t send_aipd(fromUserToInternet_aidd)
        
        export port intintintintint_port_t recv_aipd(startTime_aidd, endTime_aidd, id_aidd, maxNbData_aidd, httpResponse_aidd)
        
        export port int_port_t read_ctx_aipd()
        
        export port int_port_t write_ctx_aipd(computerID_aidd)
        
        port port_t start_aipd()
        
        port port_t then_aipd()
        
        place INIT, RECEIVE, THEN, SEND, READCTX, WRITECTX
        initial to INIT
            
            on start_aipd
                from INIT
                to RECEIVE
                provided (true)
            
            on start_aipd
                from INIT
                to SEND
                provided (true)
            
            on recv_aipd
                from RECEIVE
                to READCTX
                provided (true)
            
            on read_ctx_aipd
                from READCTX
                to THEN
                provided (true)
            
            on then_aipd
                from THEN
                to WRITECTX
                provided (true)
            
            on write_ctx_aipd
                from WRITECTX
                to SEND
                provided (true)
            
            on send_aipd
                from SEND
                to RECEIVE
                provided (true)
    
    
    end

    
    atom type ServerMachine_core (const bool starts)
    
        
