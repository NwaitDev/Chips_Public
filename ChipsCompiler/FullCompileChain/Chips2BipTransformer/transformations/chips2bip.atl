				name='wrong dimensions on substract',
				type= 'float',
				dims= Sequence{1},
				value= Sequence{0.0}
			}
		endif
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot substract values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on substract',
			type= 'float',
			dims= Sequence{1},
			value= Sequence{0.0}
		}
	endif;

	helper context chips!"chips::rvalues::primitive::operators::int::mod" def : evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(node_data) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(node_data) in
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='div',
				type= loperand.type,
				dims= loperand.dims,
				value= thisModule.range(loperand.dims)
					->collect(i | loperand.value->get(i) mod roperand.value->get(i))
			}
		else
			let a : OclType = 'ATL transformation Error'.debug('Cannot compute mod values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on modulo',
				type= 'int',
				dims= Sequence{1},
				value= Sequence{0}
			}
		endif
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot compute mod values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on modulo',
			type= 'int',
			dims= Sequence{1},
			value= Sequence{0}
		}
	endif;

helper context chips!"chips::rvalues::primitive::operators::float::cast_as_float" def : evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let operand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(node_data) in
	if  (operand.type = 'int') then
		Tuple{
			name='cast',
			type= 'float',
			dims= operand.dims,
			value= operand.value
		}
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot cast '+operand.name+' as float') in
		Tuple{
			name='cast error',
			type= 'float',
			dims= Sequence{1},
			value= Sequence{0}
		}
	endif;

