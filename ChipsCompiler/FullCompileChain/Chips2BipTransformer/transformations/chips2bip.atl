helper context chips!"chips::rvalues::system::operators::bool::eq_float" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	thisModule.eq(loperand,roperand,memory);

helper context chips!"chips::rvalues::system::operators::bool::eq_bool" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	thisModule.eq(loperand,roperand,memory);


helper context chips!"chips::rvalues::system::function" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	let params: Sequence(TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer))) 
			= self.parameters->collect(e | e.evaluate(memory)) in
	let dimensions : Sequence(Integer) = params->collect(p | p.value->get(0)) in
	if (self.name = 'zeros') then
		Tuple{
			name = 'zeros',
			type = 'int',
			value = thisModule.zeros(dimensions),
			dims = dimensions
		}
	else 
		if(self.name = 'ones') then
			Tuple{
				name = 'ones',
				type = 'int',
				value = thisModule.ones(dimensions),
				dims = dimensions
			}
		else 
			if(self.name = 'range') then
				Tuple{
					name = 'range',
					type = 'int',
					value = thisModule.range(dimensions),
					dims = dimensions
				}
			else 
				let a : OclAny = OclUndefined.debug('Unrecogized function name '+self.name) in
				Tuple{
					name = 'fcall',
					type = 'error',
					value = Sequence{0},
					dims = Sequence{1}
				}
			endif
		endif
	endif;


