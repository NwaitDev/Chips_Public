-- -------------------------------------------

helper context chips!"chips::statements::primitive::foreach" def : 
	evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	let expr : TupleType(name:String, type: String, value:Sequence(OclAny), dims:Sequence(Integer)) = self.iterable_expr.evaluate(node_data) in
	let iterable : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	Tuple{
		name=self.iterator.variable.name,
		type=
			if self.iterator.oclIsKindOf(chips!"chips::statements::system::int_declaration") then
				'int'
			else
				if self.iterator.oclIsKindOf(chips!"chips::statements::system::float_declaration") then
					'float'
				else 
					if self.iterator.oclIsKindOf(chips!"chips::statements::system::bool_declaration") then
						'bool'
					else 
						OclUndefined
					endif
				endif
			endif,
		value = expr.value,
		dims = expr.dims
	} in
	iterable.value->iterate(
		iterator ; 
		m1: TupleType(
			temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
			channels:Map(String,String),
			contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
		) = node_data |
		let m1_prime : TupleType(
			temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
			channels:Map(String,String),
			contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
		) = self.statements->iterate( 
			stt ; 
			m2: TupleType(
				temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
				channels:Map(String,String),
				contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = Tuple{
					temp_memory = Tuple{
						variables = m1.temp_memory.variables->including(
							Tuple{
								name=self.iterator.variable.name,
								value=Sequence{iterator},
								type=iterable.type,
								dims=
								if iterable.dims->size()>=2 then 
									iterable.dims->subSequence(2,iterable.dims->size())			
								else 
									if iterable.dims->size() = 1 then
										Sequence{1}
									else
										OclUndefined -- what happened??? How did you get here?
									endif
								endif
							}
						)
					},
					channels = m1.channels,
					contextuals = m1.contextuals
				} | 
			stt.evaluate(m2)
		) in
		Tuple{
			temp_memory = Tuple{
				variables = m1_prime.temp_memory.variables->reject(e | (e.name = self.iterator.variable.name) and (e.type = iterable.type))
			},
			channels = m1_prime.channels,
			contextuals = m1_prime.contextuals
		}
	);


helper context chips!"chips::statements::primitive::if" def :
	evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(node_data).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
				channels:Map(String,String),
				contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = node_data |
			stt.evaluate(m1)
		)
	else
		node_data
	endif;

helper context chips!"chips::statements::primitive::if_else" def :
	evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(node_data).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
				channels:Map(String,String),
				contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = node_data |
			stt.evaluate(m1)
		)
	else
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
				channels:Map(String,String),
				contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = node_data |
			stt.evaluate(m1)
		)
	endif;

helper context TupleType(
	temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
	channels:Map(String,String),
	contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : assignRvalToLvalVariable(lvalue:OclAny, lvalindexinterval:TupleType(start:Integer, end:Integer), rvalue:OclAny, rvalindexinterval:TupleType(start:Integer, end:Integer))
: Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
 = self.temp_memory.variables->excluding(lvalue)->including(
	Tuple{
		name = lvalue.name,
		type = lvalue.type,
		value = 
		if (lvalindexinterval.start = 0 ) then 
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1)
			else
				rvalue.value->subSequence(1, rvalindexinterval.start+1)
				->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
			endif 
		else
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				lvalue.value->subSequence(1,lvalindexinterval.start+1)
				->union(rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1))
			else
				lvalue.value->subSequence(1,lvalindexinterval.start)
				->union(rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1))
				->union(lvalue.value->subSequence(lvalindexinterval.end+1, lvalue.value->size()))
			endif
		endif,
		dims=lvalue.dims			
	}
);

