		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let var : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
