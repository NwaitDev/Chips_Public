-- -- linking instructions evaluation in system context
-- ----------------------------------------------------

helper context chips!link def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let reference : TupleType(src:String,src_index:Integer, trg:String, trg_index:String) =
		Tuple{
			src = self.linked_component.variable.name,
			src_index = self.linked_component.index->collect(v | v->evaluate(memory)),
			trg = self.support_node.variable.name,
			trg_index = self.support_node.index->collect(v| v->evaluate(memory))
		} in
	Tuple{
		fblocks = memory.fblocks,
		dataflows = memory.dataflows,
		links = 
		if memory.links->exists(e | 
			((e.src = reference.src) and 
			(e.src_index = reference.src_index)) and
			((e.trg = reference.trg) and
			(e.trg_index = reference.trg_index))) then 
			let a : OclAny = reference.debug('Cannot link the same components twice') in
			memory.links
		else
			memory.links->including(
				reference
			)
		endif,
		nodes = memory.nodes,
		connections = memory.connections,
		variables = memory.variables
	};

-- -- channel plugging evaluation in system context
-- ------------------------------------------------

helper context chips!channel_plugging def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = Tuple {
		fblocks = memory.fblocks,
		dataflows = memory.dataflows,
		links = memory.links,
		nodes = memory.nodes,
		connections = 
			let from_ob_name : String = self.feeder.node.variable.name in
			let from_ob_index : Sequence(Integer) = self.feeder.node.index.evaluate(memory) in
			let from_chan : String = self.feeder.feeding_channel.name in
			let from_chan_type : String = self.feeder.feeding_channel.type_identifier in
			let to_ob_name : String = self.eater.node.variable.name in
			let to_ob_index : Sequence(Integer) = self.eater.node.index.evaluate(memory) in
			let to_chan : String = self.eater.eating_channel.name in
			let to_chan_type : String = self.eater.eating_channel.type_identifier in
			if (not memory.connections->select(e | (e.from_ob = from_ob_name) and (e.from_index = from_ob_index) and (e.from_chan = from_chan))->isEmpty()) then
				let a :OclAny = 'ATL transformation Error'.debug('Cannot plug (feeding) '+from_ob_name+'.'+from_chan+' into (eating) '+to_ob_name+'.'+to_chan+', feeding channel output is already connected') in
				memory.connections
			else if (not memory.connections->select(e | (e.to_ob = to_ob_name) and (e.to_index = to_ob_index) and (e.to_chan = to_chan))->isEmpty()) then
				let a :OclAny = 'ATL transformation Error'.debug('Cannot plug (feeding) '+from_ob_name+'.'+from_chan+' into (eating) '+to_ob_name+'.'+to_chan+', eating channel input is already connected') in
				memory.connections
			else if (from_chan_type<>to_chan_type) then
				let a :OclAny = 'ATL transformation Error'.debug('Cannot plug (feeding) '+from_ob_name+'.'+from_chan+' into (eating) '+to_ob_name+'.'+to_chan+', incompatible channel types') in
				memory.connections
			else
				memory.connections->including(
					Tuple{
						from_ob = from_ob_name, 
						from_index = from_ob_index,
						from_chan = from_chan,
						to_ob = to_ob_name,
						to_index = to_ob_index,
						to_chan = to_chan
					}
				)
			endif endif endif
		,
		variables = memory.variables
	};

-- -- Flow control structures interpretation in system section
-- -------------------------------------------

helper context chips!"chips::statements::system::foreach" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let expr : TupleType(name:String, type: String, value:Sequence(OclAny), dims:Sequence(Integer)) = self.iterable_expr.evaluate(memory) in
	let iterable : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	Tuple{
		name=self.iterator.variable.name,
		type=
			if self.iterator.oclIsKindOf(chips!"chips::statements::system::int_declaration") then
				'int'
			else
				if self.iterator.oclIsKindOf(chips!"chips::statements::system::float_declaration") then
					'float'
				else 
					if self.iterator.oclIsKindOf(chips!"chips::statements::system::bool_declaration") then
						'bool'
					else 
						OclUndefined
					endif
				endif
			endif,
		value = expr.value,
		dims = expr.dims
	} in
	iterable.value->iterate(
		iterator ; 
		m1: TupleType(
			fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
				TupleType(
					channels:Map(String,String),
					contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
				)
			))),
			connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
		) = memory |
		let m1_prime : TupleType(
			fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
				TupleType(
					channels:Map(String,String),
					contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
				)
			))),
			connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
		) = self.statements->iterate( 
			stt ; 
			m2: TupleType(
				fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
					TupleType(
						channels:Map(String,String),
						contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
					)
				))),
				connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = Tuple{
					fblocks = m1.fblocks,
					dataflows = m1.dataflows,
					links = m1.links,
					nodes = m1.nodes,
					connections = m1.connections,
					variables = m1.variables->including(Tuple{
						name=self.iterator.variable.name,
						value=Sequence{iterator},
						type=iterable.type,
						dims=
						if iterable.dims->size()>=2 then 
							iterable.dims->subSequence(2,iterable.dims->size())			
						else 
							if iterable.dims->size() = 1 then
								Sequence{1}
							else
								OclUndefined -- what happened??? How did you get here?
							endif
						endif
					})
				} | 
			stt.evaluate(m2)
		) in
		Tuple{
			fblocks = m1_prime.fblocks,
			dataflows = m1_prime.dataflows,
			links = m1_prime.links,
			nodes = m1_prime.nodes,
			connections = m1_prime.connections,
			variables = m1_prime.variables->reject(e | (e.name = self.iterator.variable.name) and (e.type = iterable.type))
		}
	);


helper context chips!"chips::statements::system::if" def :
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(memory).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
					TupleType(
						channels:Map(String,String),
						contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
					)
				))),
				connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	else
		memory
	endif;

helper context chips!"chips::statements::system::if_else" def :
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(memory).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
					TupleType(
						channels:Map(String,String),
						contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
					)
				))),
				connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	else
		self.else_section.else_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
					TupleType(
						channels:Map(String,String),
						contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
					)
				))),
				connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	endif;

