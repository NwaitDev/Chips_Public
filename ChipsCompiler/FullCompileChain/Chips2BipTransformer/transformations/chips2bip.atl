helper def: lt(loperand : OclAny, roperand: OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='lt',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{
					thisModule.range(loperand.dims)
						->forAll(i | loperand.value->get(i) < roperand.value->get(i))
				}
			}
		else
			let a : OclType = OclUndefined.debug('Cannot compare (<) values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on <',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{false}
			}
		endif
	else
		let a : OclType = OclUndefined.debug('Cannot compare (<) values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on <',
			type= 'bool',
			dims= Sequence{1},
			value= Sequence{false}
		}
	endif;

