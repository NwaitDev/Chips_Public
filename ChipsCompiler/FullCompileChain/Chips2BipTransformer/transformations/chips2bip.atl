-- @atlcompiler emftvm
-- @path chips=/Chips2bip/Chips1.1.ecore
-- @path bip=/Chips2Bip/bip.ecore

module chips2bip;

create OUT: bip from IN: chips;

helper def : id : Integer = 0;

helper context String def : protect() : String = 
	self.replaceAll('_','__');

helper def : inputCategory : String = 'input';
helper def : outputCategory : String = 'output';
helper def : innerCategory : String = 'inner';
helper def : ctxCategory : String = 'ctx';

helper context chips!function_definition def : recvPortName : String = self.name+'_recv';
helper context chips!function_definition def : sendPortName : String = self.name+'_send';
helper context chips!function_definition def : readctxPortName : String = self.name+'_read_ctx';
helper context chips!function_definition def : writectxPortName : String = self.name+'_write_ctx';

helper def : dictionary : Map(String, Map(OclAny, OclAny)) = Map{};
helper def : temp_dic : Map(OclAny,OclAny) = Map{};

