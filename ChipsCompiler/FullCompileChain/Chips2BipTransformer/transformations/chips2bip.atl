lazy rule MakeDataDeclarationReferenceDataParameter{
	from	
		datadecl:bip!ConnectorDataDeclaration


	to ddrdp:bip!DataDeclarationReferenceDataParameter(
		dataDeclarationReference <- datadecl
	)
}

unique lazy rule MakeConnectorPortParameterDeclaration{
	from 
		indexed_types:Sequence(TupleType(iindex:Integer,type:String)),
		iindex:Integer,
		datadecls:Sequence(bip!ConnectorDataDeclaration)

	to cppd : bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(Sequence{indexed_types->get(iindex).type}),
		name <- 'p'+iindex.toString()+'_cppd',
		dataParameters<- indexed_types->collect(t | thisModule.MakeDataDeclarationReferenceDataParameter(datadecls->get(t.iindex)))
	)
}

unique lazy rule MakeMany2OneConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		datadecls:Sequence(bip!ConnectorDataDeclaration) = 
			indexed_types->collect(t | thisModule.MakeMany2OneConnectorDataDeclaration(t.type,t.iindex,ordered_types));

		cppd : Sequence(bip!ConnectorPortParameterDeclaration) = 
			indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(indexed_types, t.iindex,datadecls));

		upinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n)
					),
					thisModule.MakeAssignmentSubDataOperand(
						cppd->get(n),
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n),
							0,
							Sequence{ordered_types->get(n)}
						)
					)
				)
			);
		exported : bip!ConnectorExportedPortDeclaration = thisModule.MakeMany2OneExportedPortDeclaration(indexed_types, datadecls);
	}

	to one : bip!ConnectorType(
		name <- ordered_types->iterate( iter ; accu_name : String = 'many2one_'| accu_name+iter )+'_t',
		ports <- cppd,
		exportedPortDeclaration <- exported,
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(cppd)
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- cppd, --(ConnectorPortParameterDeclaration)
		up <- upinteraction, --(Expression)
		down <- Sequence{} , --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('Many2OneConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('datadecls', datadecls),
					('cppd', cppd),
					('epd', exported)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('Many2OneConnectorTypes', thisModule.temp_dic);
		one;
	}
}

