unique lazy rule MakeCoreAtomDataDeclarationReferenceDataParameter{
	from 
		iindex : Integer,
		type : String,
		datadecl: bip!AtomInternalDataDeclaration,
		functiondef:chips!function_definition

	to 
		ddrdp: bip!DataDeclarationReferenceDataParameter(
