helper context chips!"chips::xvalues::primitive::int_variable_expression" def : evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let var : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
		node_data.variables->any(e | (e.name = self.variable.name->protect())) in
	if (var.type <> 'int') then 
		'ATL transformation Error'.debug(var.name+' is of type '+var.type+', int expected')
	else
		var
	endif;

