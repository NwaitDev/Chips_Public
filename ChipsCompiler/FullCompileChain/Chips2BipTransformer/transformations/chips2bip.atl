-- helper context Set(TupleType(key:String, value:OclAny, type:String, dimensions:Sequence(Integer))) def : 
-- getCompoundExportPortDeclarationOf(
-- 	varname:String
-- 	index:Sequence(Integer),
-- 	paramname:String
-- ) : bip!CompoundExportPortDeclaration = 
-- memory->any(t | t.key = varname)


rule Program2BipPackage {
	from chipsprogram: chips!program
	
	using {

		data_types: Sequence(bip!DataType) = 
			Sequence{'int','float','bool'}->collect(t | thisModule.MakeChipsDataType(t))
			->union(Sequence{thisModule.MakeBackendDataType('bool')})->toArray(); -- only needed to decide which fsm starts


		base_port_types: Sequence(bip!PortType) = 
			Sequence{Sequence{'int'},Sequence{'float'},Sequence{'bool'},Sequence{}}
				->collect( t | thisModule.MakePortType(t))->toArray();



		all_chips_function_defs : Sequence(chips!function_definition) = 
			chipsprogram.preamble.definitions->select(d | d.oclIsKindOf(chips!function_definition))->toArray();
		

		system_specific_input_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_inputs->collect(t | t.type)
				)
			)->toArray();
		
		system_specific_output_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_outputs->collect(t | t.type)
				)
			)->toArray();

		core_atom_types: Sequence(bip!AtomType) = all_chips_function_defs->collect(d |  thisModule.MakeCoreAtomType(d))->toArray();

		all_monotype_buffer_atom_types : Sequence(bip!AtomType) =
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeMonotypeBufferType(t))->toArray();
		
		constants_atom_types: Sequence(bip!AtomType) = 
			Sequence{'int','float', 'bool'}
			->collect(t|thisModule.MakeConstantAtomType(t))->toArray();


		functional_blocks_types: Sequence(bip!CompoundType) = 
			all_chips_function_defs
			->collect(d | thisModule.MakeFunctionalBlockCompoundType(d))->toArray();
		
		functional_input_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeInputBufferType(d.all_inputs->collect(t | t.type)))->toArray();
		
		functional_output_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeOutputBufferType(d.all_outputs->collect(t | t.type)))->toArray();


		all_exporting_connector_types: Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeMany2OneConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeOne2ManyConnectorType(d.all_outputs->collect(o | o.type))
				)
			)->toArray();
		non_trivial_flow_connector_types:Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeFlowConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeFlowConnectorType(d.all_outputs->collect(o | o.type))
				)
			)->toArray();
		
		trivial_flow_connector_types: 
		Map(Sequence(String), TupleType(
			ct:bip!ConnectorType, 
			s_port: bip!ConnectorPortParameterDeclaration, 
			r_port:bip!ConnectorPortParameterDeclaration
		)) =
			Map{
				(
					Sequence{'int'},
					Tuple{
						ct=thisModule.MakeFlowConnectorType(Sequence{'int'}),
						s_port= thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'int'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'int'})
							->get('s_port')
					}
				),
				(
					Sequence{'float'},
					Tuple{
						ct=(thisModule.MakeFlowConnectorType(Sequence{'float'})),
						s_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'float'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'float'})
							->get('s_port')
					}
				),
				(
					Sequence{'bool'},
					Tuple{
						ct=(thisModule.MakeFlowConnectorType(Sequence{'bool'})),
						s_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'bool'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'bool'})
							->get('s_port')
					}
				)
			};
		
		
		all_flow_connector_types : Sequence(bip!ConnectorType) =
			non_trivial_flow_connector_types->union(
				trivial_flow_connector_types
					->getValues()
					->collect(t|t.ct)
					->asSequence()
			)->toArray();
		
		---------------------------------------------------------------------------------
		---------------------------------------------------------------------------------
		----------------------Evaluation of the system section---------------------------
		---------------------------------------------------------------------------------

		bip_package : TupleType(
			components: Sequence(bip!ComponentDeclaration), 
			connectors: Sequence(bip!ConnectorDeclaration)
		) =
		let memory:TupleType(
			fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
			connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
		) =
		chipsprogram.system.system_statements->iterate(
			stt ; mem :TupleType(
				fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
				connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = Tuple{fblocks=Map{}, dataflows=Map{}, nodes=Map{}, connections=Set{}, variables=Sequence{}} |
			stt.evaluate(mem)
		)--.debug('\n----------------------memory state------------------------\n')
		in
		Tuple{
			components = memory.fblocks->getKeys()->iterate(
				fbname ; seq :Sequence(bip!ComponentDeclaration) = Sequence{}|
				seq->union(memory.fblocks->get(fbname).instances)
			),
			connectors = memory.dataflows->getValues()
		};

	}
	to 
		bippackage: bip!BipPackage(
			name <- chipsprogram.fileName.split('\\.')->get(0),
			atomTypes <- core_atom_types
				->union(all_monotype_buffer_atom_types)
				->union(constants_atom_types),
			compoundTypes <- functional_output_buffer_types
				->union(functional_input_buffer_types)
				->union(functional_blocks_types)
			 	->union(Sequence{system_compound}),
			connectorTypes <- all_exporting_connector_types
				->union(all_flow_connector_types),
			portTypes <- base_port_types
				->union(system_specific_input_port_types)
				->union(system_specific_output_port_types),
			dataTypes <- data_types
			-- used_packages <- Sequence{},
			-- constData <- Sequence{}, -- what for ? oh wait, yes
			-- prototypes <- Sequence{} -- for importing functions from cpp backend
		),

		system_compound : bip!CompoundType(
			name <- 'SYSTEM_COMPOUND',
			native <- false,
			superTypes <- Sequence{},
			castableTypes <- Sequence{},
			exportedPortDeclarations <- Sequence{},
			exportedDataDeclarations <- Sequence{},
			dataParameterDeclarations <- Sequence{},
			componentDeclarations <- bip_package.components,
			connectorDeclarations <- bip_package.connectors,
			exportPortDeclarations <- Sequence{},
			exportDataDeclarations <- Sequence{},
			priorities <- Sequence{}
		)
}

