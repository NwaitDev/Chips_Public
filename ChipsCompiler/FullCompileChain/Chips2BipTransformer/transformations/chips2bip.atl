		OclUndefined.debug(var.name+' is of type '+var.type+', bool expected')
	else
		var
	endif;

helper context chips!"chips::rvalues::system::operators::int::plus" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='plus',
				type= loperand.type,
				dims= loperand.dims,
				value= thisModule.range(loperand.dims)
					->collect(i | loperand.value->get(i) + roperand.value->get(i))
			}
		else
			let a : OclType = OclUndefined.debug('Cannot sum values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on sum',
				type= 'int',
				dims= Sequence{1},
				value= Sequence{0}
			}
		endif
	else
		let a : OclType = OclUndefined.debug('Cannot sum values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on sum',
			type= 'int',
			dims= Sequence{1},
			value= Sequence{0}
		}
	endif;

helper context chips!"chips::rvalues::system::operators::float::plus" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='plus',
				type= loperand.type,
				dims= loperand.dims,
				value= thisModule.range(loperand.dims)
					->collect(i | loperand.value->get(i) + roperand.value->get(i))
			}
		else
			let a : OclType = OclUndefined.debug('Cannot sum values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on sum',
				type= 'float',
				dims= Sequence{1},
				value= Sequence{0.0}
			}
