helper def: lt(loperand : OclAny, roperand: OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='lt',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{
					thisModule.range(loperand.dims)
						->forAll(i | loperand.value->get(i) < roperand.value->get(i))
				}
			}
		else
			let a : OclType = 'ATL transformation Error'.debug('Cannot compare (<) values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on <',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{false}
			}
		endif
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot compare (<) values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on <',
			type= 'bool',
			dims= Sequence{1},
			value= Sequence{false}
		}
	endif;

helper context chips!"chips::rvalues::system::operators::bool::lt_int" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	thisModule.lt(loperand,roperand,memory);

helper context chips!"chips::rvalues::system::operators::bool::lt_float" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	let loperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	let roperand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.right_operand->evaluate(memory) in
	thisModule.lt(loperand,roperand,memory);

helper def : eq(loperand : OclAny, roperand: OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	if  (loperand.type = roperand.type) then
		if (loperand.dims = roperand.dims) then
			Tuple{
				name='eq',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{
					thisModule.range(loperand.dims)
						->forAll(i | loperand.value->get(i) < roperand.value->get(i))
				}
			}
		else
			let a : OclType = 'ATL transformation Error'.debug('Cannot compare (=) values of different dimensions\n'+loperand.name+' and '+roperand.name) in
			Tuple{
				name='wrong dimensions on =',
				type= 'bool',
				dims= Sequence{1},
				value= Sequence{false}
			}
		endif
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot compare (=) values of different types\n'+loperand.name+' and '+roperand.name) in
		Tuple{
			name='wrong types on =',
			type= 'bool',
			dims= Sequence{1},
			value= Sequence{false}
		}
	endif;

helper context chips!"chips::rvalues::system::operators::bool::eq_int" def : evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
