		)
}

unique lazy rule MakeCoreAtomType {
	from 
		chipsfunction: chips!function_definition

	using{

		-- retrieving the list of data that should be declared in the bip component
		-- sorting with names of the types to put in the ports to avoid generation of equivalent port types
		-- e.g. port(int, float) and port(float,int)
		---------------------------------------------------------------------------
		all_inputs : Sequence(TupleType(type: String, name:String)) = chipsfunction.all_inputs;
		
		all_outputs : Sequence(TupleType(type: String, name:String)) = chipsfunction.all_outputs;
		
		all_contextuals : Sequence(TupleType(type: String, name:String)) = chipsfunction.all_contextuals();


		-- Defining the states for the petri net (order matters)
		--------------------------------------------------------
		all_states : Sequence(bip!State) = Sequence{
			thisModule.MakeState('INIT'),
			thisModule.MakeState('RECEIVE'),
			thisModule.MakeState('THEN'),
			thisModule.MakeState('SEND')
		}->union(
			if (all_contextuals->size()>0) then 
				Sequence{
					thisModule.MakeState('READCTX'),
					thisModule.MakeState('WRITECTX')
				}
			else
				Sequence{}
			endif

		);

		-- generating bip data declarations
		-----------------------------------
		aidd_ctx : Sequence(bip!AtomInternalDataDeclaration) = 
			all_contextuals->collect(t | thisModule.MakeCoreAtomInternalDataDeclaration(
				t.type,
				t.name,
				chipsfunction,
				thisModule.ctxCategory
			));
    	aidd_input : Sequence(bip!AtomInternalDataDeclaration) = 
			all_inputs->collect(t | thisModule.MakeCoreAtomInternalDataDeclaration(
				t.type,
				t.name,
				chipsfunction,
				thisModule.inputCategory
			));
		aidd_output : Sequence(bip!AtomInternalDataDeclaration) = 
			all_outputs->collect(t | thisModule.MakeCoreAtomInternalDataDeclaration(
				t.type,
				t.name,
				chipsfunction,
				thisModule.outputCategory
			));
		aidd_inner : Sequence(bip!AtomInternalDataDeclaration) = 
			chipsfunction.init.statements
			->select(stt | stt.oclIsKindOf(chips!primitive_declaration))
			->collect(stt |  thisModule.MakeCoreAtomInternalDataDeclaration(
				stt.extract_type,
				stt.name,
				chipsfunction,
				thisModule.innerCategory
			)); 


		-- generating port parameter declarations
		-----------------------------------------
		pdpd_inputs : Sequence(bip!PortDataParameterDeclaration) = 
			thisModule.MakeCoreAtomPortDataParamDeclSequence(all_inputs->collect(t | t.type),aidd_input,chipsfunction);

		pdpd_outputs : Sequence(bip!PortDataParameterDeclaration) = 
			thisModule.MakeCoreAtomPortDataParamDeclSequence(all_outputs->collect(t | t.type), aidd_output,chipsfunction);
		
		pdpd_ctx : Sequence(bip!PortDataParameterDeclaration) = 
			thisModule.MakeCoreAtomPortDataParamDeclSequence(all_contextuals->collect(t|t.type),aidd_ctx,chipsfunction);


		input_aipd : bip!AtomInternalPortDeclaration = 
			thisModule.MakeCoreAtomInternalPortDeclaration(chipsfunction.recvPortName,all_inputs->collect(t | t.type),pdpd_inputs,chipsfunction);
		output_aipd : bip!AtomInternalPortDeclaration = 
			thisModule.MakeCoreAtomInternalPortDeclaration(chipsfunction.sendPortName,all_outputs->collect(t | t.type),pdpd_outputs,chipsfunction);
		read_ctx_aipd : bip!AtomInternalPortDeclaration = 
			thisModule.MakeCoreAtomInternalPortDeclaration(chipsfunction.readctxPortName,all_contextuals->collect(t | t.type),pdpd_ctx,chipsfunction);
		write_ctx_aipd : bip!AtomInternalPortDeclaration = 
			thisModule.MakeCoreAtomInternalPortDeclaration(chipsfunction.writectxPortName,all_contextuals->collect(t | t.type),pdpd_ctx,chipsfunction);

		-- generating ports (order matters)
		-----------------------------------
		all_aipdecl : Sequence(bip!AtomInternalPortDeclaration) = Sequence{
			thisModule.MakeCoreAtomInternalPortDeclaration('start',Sequence{},Sequence{},chipsfunction), -- (start port AIPD) 
			thisModule.MakeCoreAtomInternalPortDeclaration('then',Sequence{},Sequence{},chipsfunction), -- (then port AIPD),
			output_aipd, -- (send port AIPD) 
			input_aipd  -- (recv port AIPPD)
		}->union(
			if (all_contextuals->size()>0) then
				Sequence{
					read_ctx_aipd, 
					write_ctx_aipd 
				}
			else 
				Sequence{}
			endif
		);

		-- generating atom exported port declarations
		---------------------------------------------

		aepd_snd : bip!AtomExportPortDeclaration =
			thisModule.MakeCoreAtomExportPortDeclaration(chipsfunction.sendPortName,all_outputs->collect(t | t.type),pdpd_outputs,chipsfunction);
		aepd_rcv : bip!AtomExportPortDeclaration =
			thisModule.MakeCoreAtomExportPortDeclaration(chipsfunction.recvPortName,all_inputs->collect(t | t.type),pdpd_inputs,chipsfunction);

		read_ctx_aepd : bip!AtomExportPortDeclaration =
			thisModule.MakeCoreAtomExportPortDeclaration(chipsfunction.readctxPortName,all_contextuals->collect(t | t.type),pdpd_ctx,chipsfunction);

		write_ctx_aepd : bip!AtomExportPortDeclaration =
			thisModule.MakeCoreAtomExportPortDeclaration(chipsfunction.writectxPortName,all_contextuals->collect(t | t.type),pdpd_ctx,chipsfunction);


		-- generating list of contextuals to export
		-------------------------------------------
		ctx_to_export : Sequence(bip!AtomExportPortDeclaration) = 
			if all_contextuals.isEmpty() then 
				Sequence{}
			else 
				Sequence{
					read_ctx_aepd,
					write_ctx_aepd 
				}
			endif;
	}

	to core_component_type: bip!AtomType(
    	name <- chipsfunction.name + '_core',
        native <- false,
        superTypes <- Sequence{},
        castableTypes <- Sequence{},
        exportedPortDeclarations <- Sequence{aepd_snd,aepd_rcv}->union(ctx_to_export),
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{starts},
        internalPortDeclarations <- all_aipdecl->append(output_aipd),
        externalPortDeclarations <- Sequence{},
        behavior <- pn,
        internalDataDeclarations <- aidd_input->union(aidd_ctx)->union(aidd_inner)->union(aidd_output),
        exportPortDeclarations <-Sequence{aepd_snd,aepd_rcv}->union(ctx_to_export)
    ),


	starts : bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBackendDataType('bool'),
		name <- 'starts',
		const <- true
	),

	pn : bip!PetriNet(
		states <- all_states,
		initStates <- Sequence{all_states->get(0)},
		transitions <- thisModule.MakeTransitions(all_states, all_aipdecl),
		initialActions <- Sequence{} -- put the call to the init function here
	)

	do{

		thisModule.temp_dic <- thisModule.dictionary->get('CoreAtomTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				chipsfunction.name,
				Map{}
				->including('aidd',Map{
					('ctx',aidd_ctx),
					('input',aidd_input),
					('output',aidd_output)
				})
				->including('pdpd',Map{
					('ctx',pdpd_ctx),
					('input',pdpd_inputs),
					('output',pdpd_outputs)
				})
				->including('aipd',Map{
					('read_ctx',read_ctx_aipd),
					('write_ctx',write_ctx_aipd),
					('input',input_aipd),
					('output',output_aipd)
				})
				->including('aepd',Map{
					('read_ctx',read_ctx_aepd),
					('write_ctx',write_ctx_aepd),
					('input',aepd_rcv),
					('output',aepd_snd)
				})
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('CoreAtomTypes', thisModule.temp_dic);
		
		core_component_type;
	}
}


lazy rule MakeMonotypeBufferTypeInternalDataDeclaration{
	from
		type : String

	to datadecl:bip!AtomInternalDataDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <-type+'_data'
	)
}


lazy rule MakeMonotypeBufferTypeInternalPortDeclaration{
	from
		type: String,
		isinput:Boolean
	
	to port : bip!AtomInternalPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <- (type + if isinput then '_in' else '_out' endif),
		dataParameters <- Sequence{
			thisModule.MakeAtomDataDeclarationReferenceDataParameter(
				0,
				type,
				thisModule.MakeMonotypeBufferTypeInternalDataDeclaration(type)
			)
		}
	)
}

unique lazy rule MakeMonotypeBufferTypeExportPortDeclaration{
	from
		type: String,
		isinput:Boolean

	to 	aepd: bip!AtomExportPortDeclaration(
			portType <- thisModule.MakePortType(Sequence{type}),
			name <-(type + if isinput then 'exp_in' else 'exp_out' endif),
			portDeclarationReferences <- Sequence{thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(type,isinput)}
		)
}


unique lazy rule MakeMonotypeBufferType{
	from 
		type: String
	
	using{
		dataname : String = type+'_data';

		aidd:bip!AtomInternalDataDeclaration = 
			thisModule.MakeMonotypeBufferTypeInternalDataDeclaration(type);
		aipd_in:bip!AtomInternalPortDeclaration = 
			thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(type,true);
		aipd_out:bip!AtomInternalPortDeclaration = 
			thisModule.MakeMonotypeBufferTypeInternalPortDeclaration(type,false);
		aepd_in:bip!AtomExportPortDeclaration = 
			thisModule.MakeMonotypeBufferTypeExportPortDeclaration(type,true);
		aepd_out:bip!AtomExportPortDeclaration = 
			thisModule.MakeMonotypeBufferTypeExportPortDeclaration(type,false);
	}
	
	to 
		buffer: bip!AtomType(
			name <- type + '_buffer_t',
	        native <- false,
	        exportedPortDeclarations <- Sequence{aepd_in,aepd_out},
	        dataParameterDeclarations <- Sequence{}, -- should stay empty for that type
	        internalPortDeclarations <- Sequence{aipd_in,aipd_out},
	        behavior <- thisModule.MakeBufferPetriNet(aipd_in,aipd_out),
	        internalDataDeclarations <- Sequence{aidd},
	        exportPortDeclarations <- Sequence{aepd_in,aepd_out}
		)
	do {

		thisModule.temp_dic <- thisModule.dictionary->get('MonotypeBufferTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				type,
				Map{
					('aidd', aidd),
					('aipd_in', aipd_in),
					('aipd_out', aipd_out),
					('aepd_in', aepd_in),
					('aepd_out', aepd_out)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('MonotypeBufferTypes', thisModule.temp_dic);
		
		buffer;
	}
}

lazy rule MakeMonoTypeBufferComponentDeclaration{
	from 
		type: String,
		dataname:String
	
	to bufferdeclaration : bip!ComponentDeclaration(
		type <- thisModule.MakeMonotypeBufferType(type),
		parameters <- Sequence{},
		name <- dataname.protect()+'_bd'
	)
}

lazy rule MakeContextualTypeInternalDataDeclaration{
	from
		type : String

	to datadecl:bip!AtomInternalDataDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <-type+'_data'
	)
}

lazy rule MakeContextualTypeInternalPortDeclaration{
	from
		name:String, type: String, aidd: bip!AtomInternalDataDeclaration
	
	to port : bip!AtomInternalPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <- name,
		dataParameters <- Sequence{
			thisModule.MakeAtomDataDeclarationReferenceDataParameter(
				0,
				type,
				aidd
			)
		}
	)
}

unique lazy rule MakeContextualTypeExportPortDeclaration{
	from
		name: String,
		type: String,
		aipd: bip!AtomInternalPortDeclaration

	to 	aepd: bip!AtomExportPortDeclaration(
			portType <- thisModule.MakePortType(Sequence{type}),
			name <- name + '_exp',
			portDeclarationReferences <- Sequence{aipd}
		)
}

unique lazy rule MakeContextualAtomType{
	from 
		type: String
	
	using{

		aidd:bip!AtomInternalDataDeclaration = 
			thisModule.MakeContextualTypeInternalDataDeclaration(type);

		aipd_rcv_token:bip!AtomInternalPortDeclaration = 
			thisModule.MakeContextualTypeInternalPortDeclaration('receiveToken', type, aidd);
		aipd_give_token:bip!AtomInternalPortDeclaration = 
			thisModule.MakeContextualTypeInternalPortDeclaration('giveToken', type, aidd);
		aipd_read:bip!AtomInternalPortDeclaration = 
			thisModule.MakeContextualTypeInternalPortDeclaration('justRead', type, aidd);
		
		aepd_rcv_token:bip!AtomExportPortDeclaration = 
			thisModule.MakeContextualTypeExportPortDeclaration('receiveToken', type, aipd_rcv_token);
		aepd_give_token:bip!AtomExportPortDeclaration = 
			thisModule.MakeContextualTypeExportPortDeclaration('giveToken', type, aipd_give_token);
		aepd_read:bip!AtomExportPortDeclaration = 
			thisModule.MakeContextualTypeExportPortDeclaration('justRead', type, aipd_read);
	}
	
	to 
		contextual: bip!AtomType(
			name <- type + '_contextual_t',
	        native <- false,
	        exportedPortDeclarations <- Sequence{aepd_rcv_token,aepd_give_token,aepd_read},
	        dataParameterDeclarations <- Sequence{cdpd},
	        internalPortDeclarations <- Sequence{aipd_rcv_token,aipd_give_token,aipd_read},
	        behavior <- thisModule.MakeContextualPetriNet(cdpd, type, aidd, aipd_rcv_token,aipd_give_token,aipd_read),
	        internalDataDeclarations <- Sequence{aidd},
	        exportPortDeclarations <- Sequence{aepd_rcv_token,aepd_give_token,aepd_read}
		),
	
	cdpd: bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBackendDataType('string'),
		name <- 'ctx_name',
		const <- true
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('ContextualTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				type,
				Map{
					('aepd_rcv', aepd_rcv_token),
					('aepd_give', aepd_give_token),
					('aepd_read', aepd_read)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('ContextualTypes', thisModule.temp_dic);
		
		contextual;
	}
}

lazy rule MakeContextualAtomDeclaration {
	from
		name:String,
		type: String
	using {
		fullname : String = name+thisModule.nodeId.toString();
	}
	to contextual: bip!ComponentDeclaration(
		type <- thisModule.MakeContextualAtomType(type),
		parameters <- Sequence{dse},
		name <- fullname
	),

	dse:bip!DirectStringExpression(
		value <- name
	)

	do {
		thisModule.nodeId <- thisModule.nodeId + 1;
		contextual;
	}
}

unique lazy rule MakeMany2OneConnectorDataDeclaration{
	from 
		type:String,
		iindex:Integer,
		ordered_types:Sequence(String)


	to cdd:bip!ConnectorDataDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <- 'v'+iindex.toString()
	)
}


lazy rule MakeAssignmentSubDataOperand{
	from 
		port: bip!ConnectorPortParameterDeclaration, 
		datadecl: bip!PortDataParameterDeclaration

	to rhs: bip!SubDataDeclarationReferenceExpression(
		subDataDeclarationRef<-subddr
	),

	subddr:bip!SubDataDeclarationReference(
		forwardDataDeclaration <- datadecl,
		portDeclaration <- port
	)
}

lazy rule MakeAssignmentDataOperand{
	from datadecl:bip!ConnectorDataDeclaration

	to dddre:bip!DirectDataDeclarationReferenceExpression(
		dataDeclaration<-datadecl
	)
}

lazy rule MakeAssignment{
	from 
		asslhs:bip!Expression,
		assrhs:bip!Expression
	
	to
		assignment:bip!AssignmentExpression(
			lhs<-asslhs,
			rhs<-assrhs
		)
}

lazy rule MakeConnectorDataDeclarationReferenceDataParameter {
	from 
		type:OclAny,
		ddr:bip!ConnectorDataDeclaration,
		paramdecl:bip!PortDataParameterDeclaration

	to ddrdp:bip!DataDeclarationReferenceDataParameter(
		dataDeclarationReference<-ddr,
		type<-thisModule.MakeBipDataType(type),
		parameterDeclaration <- paramdecl
	)
}


unique lazy rule MakeMany2OneExportedPortDeclaration{
	from 
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)),
		datadecls:Sequence(bip!ConnectorDataDeclaration)
	
	to b:bip!ConnectorExportedPortDeclaration(
		portType <-thisModule.MakePortType(indexed_types->collect(tuple | tuple.type)),
		name <- 'r_exported_port',
		dataParameters <- indexed_types
			->collect(tuple | 
				thisModule.MakeConnectorDataDeclarationReferenceDataParameter(
					tuple.type,
					datadecls->get(tuple.iindex),
					thisModule.MakePortDataParameterDeclaration(
						tuple.type,
						tuple.iindex,
						indexed_types->collect(t|t.type)
					)
				)
			)
	)
}

lazy rule MakeConnectorInteractionNestedDefinition{
	from
		portdecls:Sequence(bip!ConnectorPortParameterDeclaration)

	to 
		cind:bip!ConnectorInteractionNestedDefinition(
			quoted <- false,
			subInteractions <- portdecls->collect(pdecl | thisModule.MakeConnectorInteractionPortReference(pdecl))
		)

}

lazy rule MakeConnectorInteractionPortReference{
	from 
		portdecl:bip!ConnectorPortParameterDeclaration
	to
		cipr:bip!ConnectorInteractionPortReference(
			quoted <- false,
			port <- portdecl
		)
}

lazy rule MakeDataDeclarationReferenceDataParameter{
	from	
		datadecl:bip!ConnectorDataDeclaration


	to ddrdp:bip!DataDeclarationReferenceDataParameter(
		dataDeclarationReference <- datadecl
	)
}

unique lazy rule MakeConnectorPortParameterDeclaration{
	from 
		indexed_types:Sequence(TupleType(iindex:Integer,type:String)),
		iindex:Integer,
		datadecls:Sequence(bip!ConnectorDataDeclaration)

	to cppd : bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(Sequence{indexed_types->get(iindex).type}),
		name <- 'p'+iindex.toString()+'_cppd',
		dataParameters<- indexed_types->collect(t | thisModule.MakeDataDeclarationReferenceDataParameter(datadecls->get(t.iindex)))
	)
}

unique lazy rule MakeCollectiveConnectorPortParameterDeclaration{
	from 
		indexed_types:Sequence(TupleType(iindex:Integer,type:String)),
		channelname: String,
		cfd:chips!collective_function_definition

	to cppd : bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(indexed_types->collect(t | t.type)),
		name <- 'p_'+channelname+'_cppd'
	)
}

unique lazy rule MakeMany2OneConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		datadecls:Sequence(bip!ConnectorDataDeclaration) = 
			indexed_types->collect(t | thisModule.MakeMany2OneConnectorDataDeclaration(t.type,t.iindex,ordered_types));

		cppd : Sequence(bip!ConnectorPortParameterDeclaration) = 
			indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(indexed_types, t.iindex,datadecls));

		upinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n)
					),
					thisModule.MakeAssignmentSubDataOperand(
						cppd->get(n),
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n),
							0,
							Sequence{ordered_types->get(n)}
						)
					)
				)
			);
		exported : bip!ConnectorExportedPortDeclaration = thisModule.MakeMany2OneExportedPortDeclaration(indexed_types, datadecls);
	}

	to one : bip!ConnectorType(
		name <- ordered_types->iterate( iter ; accu_name : String = 'many2one_'| accu_name+iter )+'_t',
		ports <- cppd,
		exportedPortDeclaration <- exported,
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(cppd)
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- cppd, --(ConnectorPortParameterDeclaration)
		up <- upinteraction, --(Expression)
		down <- Sequence{} , --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)



	do {

		thisModule.temp_dic <- thisModule.dictionary->get('Many2OneConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('datadecls', datadecls),
					('cppd', cppd),
					('epd', exported)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('Many2OneConnectorTypes', thisModule.temp_dic);
		one;
	}
}

unique lazy rule MakeOne2ManyConnectorDataDeclaration{
	from 
		type:String,
		iindex:Integer,
		ordered_types:Sequence(String)


	to cdd:bip!ConnectorDataDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <- 'v'+iindex.toString()
	)
}

