-- Declaration of components in system context
----------------------------------------------


helper def: updatefblockswith(fdecl:OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))) =
	let dims : Sequence(Integer) = fdecl.variable.dimensions->collect(e | e.evaluate(memory).value->get(0)) in
	let lin_indices : Sequence(Integer) = thisModule.range(dims) in
	if lin_indices->size() <> 0 then 
		memory.fblocks->including(
			fdecl.variable.name->protect(),
			Tuple{
				ftype = fdecl."def",
				dimensions = dims,
				instances = lin_indices->iterate( 
					i ; temp_instances:Sequence(bip!ComponentDeclaration) = Sequence{} |
					temp_instances->append(
						thisModule.MakeCompoundDeclaration(
							fdecl.variable.name+'_'+i.toString(),
							fdecl."def",
							Sequence{thisModule.MakeDirectBooleanExpression(true)}
						)
					)
				)
			}
		)
	else 
		memory.fblocks->including(
			fdecl.variable.name->protect(), 
			Tuple{
				ftype = fdecl."def",
				dimensions = dims,
				instances = Sequence{
					thisModule.MakeCompoundDeclaration(
						fdecl.variable.name+'_0',
						fdecl."def",
						Sequence{thisModule.MakeDirectBooleanExpression(true)}
					)
				}	
			}
		)
	endif;

helper context chips!"chips::statements::system::physical_declaration" def :
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	Tuple {
		fblocks = thisModule.updatefblockswith(self, memory),
		dataflows = memory.dataflows,
		links = memory.links,
		nodes = thisModule.updatenodeswith(self, memory),
		connections = memory.connections,
		variables = memory.variables
	};


