	from 
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)),
		datadecls:Sequence(bip!ConnectorDataDeclaration)
	
	to b:bip!ConnectorExportedPortDeclaration(
		portType <-thisModule.MakePortType(indexed_types->collect(tuple | tuple.type)),
		name <- 's_exported_port',
		dataParameters <- indexed_types
			->collect(tuple | 
				thisModule.MakeConnectorDataDeclarationReferenceDataParameter(
					tuple.type,
					datadecls->get(tuple.iindex),
					thisModule.MakePortDataParameterDeclaration(
						tuple.type,
						tuple.iindex,
						indexed_types->collect(t|t.type)
					)
				)
			)
	)
}


unique lazy rule MakeOne2ManyConnectorType{
	from ordered_types : Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		datadecls:Sequence(bip!ConnectorDataDeclaration) = 
			indexed_types->collect(t | thisModule.MakeOne2ManyConnectorDataDeclaration(t.type,t.iindex,ordered_types));

		cppd : Sequence(bip!ConnectorPortParameterDeclaration) = 
			indexed_types->collect(t | thisModule.MakeConnectorPortParameterDeclaration(indexed_types, t.iindex,datadecls));

		downinteraction : Sequence(bip!Expression) = 
			thisModule.range(Sequence{datadecls->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						cppd->get(n),
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n),
							n,
							ordered_types
						)
					),
					thisModule.MakeAssignmentDataOperand(
						datadecls->get(n)
					)
				)
			);
		
		exported:bip!ConnectorExportedPortDeclaration = 
			thisModule.MakeOne2ManyExportedPortDeclaration(indexed_types, datadecls);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'one2many_'| accu_name+iter )+'_t',
		exportedPortDeclaration <- exported,
		dataDeclarations <- datadecls,
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(cppd),
		ports <- cppd
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- cppd, --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
	do {
		thisModule.temp_dic <- thisModule.dictionary->get('One2ManyConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('datadecls', datadecls),
					('cppd', cppd),
					('epd', exported)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('One2ManyConnectorTypes', thisModule.temp_dic);
		
		one;
	}
}


unique lazy rule MakeFlowPortDeclarationReferenceParameter{
	from 
		ordered_types : Sequence(String),
		src:Boolean

	to cppd: bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(ordered_types),
		name<-if src then 's' else 'r' endif
	)
}

unique lazy rule MakeFlowConnectorType{
	from 
		ordered_types:Sequence(String)

	using{
		indexed_types:Sequence(TupleType(type:String,iindex:Integer)) = 
			ordered_types->augmentWithIindex()
			->collect(t|Tuple{type=t.data,iindex=t.iindex});

		send_port : bip!ConnectorPortParameterDeclaration = 
			thisModule.MakeFlowPortDeclarationReferenceParameter(ordered_types, true);

		recv_port : bip!ConnectorPortParameterDeclaration =
			thisModule.MakeFlowPortDeclarationReferenceParameter(ordered_types, false);

		downports : Sequence(bip!ConnectorPortParameterDeclaration) = 
			Sequence{send_port, recv_port}; 

		downinteraction : Sequence(bip!Expression) =
			thisModule.range(Sequence{ordered_types->size()})
			->collect(n | 
				thisModule.MakeAssignment(
					thisModule.MakeAssignmentSubDataOperand(
						recv_port,
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n),
							n,
							ordered_types
						)
					),
					thisModule.MakeAssignmentSubDataOperand(
						send_port,
						thisModule.MakePortDataParameterDeclaration(
							ordered_types->get(n),
							n,
							ordered_types
						)
					)
				)
			);
	}

	to one : bip!ConnectorType(
		name<-ordered_types->iterate( iter ; accu_name : String = 'flow_'| accu_name+iter )+'_t',
		interactions<-Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(downports),
		ports <- downports
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports, --(ConnectorPortParameterDeclaration)
		up <- Sequence{}, --(Expression)
		down <-downinteraction, --(Expression)
		guard <- thisModule.MakeTrivialGuard(true)-- (ValuedExpression)
	)
	do {

		thisModule.temp_dic <- thisModule.dictionary->get('FlowConnectorTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('s_port', send_port),
					('r_port', recv_port)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('FlowConnectorTypes', thisModule.temp_dic);

		one;
	}
}

lazy rule MakeConnectorSubPortDeclarationReference{
	from 
		portdecl : bip!ConnectorExportedPortDeclaration,
		conndecl : bip!ConnectorDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, -- (AtomExportedPortDeclaration/ConnectorExportedPortDeclaration)
		--componentDeclaration <-  --(ComponentDeclaration)
		-- or 
		connectorDeclaration <- conndecl --(ConnectorDeclaration)
	)
}

lazy rule MakeComponentSubPortDeclarationReference{
	from 
		portdecl : bip!PortDeclaration,
		compdecl : bip!ComponentDeclaration

	to spr:bip!SubPortDeclarationReference(
		forwardPortDeclaration <- portdecl, -- (AtomExportedPortDeclaration?)/(ConnectorExportedPortDeclaration)
		componentDeclaration <- compdecl --(ComponentDeclaration)
		-- or 
		--connectorDeclaration <- --(ConnectorDeclaration)
	)
}

unique lazy rule MakePortDeclarationReferenceParameter{
	from 
		portdecl:bip!PortDeclaration, -- coming from the definition of the connector
		subpdrp:bip!SubPortDeclarationReference -- the actual port that gets connected via that declaration
		
	to pdrp:bip!PortDeclarationReferenceParameter(
		parameterDeclaration <- portdecl, 
		subPortDeclarationReference <- subpdrp 
	)
}

helper def: getNodeData(node:chips!node_definition) : 
TupleType(
	channels:Map(String,String),
	contextuals:Map(String,TupleType(
		dimensions:Sequence(Integer),
		instances:Sequence(bip!ComponentDeclaration)
	))
) = node.with.statements->iterate( stt ; 
	node_data : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = Tuple{temp_memory = Tuple{variables=Sequence{}},channels=Map{}, contextuals=Sequence{}} | stt->evaluate(node_data)
);

helper context chips!collective_function_definition def : getAccumulatorSig() : Sequence(TupleType(name:String,type:String)) = 
	self.accumulator.accumulator->collect( param |
		Tuple{
			name = param.declaration.variable.name,
			type = if param.oclIsKindOf(chips!int_collective_parameter) then
				'int'
			else if param.oclIsKindOf(chips!float_collective_parameter) then
				'float'
			else if param.oclIsKindOf(chips!bool_collective_parameter) then
				'bool'
			else
				'ATL transformation Error'.debug('this should never happen, unrecognized type for accumulator parameter '+param.name)
			endif endif endif
		}
	)->asSequence();

unique lazy rule MakeCollectiveConnectorDataDeclaration{
	from 
		datatype:bip!DataType,
		dname:String,
		cfd:chips!collective_function_definition


	to cdd:bip!ConnectorDataDeclaration(
		dataType <- datatype,
		name <- dname
	)
}

unique lazy rule MakeSpreadConnectorType{
	from 
		cfd:chips!collective_function_definition

	using{
		fname : String = cfd.name;

		support_node_type : String = cfd.support_object.name;

		hascontextuals : Boolean = false; -- at the moment, not implemented because it's a pain to do
		
		node_data : TupleType(
			channels:Map(String,String),
			contextuals:Map(String,TupleType(
				dimensions:Sequence(Integer),
				instances:Sequence(bip!ComponentDeclaration)
			))
		) = thisModule.getNodeData(cfd.support_object);

		accumulator_signature: Sequence(TupleType(name:String,type:String)) = cfd.getAccumulatorSig();

		target_type : String = 
		let expr : OclAny = cfd.target_output.expression->at(1) in 
		-- currently, target_output.expression is a sequence in anticipation for when we get anonymous datastructures 
		-- as signals transmitted between components
		if expr.oclIsKindOf(chips!collective_int_rvalue) then
			'int'
		else if expr.oclIsKindOf(chips!collective_float_rvalue) then
			'float'
		else if expr.oclIsKindOf(chips!collective_bool_rvalue) then
			'bool'
		else
			'ATL transformation Error'.debug('this should never happen, unrecognized type for target output of '+fname)
		endif endif endif;

		accu_sig_indexed : Sequence(TupleType(data:TupleType(type:String,name:String), iindex:Integer)) = 
			accumulator_signature->augmentWithIindex();

		up_datadecls : Sequence(bip!ConnectorDataDeclaration) =
			accumulator_signature->collect(
				t |
				thisModule.MakeCollectiveConnectorDataDeclaration(
					thisModule.MakeBipDataType(t.type),
					t.name+'_of_upaccumulator',
					cfd
				)
			)
			->asSequence();

		downports : Map(String,bip!ConnectorPortParameterDeclaration) = 
			node_data.channels->getKeys()->iterate(
				name ; themap : Map(String,bip!ConnectorPortParameterDeclaration) = Map{} |
				themap->including(
					name,
					thisModule.MakeCollectiveConnectorPortParameterDeclaration(
						accu_sig_indexed->collect(t | Tuple{type=t.data.type, iindex=t.iindex}), name, cfd
					)
				)
			);
	}

	to cct:bip!ConnectorType(
		name<- fname+'_among_'+support_node_type+'_conn_t',
		interactions<- Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(
			downports->getValues()->asSequence()
			->append(target_cppd)
		),
		exportedPortDeclaration <- up_accumulator,
		dataDeclarations <- up_datadecls,
		ports <- downports->getValues()->including(target_cppd)
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports->getValues()->asSequence()
			->append(target_cppd), --(ConnectorPortParameterDeclaration)
		down <- Sequence{downinteraction},
		up <- if hascontextuals then
			Sequence{upinteraction}
		else
			Sequence{}
		endif
	),

	downinteraction: bip!FunctionCallExpression(
		functionName <- fname+'_down'--,
		--parameters <- ,
	),

	upinteraction: bip!FunctionCallExpression(
		functionName <- fname+'_up'--,
		--parameters <- ,
	),

	up_accumulator :bip!ConnectorExportedPortDeclaration(
		portType <-thisModule.MakePortType(accu_sig_indexed->collect(tuple | tuple.data.type)),
		name <- 'up_accumulator',
		dataParameters <- accu_sig_indexed
			->collect(tuple | 
				thisModule.MakeConnectorDataDeclarationReferenceDataParameter(
					tuple.data.type,
					up_datadecls->get(tuple.iindex),
					thisModule.MakePortDataParameterDeclaration(
						tuple.data.type,
						tuple.iindex,
						accu_sig_indexed->collect(t|t.data.type)
					)
				)
			)
	),
	
	target_cppd : bip!ConnectorPortParameterDeclaration(
		portType <- thisModule.MakePortType(target_type),
		name <- 'p_target_cppd'
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('SpreadConnectorType');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				fname,
				Map{}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('SpreadConnectorType', thisModule.temp_dic);

		cct;
	}
}


unique lazy rule MakeCollectConnectorType{
	from 
		cfd:chips!collective_function_definition

	using{
		fname : String = cfd.name;

		support_node_type : String = cfd.support_object.name;

		hascontextuals : Boolean = false; -- at the moment, not implemented because it's a pain to do
		
		input_type : String = cfd.operations.statements->extract_input_type();
		
		node_data : TupleType(
			channels:Map(String,String),
			contextuals:Map(String,TupleType(
				dimensions:Sequence(Integer),
				instances:Sequence(bip!ComponentDeclaration)
			))
		) = thisModule.getNodeData(cfd.support_object);

		accumulator_signature: Sequence(TupleType(name:String,type:String)) = cfd.getAccumulatorSig();

		target_type : String = 
		let expr : OclAny = cfd.target_output.expression->at(1) in 
		-- currently, target_output.expression is a sequence in anticipation for when we get anonymous datastructures 
		-- as signals transmitted between components
		if expr.oclIsKindOf(chips!collective_int_rvalue) then
			'int'
		else if expr.oclIsKindOf(chips!collective_float_rvalue) then
			'float'
		else if expr.oclIsKindOf(chips!collective_bool_rvalue) then
			'bool'
		else
			'ATL transformation Error'.debug('this should never happen, unrecognized type for target output of '+fname)
		endif endif endif;

		accu_sig_indexed : Sequence(TupleType(data:TupleType(type:String,name:String), iindex:Integer)) = 
			accumulator_signature->augmentWithIindex();

		up_datadecls : Sequence(bip!ConnectorDataDeclaration) =
			Sequence{
				thisModule.MakeCollectiveConnectorDataDeclaration(
					thisModule.MakeBipDataType(target_type),
					'target_data',
					cfd
				)
			}->union(
				node_data.channels->getKeys()->asSequence()->collect(
					chan |
					thisModule.MakeCollectiveConnectorDataDeclaration(
						thisModule.MakeBipDataType(accumulator_signature->collect(t | t.type)),
						chan+'_output',
						cfd
					)
				)
			);

		downports : Map(String,bip!ConnectorPortParameterDeclaration) = 
			node_data.channels->getKeys()->iterate(
				channame ; themap : Map(String,bip!ConnectorPortParameterDeclaration) = Map{} |
				themap->including(
					channame->protect(),
					thisModule.MakeCollectiveConnectorPortParameterDeclaration(
						accu_sig_indexed->collect(t | Tuple{type=t.data.type, iindex=t.iindex}), 
						channame->protect(), 
						cfd
					)
				)
			)->including(
				'_self', 
				thisModule.MakeCollectiveConnectorPortParameterDeclaration(
					accu_sig_indexed->collect(t | Tuple{type=t.data.type, iindex=t.iindex}), 
					'_self',
					cfd
				)
			)->including(
				'input', 
				thisModule.MakeCollectiveConnectorPortParameterDeclaration(
					Sequence{Tuple{type=input_type, iindex=0}}, 
					'input',
					cfd
				)
			);
		
		up_port_type_seq : Sequence(OclAny) = 
			Sequence{target_type}
			->union(
				node_data.channels->getKeys()->asSequence()
				->collect(channame | accumulator_signature->collect(tuple | tuple.type))
			);
	}

	to cct:bip!ConnectorType(
		name<- fname+'_among_'+support_node_type+'_conn_t',
		interactions<- Sequence{interaction},
		interactionDefinition <- thisModule.MakeConnectorInteractionNestedDefinition(
			downports->getValues()
		),
		exportedPortDeclaration <- up_accumulator,
		dataDeclarations <- up_datadecls,
		ports <- downports->getValues()
	),

	interaction:bip!ConnectorInteractionAction(
		onPorts<- downports->getValues(), --(ConnectorPortParameterDeclaration)
		up <- Sequence{upinteraction}
	),

	upinteraction: bip!FunctionCallExpression(
		functionName <- fname+'_up'--,
		--parameters <- ,
	),

	up_accumulator :bip!ConnectorExportedPortDeclaration(
		portType <-thisModule.MakePortType(up_port_type_seq),
		name <- 'up_accumulator',
		dataParameters <-
		up_port_type_seq->augmentWithIindex()
		->collect(
			t |
			thisModule.MakeConnectorDataDeclarationReferenceDataParameter(
				up_port_type_seq->get(t.iindex),
				up_datadecls->get(t.iindex), -- ddr:bip!ConnectorDataDeclaration,
				thisModule.MakePortDataParameterDeclaration(
					up_port_type_seq->get(t.iindex), -- type:OclAny
					t.iindex, --iindex:Integer
					up_port_type_seq --type_ordered_sequence:Sequence(OclAny)
				)
			)
		)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('SpreadConnectorType');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				fname,
				Map{}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('SpreadConnectorType', thisModule.temp_dic);

		cct;
	}
}

lazy rule MakeConnectorDeclaration{
	from 
		name:String,
		conntype : bip!ConnectorType,
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)
	to 
		conn:bip!ConnectorDeclaration(
			type <- conntype,
			portParameters <- portparameters,
			name <- name.protect()+'_cd'
		)
}


unique lazy rule MakeMany2OneConnectorDeclaration{
	from 
		types:Sequence(String),
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)

	to conn:bip!ConnectorDeclaration(
		type<- thisModule.MakeMany2OneConnectorType(types),
		portParameters <- portparameters,
		name <- types->iterate(s ; acc:String = '' | acc+s)+'_input_connector'
	)
}

unique lazy rule MakeOne2ManyConnectorDeclaration{
	from 
		types:Sequence(String),
		portparameters: Sequence(bip!PortDeclarationReferenceParameter)

	to conn:bip!ConnectorDeclaration(
		type<- thisModule.MakeOne2ManyConnectorType(types),
		portParameters <- portparameters,
		name <- types->iterate(s ; acc:String = '' | acc+s)+'_output_connector'
	)
}

helper context Sequence(TupleType(iindex:Integer, type:String, buf:bip!ComponentDeclaration)) def : 
asIBTSequenceOfCompoundExportPortDeclarations() : Sequence(bip!CompoundExportPortDeclaration) =
	self->collect(t | 
		thisModule.MakeCompoundExportPortDeclaration(
			t.type+'_input_'+t.iindex.toString(),
			Sequence{t.type},
			Sequence{
				thisModule.MakeComponentSubPortDeclarationReference(
					thisModule.dictionary
						->get('MonotypeBufferTypes')
						->get(t.type)
						->get('aepd_in'),
					t.buf
				)
			}
		)
	);

helper context Sequence(TupleType(iindex:Integer, type:String, buf:bip!ComponentDeclaration)) def : 
asOBTSequenceOfCompoundExportPortDeclarations() : Sequence(bip!CompoundExportPortDeclaration) =
	self->collect(t | 
		thisModule.MakeCompoundExportPortDeclaration(
			t.type+'_output_'+t.iindex.toString(),
			Sequence{t.type},
			Sequence{
				thisModule.MakeComponentSubPortDeclarationReference(
					thisModule.dictionary
						->get('MonotypeBufferTypes')
						->get(t.type)
						->get('aepd_out'),
					t.buf
				)
			}
		)
	);

unique lazy rule MakeInputBufferType{
	from ordered_types : Sequence(String)

	using{
		indexed_typed_monotype_buffers 
		: Sequence(TupleType(iindex:Integer, type:String,buf:bip!ComponentDeclaration)) = 
			ordered_types->augmentWithIindex()
			->collect(t | 
				Tuple{
					iindex = t.iindex,
					type=t.data,
					buf = thisModule.MakeMonoTypeBufferComponentDeclaration(t.data,t.data+t.iindex.toString())
				}
			);

		connector_type : bip!ConnectorType =
			thisModule.MakeMany2OneConnectorType(ordered_types);
		
		
		input_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			indexed_typed_monotype_buffers->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.dictionary
						->get('Many2OneConnectorTypes')
						->get(ordered_types)
						->get('cppd')
						->get(t.iindex),
					thisModule.MakeComponentSubPortDeclarationReference(
						thisModule.dictionary
							->get('MonotypeBufferTypes')
							->get(t.type)
							->get('aepd_out'),
						t.buf
					)
				)
			);

		input_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeMany2OneConnectorDeclaration(
				ordered_types,
				input_connector_port_parameters
			);
		
		exported_one : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'one',
				ordered_types,
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.dictionary
							->get('Many2OneConnectorTypes')
							->get(ordered_types)
							->get('epd'),
						input_connector_decl
					)
				}
			);
		
	}

	to ibt : bip!CompoundType(
		name <- ordered_types->iterate(s ; acc:String = ''| acc+s)+'_input_buffer_t',
        native <- false,
        exportedPortDeclarations <- indexed_typed_monotype_buffers->asIBTSequenceOfCompoundExportPortDeclarations()->append(exported_one),
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- indexed_typed_monotype_buffers->collect(t|t.buf),
		connectorDeclarations <- Sequence{input_connector_decl},
		exportPortDeclarations <- indexed_typed_monotype_buffers->asIBTSequenceOfCompoundExportPortDeclarations()->append(exported_one)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('InputBufferTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('einputs', indexed_typed_monotype_buffers->asIBTSequenceOfCompoundExportPortDeclarations()),
					('eoutput', exported_one)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('InputBufferTypes', thisModule.temp_dic);

		ibt;
	}
}

unique lazy rule MakeOutputBufferType{
	from ordered_types : Sequence(String)

	using{
		indexed_typed_monotype_buffers 
		: Sequence(TupleType(iindex:Integer, type:String, buf:bip!ComponentDeclaration)) = 
			ordered_types->augmentWithIindex()
			->collect(t | 
				Tuple{
					iindex = t.iindex,
					type=t.data,
					buf = thisModule.MakeMonoTypeBufferComponentDeclaration(t.data,t.data+t.iindex.toString())
				}
			);

		connector_type : bip!ConnectorType =
			thisModule.MakeOne2ManyConnectorType(ordered_types);
		
		
		output_connector_port_parameters : Sequence(bip!PortDeclarationReferenceParameter) =
			indexed_typed_monotype_buffers->collect(
				t | thisModule.MakePortDeclarationReferenceParameter(
					thisModule.dictionary
						->get('One2ManyConnectorTypes')
						->get(ordered_types)
						->get('cppd')
						->get(t.iindex),
					thisModule.MakeComponentSubPortDeclarationReference(
						thisModule.dictionary
							->get('MonotypeBufferTypes')
							->get(t.type)
							->get('aepd_in'),
						t.buf
					)
				)
			);

		output_connector_decl : bip!ConnectorDeclaration = 
			thisModule.MakeOne2ManyConnectorDeclaration(
				ordered_types,
				output_connector_port_parameters
			);
		
		exported_one : bip!CompoundExportPortDeclaration = 
			thisModule.MakeCompoundExportPortDeclaration(
				'one',
				ordered_types,
				Sequence{
					thisModule.MakeConnectorSubPortDeclarationReference(
						thisModule.dictionary
							->get('One2ManyConnectorTypes')
							->get(ordered_types)
							->get('epd'),
						output_connector_decl
					)
				}
			);
	}

	to obt : bip!CompoundType(
		name <- ordered_types->iterate(s ; acc:String = ''| acc+s)+'_output_buffer_t',
        native <- false,
        --exportedPortDeclarations <- indexed_typed_monotype_buffers->asOBTSequenceOfCompoundExportPortDeclarations()->append(exported_one),
        exportedDataDeclarations <- Sequence{},
		dataParameterDeclarations <- Sequence{},
		componentDeclarations <- indexed_typed_monotype_buffers->collect(t|t.buf),
		connectorDeclarations <- Sequence{output_connector_decl},
		exportPortDeclarations <- indexed_typed_monotype_buffers->asOBTSequenceOfCompoundExportPortDeclarations()->append(exported_one)
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('OutputBufferTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				ordered_types,
				Map{
					('eoutputs', indexed_typed_monotype_buffers->asOBTSequenceOfCompoundExportPortDeclarations()),
					('einput', exported_one)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('OutputBufferTypes', thisModule.temp_dic);

		obt;
	}
}


unique lazy rule MakeFunctionalBlockCompoundType {
	from 
		chipsfunction: chips!function_definition

	using {
		all_inputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_inputs;
		all_outputs : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_outputs;
		all_contextuals : Sequence(TupleType(name:String,type:String)) = chipsfunction.all_contextuals();

		all_indexed_inputs : Sequence(TupleType(iindex:Integer,type:String, name:String)) =
			all_inputs->augmentWithIindex()->collect(t | Tuple{type=t.data.type, iindex=t.iindex, name = t.data.name});
		all_indexed_outputs : Sequence(TupleType(iindex:Integer,type:String, name:String)) =
			all_outputs->augmentWithIindex()->collect(t | Tuple{type=t.data.type, iindex=t.iindex, name = t.data.name});
		all_indexed_contextuals : Sequence(TupleType(iindex:Integer,type:String, name:String)) =
			all_contextuals->augmentWithIindex()->collect(t | Tuple{type=t.data.type, iindex=t.iindex, name = t.data.name});

		all_input_ordered_types : Sequence(String) = all_inputs->collect(t|t.type);
		all_output_ordered_types : Sequence(String) = all_outputs->collect(t|t.type);
		all_contextuals_ordered_types : Sequence(String) = all_contextuals->collect(t|t.type);

		only_parameter : bip!ComponentDataParameterDeclaration = 
			thisModule.MakeComponentDataParameterDeclaration('starts','bool',chipsfunction);

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		core_component_declaration : bip!ComponentDeclaration = 
			thisModule.MakeCoreComponentDeclaration(chipsfunction);
			
		input_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_input_buffer',
				thisModule.MakeInputBufferType(all_inputs->collect(t | t.type))
			);

		output_buffer_declaration : bip!ComponentDeclaration = 
			thisModule.MakeBufferCompoundDeclaration(
				chipsfunction.name+'_output_buffer',
				thisModule.MakeOutputBufferType(all_outputs->collect(t | t.type))
			);

		-- do not change the order of the components in the following data structure
		buffers_sequence : Sequence(bip!ComponentDeclaration) = 
			Sequence{
				input_buffer_declaration,
				output_buffer_declaration
			}
			->union(
				if (all_contextuals->isEmpty()) then
					Sequence{}
				else
					Sequence{
						thisModule.MakeBufferCompoundDeclaration(
							chipsfunction.name+'_input_ctx_buffer',
							thisModule.MakeInputBufferType(all_contextuals->collect(t | t.type))
						),
						thisModule.MakeBufferCompoundDeclaration(
							chipsfunction.name+'_output_ctx_buffer',
							thisModule.MakeOutputBufferType(all_contextuals->collect(t | t.type))
						)
					}
				endif
			);

		--------------------------------------------
		--------------------------------------------
		--------------------------------------------

		connector_input_buffer_to_core: bip!ConnectorDeclaration =
			thisModule.MakeConnectorDeclaration(
				'input_to_core',
				thisModule.MakeFlowConnectorType(all_inputs->collect(t|t.type)),
				Sequence{
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('s_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('InputBufferTypes')
								->get(all_input_ordered_types)
								->get('eoutput'),
							input_buffer_declaration
						)
					),
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('r_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('CoreAtomTypes')
								->get(chipsfunction.name)
								->get('aepd')
								->get('input'),
							core_component_declaration
						)
					)
				}
			);

		connector_core_to_output_buffer: bip!ConnectorDeclaration =
			thisModule.MakeConnectorDeclaration(
				'core_to_output',
				thisModule.MakeFlowConnectorType(all_outputs->collect(t|t.type)),
				Sequence{
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_output_ordered_types)
							->get('s_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('CoreAtomTypes')
								->get(chipsfunction.name)
								->get('aepd')
								->get('output'),
							core_component_declaration
						)
					),
					thisModule.MakePortDeclarationReferenceParameter(
						thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(all_input_ordered_types)
							->get('r_port'),
						thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('OutputBufferTypes')
								->get(all_output_ordered_types)
								->get('einput'),
							output_buffer_declaration
						)
					)
				}
			);
		
		-- do not change the order of the components in the following data structure
		connectors_sequence : Sequence(bip!ConnectorDeclaration) = 
			Sequence{connector_input_buffer_to_core, connector_core_to_output_buffer}
			->union(
				if (all_contextuals->isEmpty()) then 
					Sequence{}
				else
					Sequence{
						thisModule.MakeConnectorDeclaration(
							'input_ctx_to_core',
							thisModule.MakeFlowConnectorType(all_contextuals_ordered_types),
							Sequence{
								thisModule.MakePortDeclarationReferenceParameter(
									thisModule.dictionary
										->get('FlowConnectorTypes')
										->get(all_contextuals_ordered_types)
										->get('s_port'),
									thisModule.MakeComponentSubPortDeclarationReference(
										thisModule.dictionary
											->get('InputBufferTypes')
											->get(all_contextuals_ordered_types)
											->get('eoutput'),
										buffers_sequence->at(3)
									)
								),
								thisModule.MakePortDeclarationReferenceParameter(
									thisModule.dictionary
										->get('FlowConnectorTypes')
										->get(all_input_ordered_types)
										->get('r_port'),
									thisModule.MakeComponentSubPortDeclarationReference(
										thisModule.dictionary
											->get('CoreAtomTypes')
											->get(chipsfunction.name)
											->get('aepd')
											->get('read_ctx'),
										core_component_declaration
									)
								)
							}
						),
						thisModule.MakeConnectorDeclaration(
							'core_to_output_ctx',
							thisModule.MakeFlowConnectorType(all_contextuals_ordered_types),
							Sequence{
								thisModule.MakePortDeclarationReferenceParameter(
									thisModule.dictionary
										->get('FlowConnectorTypes')
										->get(all_contextuals_ordered_types)
										->get('s_port'),
									thisModule.MakeComponentSubPortDeclarationReference(
										thisModule.dictionary
											->get('CoreAtomTypes')
											->get(chipsfunction.name)
											->get('aepd')
											->get('write_ctx'),
										core_component_declaration
									)
								),
								thisModule.MakePortDeclarationReferenceParameter(
									thisModule.dictionary
										->get('FlowConnectorTypes')
										->get(all_contextuals_ordered_types)
										->get('r_port'),
									thisModule.MakeComponentSubPortDeclarationReference(
										thisModule.dictionary
											->get('OutputBufferTypes')
											->get(all_contextuals_ordered_types)
											->get('einput'),
										buffers_sequence->at(4)
									)
								)
							}
						)
					}
				endif
			);
		
		exported_inputs : Map(String,bip!CompoundExportPortDeclaration) = 
			all_indexed_inputs->iterate(
				p ; the_map : Map(String,bip!CompoundExportPortDeclaration) = Map{} | 
				the_map->including(
					p.name,
					thisModule.MakeCompoundExportPortDeclaration(
						p.name+'_input',
						Sequence{p.type},
						Sequence{thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('InputBufferTypes')
								->get(all_input_ordered_types)
								->get('einputs')
								->get(p.iindex),
							input_buffer_declaration
						)}
					)
				)
			);

		exported_outputs : Map(String,bip!CompoundExportPortDeclaration) = 
			all_indexed_outputs->iterate(
				p ; the_map : Map(String,bip!CompoundExportPortDeclaration) = Map{} | 
				the_map->including(
					p.name,
					thisModule.MakeCompoundExportPortDeclaration(
						p.name+'_output',
						Sequence{p.type},
						Sequence{thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('OutputBufferTypes')
								->get(all_output_ordered_types)
								->get('eoutputs')
								->get(p.iindex),
							output_buffer_declaration
						)}
					)
				)
			);

		exported_input_ctx : Set(bip!CompoundExportPortDeclaration) = 
			all_indexed_contextuals->iterate(
				p ; map : Map(String,bip!CompoundExportPortDeclaration) = Map{} | 
				map->including(
					p.name,
					thisModule.MakeCompoundExportPortDeclaration(
						p.name+'_input_ctx',
						Sequence{p.type},
						Sequence{thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('InputBufferTypes')
								->get(all_contextuals_ordered_types)
								->get('einputs')
								->get(p.iindex),
							buffers_sequence->at(3)
						)}
					)
				)
			);
		
		exported_output_ctx : Set(bip!CompoundExportPortDeclaration) = 
			all_indexed_contextuals->iterate(
				p ; map : Map(String, bip!CompoundExportPortDeclaration) = Map{} | 
				map->including(
					p.name,
					thisModule.MakeCompoundExportPortDeclaration(
						p.name+'_output_ctx',
						Sequence{p.type},
						Sequence{thisModule.MakeComponentSubPortDeclarationReference(
							thisModule.dictionary
								->get('OutputBufferTypes')
								->get(all_contextuals_ordered_types)
								->get('eoutputs')
								->get(p.iindex),
							buffers_sequence->at(4)
						)}
					)
				)
			);

		exportedportdecl : Sequence(bip!CompoundExportPortDeclaration) =
			exported_inputs->getValues()
			->union(
				exported_outputs->getValues()
			)
			->union(
				if (all_contextuals->isEmpty()) then
					Set{}
				else
					exported_input_ctx->getValues()
					->union(exported_output_ctx->getValues())
				endif
			)->asSequence()->toArray();
	}

    to compound_type:bip!CompoundType(
		name <- chipsfunction.name.protect()+'_compoundtype',
		dataParameterDeclarations <- Sequence{only_parameter},
		componentDeclarations <- 
			Sequence{core_component_declaration}
			->append(input_buffer_declaration)
			->append(output_buffer_declaration),
		connectorDeclarations<- Sequence{
			connector_input_buffer_to_core,
			connector_core_to_output_buffer
		},
		exportPortDeclarations <- exportedportdecl
	)

	do {

		thisModule.temp_dic <- thisModule.dictionary->get('FunctionalBlockCompoundTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				chipsfunction.name,
				Map{
					('einputs', exported_inputs),
					('eoutputs', exported_outputs),
					('ectxinput', exported_input_ctx),
					('ectxoutput', exported_output_ctx)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('FunctionalBlockCompoundTypes', thisModule.temp_dic);

		compound_type;
	}
}

lazy rule MakeBufferCompoundDeclaration{
	from 
		name:String,
		type:bip!CompoundType

	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name+'_buffercompounddecl',
		parameters<- Sequence{},
		type <- type
	)
}

lazy rule MakeCoreComponentDeclaration {
	from 
		chipsfunction: chips!function_definition

	to core_component_declaration: bip!ComponentDeclaration(
		type <- thisModule.MakeCoreAtomType(chipsfunction),
		parameters <- Sequence{starts_valued_expression},
		name <- 'core'
	),
	
	starts_valued_expression: bip!DirectDataDeclarationReferenceExpression (
		dataDeclaration <- thisModule.MakeComponentDataParameterDeclaration('starts','bool',chipsfunction)
	)
}


unique lazy rule MakeComponentDataParameterDeclaration{
	from name:String, type:String, fd:chips!function_definition

	to cdpd: bip!ComponentDataParameterDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <- name+'_componentdataparameterdeclaration',
		const <- true
	)
}


lazy rule MakeCompoundDeclaration{
	from 
		name:String,
		chipsfunction:chips!function_definition,
		parameters:Sequence(OclAny)
		
	to buffer_compound_decl : bip!ComponentDeclaration(
		name<- name+'_compounddecl',
		parameters<- parameters,
		type <- thisModule.MakeFunctionalBlockCompoundType(chipsfunction)
	)
}

lazy rule MakeDirectBooleanExpression{
	from exp : Boolean

	to dbe:bip!DirectBooleanExpression(
		value <- exp
	)
}

lazy rule MakeDirectFloatExpression{
	from exp : Real

	to dfe:bip!DirectFloatExpression(
		value <- exp
	)
}

lazy rule MakeDirectIntegerExpression{
	from exp : Integer

	to die:bip!DirectIntegerExpression(
		value <- exp
	)
}


helper context TupleType(key:String, value:OclAny, type:OclAny, dimensions:Sequence(Integer)) def :
intoCompoundDeclarations(starts : Boolean ) : Map( TupleType(name:String, index:Sequence(Integer)),bip!componentDeclaration) =
let linearized_total: Integer = 
	if self.dimensions->isEmpty() then
		1
	else 
		self.dimensions->iterate( i ; acc:Integer = 1| acc*(i+1))-1
	endif 
in	thisModule.range(Sequence{linearized_total})
	->iterate(i ; 
		the_map : Map( 
			TupleType(name:String, index:Sequence(Integer)),
			bip!componentDeclaration
		) = Map{} | the_map->including(
			Tuple{name = self.key, index= i},
			thisModule.MakeCompoundDeclaration(
				self.key+i.toString(),
				self.type,
				Sequence{thisModule.MakeDirectBooleanExpression(starts)}
			)
		)
	);

unique lazy rule MakeConstantAtomType{
	from
		type:String

	using {
		dataname : String = type+'_value';
	}

	to 
		cst:bip!AtomType(
			name <- type + '_constant_t',
	        native <- false,
	        superTypes <- Sequence{},
	        castableTypes <- Sequence{},
	        exportedPortDeclarations <- Sequence{aepd},
	        exportedDataDeclarations <- Sequence{}, 
	        dataParameterDeclarations <- Sequence{},
	        internalPortDeclarations <- Sequence{port},
	        behavior <- thisModule.MakeConstantPetriNet(port),
	        internalDataDeclarations <- Sequence{datadecl},
	        exportPortDeclarations <- Sequence{aepd}
		),

	aepd: bip!AtomExportPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <- type+'_output'+'_aepd',
		portDeclarationReferences <- Sequence{port}
	),

	port : bip!AtomInternalPortDeclaration(
		portType <- thisModule.MakePortType(Sequence{type}),
		name <- type+'_output'+'_aipd',
		dataParameters <- Sequence{thisModule.MakeAtomDataDeclarationReferenceDataParameter(0,type, datadecl)}
	),

	datadecl:bip!AtomInternalDataDeclaration(
		dataType <- thisModule.MakeBipDataType(type),
		name <-dataname+'_aidd'
	)

	do{

		thisModule.temp_dic <- thisModule.dictionary->get('ConstantAtomTypes');
		if (thisModule.temp_dic.oclIsUndefined()) {
			thisModule.temp_dic <- Map{};
		}

		thisModule.temp_dic <- thisModule.temp_dic
			->including(
				type,
				Map{
					('aidd',datadecl),
					('aipd',port),
					('aepd',aepd)
				}
			);
		thisModule.dictionary <- thisModule.dictionary
			->including('ConstantAtomTypes', thisModule.temp_dic);

		cst;
	}
}


unique lazy rule MakeIntegerConstantDeclaration{
	from 
		value : Integer, id : Integer

	to cst_component_decl: bip!ComponentDeclaration(
		name <- 'cst'+id.toString(),
		type <- thisModule.MakeConstantAtomType('int'),
		parameters <- Sequence{
			thisModule.MakeDirectIntegerExpression(value)
		}
	)
	
	do {
		thisModule.id <- thisModule.id +1;
		cst_component_decl;
	}
}

unique lazy rule MakeFloatConstantDeclaration{
	from 
		value : Real, id : Integer

	to cst_component_decl: bip!ComponentDeclaration(
		name <- 'cst'+id.toString(),
		type <- thisModule.MakeConstantAtomType('int'),
		parameters <- Sequence{
			thisModule.MakeDirectFloatExpression(value)
		}
	)
	
	do {
		thisModule.id <- thisModule.id +1;
		cst_component_decl;
	}
}

unique lazy rule MakeBoolConstantDeclaration{
	from 
		value : Boolean, id : Integer

	to cst_component_decl: bip!ComponentDeclaration(
		name <- 'cst'+id.toString(),
		type <- thisModule.MakeConstantAtomType('int'),
		parameters <- Sequence{
			thisModule.MakeDirectBoolExpression(value)
		}
	)
	
	do {
		thisModule.id <- thisModule.id +1;
		cst_component_decl;
	}
}



helper context TupleType(
	fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
	dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
	links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
	nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
		TupleType(
			channels:Map(String,String),
			contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
		)
	))),
	connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
	variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : getNodeCtxDeclarations(nodename:String, index:Sequence(Integer)): Sequence(TupleType(name:String, comp:Sequence(bip!ComponentDeclaration))) =
let node : OclAny = self.nodes->get(nodename).instances->get(index.linearize(self.nodes->get(nodename).dimensions)) in
	node.contextuals->getKeys()->collect(k | Tuple{name=k, comp=node.contextuals->get(k).instances})->asSequence();


helper context TupleType(
	fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
	dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
	links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
	nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
		TupleType(
			channels:Map(String,String),
			contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
		)
	))),
	connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
	variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : getNodeCtxDeclarationsRec(nodename:String, index:Sequence(Integer)): Sequence(TupleType(name:String, comp:Sequence(bip!ComponentDeclaration))) =
	self.getNodeCtxDeclarations(nodename, index)
	->union(
		let singletonlink : OclAny = self.links->select(e |(e.src = nodename) and (e.src_index = index)) in
		if singletonlink->isEmpty() then
			Sequence{}
		else
			self.getNodeCtxDeclarationsRec(singletonlink.trg, singletonlink.trg_index)
		endif
	);


helper context TupleType(
	fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
	dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
	links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
	nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
		TupleType(
			channels:Map(String,String),
			contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
		)
	))),
	connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
	variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : 
getCtxDeclarations(fblockname:String, index:Sequence(Integer)): Sequence(TupleType(name:String, comp:Sequence(bip!ComponentDeclaration))) =
	self->getNodeCtxDeclarationsRec(fblockname, index);


rule Program2BipPackage {
	from chipsprogram: chips!program
	
	using {

		all_chips_function_defs : Sequence(chips!function_definition) = 
			chipsprogram.preamble.definitions
			->select(d | d.oclIsKindOf(chips!function_definition))->toArray();
		
		all_chips_collective_defs : Sequence(chips!collective_function_definition) =
			chipsprogram.preamble.definitions
			->select(d | d.oclIsKindOf(chips!collective_function_definition))->toArray();


		data_types: Sequence(bip!DataType) = 
			Sequence{'int','float','bool'}->collect(t | thisModule.MakeBipDataType(t))
			->union(Sequence{thisModule.MakeBackendDataType('bool')}) -- only needed to decide which fsm starts
			->union(
				all_chips_collective_defs
				->select(cfd | cfd.collective_function_type = #collect)
				->collect(cfd| cfd.getAccumulatorSig()->collect(elem | elem.type))
				->collect(typeSeq | thisModule.MakeBipDataType(typeSeq))
			)->toArray();

		base_port_types: Sequence(bip!PortType) = 
			Sequence{Sequence{'int'},Sequence{'float'},Sequence{'bool'},Sequence{}}
				->collect( t | thisModule.MakePortType(t))->toArray();

		system_specific_input_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_inputs->collect(t | t.type)
				)
			)->toArray();
		
		system_specific_output_port_types: Sequence(bip!PortType) = 
			all_chips_function_defs->collect(
				the_def | thisModule.MakePortType(
					the_def.all_outputs->collect(t | t.type)
				)
			)->toArray();

		collective_specific_port_types: Sequence(bip!PortType) =
			all_chips_collective_defs->collect(
				the_def | thisModule.MakePortType(
					the_def->getAccumulatorSig()->collect(t | t.type)
				)
			)->toArray();

		core_atom_types: Sequence(bip!AtomType) = all_chips_function_defs->collect(d |  thisModule.MakeCoreAtomType(d))->toArray();

		all_monotype_buffer_atom_types : Sequence(bip!AtomType) =
			Sequence{'int','float', 'bool'}
			->collect( t | thisModule.MakeMonotypeBufferType(t))->toArray();
		
		constants_atom_types: Sequence(bip!AtomType) = 
			Sequence{'int','float', 'bool'}
			->collect( t | thisModule.MakeConstantAtomType(t))->toArray();

		all_contextual_types : Sequence(bip!AtomType) =
			Sequence{'int','float', 'bool'}
			->collect( t | thisModule.MakeContextualAtomType(t))->toArray();

		functional_blocks_types: Sequence(bip!CompoundType) = 
			all_chips_function_defs
			->collect(d | thisModule.MakeFunctionalBlockCompoundType(d))->toArray();
		
		functional_input_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeInputBufferType(d.all_inputs->collect(t | t.type)))->toArray();
		
		functional_output_buffer_types : Sequence(bip!CompoundType) =
			all_chips_function_defs
			->collect(d | thisModule.MakeOutputBufferType(d.all_outputs->collect(t | t.type)))->toArray();


		all_exporting_connector_types: Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeMany2OneConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeOne2ManyConnectorType(d.all_outputs->collect(o | o.type))
				)
			)->toArray();
		non_trivial_flow_connector_types:Sequence(bip!ConnectorType) =
			all_chips_function_defs->collect(
				d | thisModule.MakeFlowConnectorType(d.all_inputs->collect(i | i.type))
			)->union(
				all_chips_function_defs->collect(
					d | thisModule.MakeFlowConnectorType(d.all_outputs->collect(o | o.type))
				)
			)->toArray();
		

		all_collective_connector_types : Sequence(bip!ConnectorType) = 
			all_chips_collective_defs->collect(d | 
				if d.collective_function_type = #spread then
					thisModule.MakeSpreadConnectorType(d)
				else
					thisModule.MakeCollectConnectorType(d)
				endif
			);

		trivial_flow_connector_types: 
		Map(Sequence(String), TupleType(
			ct:bip!ConnectorType, 
			s_port: bip!ConnectorPortParameterDeclaration, 
			r_port:bip!ConnectorPortParameterDeclaration
		)) =
			Map{
				(
					Sequence{'int'},
					Tuple{
						ct=thisModule.MakeFlowConnectorType(Sequence{'int'}),
						s_port= thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'int'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'int'})
							->get('s_port')
					}
				),
				(
					Sequence{'float'},
					Tuple{
						ct=(thisModule.MakeFlowConnectorType(Sequence{'float'})),
						s_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'float'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'float'})
							->get('s_port')
					}
				),
				(
					Sequence{'bool'},
					Tuple{
						ct=(thisModule.MakeFlowConnectorType(Sequence{'bool'})),
						s_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'bool'})
							->get('s_port'),
						r_port=thisModule.dictionary
							->get('FlowConnectorTypes')
							->get(Sequence{'bool'})
							->get('s_port')
					}
				)
			};
		
		
		all_flow_connector_types : Sequence(bip!ConnectorType) =
			non_trivial_flow_connector_types->union(
				trivial_flow_connector_types
					->getValues()
					->collect(t|t.ct)
					->asSequence()
			)->toArray();
		
		---------------------------------------------------------------------------------
		---------------------------------------------------------------------------------
		----------------------Evaluation of the system section---------------------------
		---------------------------------------------------------------------------------

		bip_package : TupleType(
			components: Sequence(bip!ComponentDeclaration), 
			connectors: Sequence(bip!ConnectorDeclaration)
		) =
		let memory:TupleType(
			fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
			connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
		) =
		chipsprogram.system.system_statements->iterate(
			stt ; mem :TupleType(
				fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
				nodes: Map(String,
					TupleType(
						dimensions:Sequence(Integer),
						instances:Sequence(TupleType(
							channels:Map(String,String),
							contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
						))
					)
				),
				connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
			) = Tuple{fblocks=Map{}, dataflows=Map{}, links=Set{},  nodes=Map{}, connections=Set{}, variables=Sequence{}} |
			stt.evaluate(mem)
		)--.debug('\n----------------------memory state------------------------\n')
		in
		------- Connecting the components to their contextual values
		------- According to the components they are linked to
		let ctx_connectors : Sequence(bip!ConnectorDeclaration) = 
			memory.fblocks->getKeys()
			->select(fbkey | not memory.fblocks->get(fbkey).ftype.oclIsUndefined())
			->collect( fbkey | Tuple{fbkey = fbkey, ctxs= memory.fblocks->get(fbkey).ftype->all_contextuals() } )
			->select(fb | not fb.ctxs->isEmpty())
			->iterate(
				fb ; connectorlist1 : Sequence(bip!ConnectorDeclaration) = Sequence{} |
				connectorlist1->union(
					thisModule.range(memory.fblocks->get(fb.fbkey).dimensions)->iterate(
						comp_index ; connectorlist2 : Sequence(bip!ConnectorDeclaration) = Sequence{} |
						connectorlist2->union(
							fb.ctxs->collect( ctx |
								Sequence{
									thisModule.MakeConnectorDeclaration(
										memory.fblocks->get(fb.fbkey).ftype.name+'_'+ctx.name+'_input_ctx_connector',
										thisModule.MakeFlowConnectorType(Sequence{ctx.type}),
										Sequence{
											thisModule.MakePortDeclarationReferenceParameter(
												thisModule.dictionary
													->get('FlowConnectorTypes')
													->get(Sequence{ctx.type})
													->get('s_port'),
												thisModule.MakeComponentSubPortDeclarationReference(
													thisModule.dictionary
														->get('ContextualTypes')
														->get(ctx.type)
														->get('aepd_give'),
													memory->getCtxDeclarations(fb.fbkey,Sequence{comp_index})->at(1).comp->at(1)
												)
											),
											thisModule.MakePortDeclarationReferenceParameter(
												thisModule.dictionary
													->get('FlowConnectorTypes')
													->get(Sequence{ctx.type})
													->get('r_port'),
												thisModule.MakeComponentSubPortDeclarationReference(
													thisModule.dictionary
														->get('FunctionalBlockCompoundTypes')
														->get(memory.fblocks->get(fb.fbkey).ftype.name)
														->get('ectxinput')
														->get(ctx.name),
													memory.fblocks->get(fb.fbkey).instances->get(comp_index)
												)
											)
										}
									),
									thisModule.MakeConnectorDeclaration(
										memory.fblocks->get(fb.fbkey).ftype.name+'_'+ctx.name+'_output_ctx_connector',
										thisModule.MakeFlowConnectorType(Sequence{ctx.type}),
										Sequence{
											thisModule.MakePortDeclarationReferenceParameter(
												thisModule.dictionary
													->get('FlowConnectorTypes')
													->get(Sequence{ctx.type})
													->get('s_port'),
												thisModule.MakeComponentSubPortDeclarationReference(
													thisModule.dictionary
														->get('FunctionalBlockCompoundTypes')
														->get(memory.fblocks->get(fb.fbkey).ftype.name)
														->get('ectxoutput')
														->get(ctx.name),
													memory.fblocks->get(fb.fbkey).instances->get(comp_index)
												)
											),
											thisModule.MakePortDeclarationReferenceParameter(
												thisModule.dictionary
													->get('FlowConnectorTypes')
													->get(Sequence{ctx.type})
													->get('r_port'),
												thisModule.MakeComponentSubPortDeclarationReference(
													thisModule.dictionary
														->get('ContextualTypes')
														->get(ctx.type)
														->get('aepd_rcv'),
													memory->getCtxDeclarations(fb.fbkey,Sequence{comp_index})->at(1).comp->at(1) -- temporarily set to 0
												)
											)
										}
									)
								}
							)
						)
					)
				)
			)->flatten()
		in
		Tuple{
			components = memory.fblocks->getKeys()->iterate(
				fbname ; seq :Sequence(bip!ComponentDeclaration) = Sequence{} |
				seq->union(memory.fblocks->get(fbname).instances)
			)->union(
				memory.nodes->getKeys()->iterate(
				nodename ; seq : Sequence(bip!ComponentDeclaration) = Sequence{} |
					seq->union(
						memory.nodes
						->get(nodename).instances
						->collect(tuple | 
							tuple.contextuals
							->getValues()
							->asSequence()
							->collect(t | t.instances)
						)->flatten()->select( e | not e.oclIsUndefined()) -- I don't know why some variables may end up in the contextuals lists...
					)->flatten()
				)
			),
			connectors = memory.dataflows->getValues()->asSequence()->union(ctx_connectors)
		};

	}

	to 
		bippackage: bip!BipPackage(
			name <- chipsprogram.fileName.split('\\.')->get(0)->split('/')->last(),
			atomTypes <- core_atom_types
				->union(all_monotype_buffer_atom_types)
				->union(constants_atom_types)
				->union(all_contextual_types),
			compoundTypes <- functional_blocks_types
				->union(functional_input_buffer_types)
				->union(functional_output_buffer_types)
			 	->union(Sequence{system_compound}),
			connectorTypes <- all_exporting_connector_types
				->union(all_flow_connector_types)
				->union(all_collective_connector_types),
			portTypes <- base_port_types
				->union(system_specific_input_port_types)
				->union(system_specific_output_port_types)
				->union(collective_specific_port_types),
			dataTypes <- data_types
			-- used_packages <- Sequence{},
			-- constData <- Sequence{}, -- what for ? oh wait, yes
			-- prototypes <- Sequence{} -- for importing functions from cpp backend
		),

		system_compound : bip!CompoundType(
			name <- 'SYSTEM_COMPOUND',
			native <- false,
			superTypes <- Sequence{},
			castableTypes <- Sequence{},
			exportedPortDeclarations <- Sequence{},
			exportedDataDeclarations <- Sequence{},
			dataParameterDeclarations <- Sequence{},
			componentDeclarations <- bip_package.components,
			connectorDeclarations <- bip_package.connectors,
			exportPortDeclarations <- Sequence{},
			exportDataDeclarations <- Sequence{},
			priorities <- Sequence{}
		)
}


-----------------------------------------------------------------------------------------
----------------MEMORY EVALUATION FOR INTERPRETATION OF CHIPS MODELS---------------------
-----------------------------------------------------------------------------------------

-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------
---- 			BIP PRESENCE OF CONTEXTUALS AND CHANNELS
----			DEDUCED FROM CHIPS "WITH" INSTRUCTIONS INTERPRETATION
-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------


helper context chips!channel_declaration def: evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	Tuple{
		temp_memory = node_data.temp_memory,
		channels = 
			if node_data.channels->getKeys()->any( e | e = self.name) <> OclUndefined then
				let a : OclAny = 'ATL transformation Error'.debug('Duplicate channel with name "'+ self.name +'" ignored.') in
				node_data.channels
			else 
				node_data.channels->including(
					self.name,
					self.type_identifier
				)
			endif,
		contextuals = node_data.contextuals
	};

helper context chips!contextual_int_declaration def: evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	if node_data.contextuals->any(e | e = self.identifier) = OclUndefined then
		let dimensions : Sequence(Integer) = self.variable.dimensions->collect(e |e.evaluate(node_data.temp_memory).value->get(0)) in
		let var : TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)) = 
		Tuple{
			name = self.identifier,
			type = 'int',
			value = thisModule.zeros(dimensions),
			dims = dimensions
		} in
		Tuple{
			temp_memory = Tuple{variables=node_data.temp_memory.variables->including(var)},
			channels = node_data.channels,
			contextuals = node_data.contextuals->including(var)
		}
	else
		let a : OclAny = 'ATL transformation Error'.debug('Duplicate contextual with name "'+ self.name +'" ignored.') in
		node_data
	endif;


helper context chips!contextual_float_declaration def: evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	if node_data.contextuals->any(e | e = self.identifier) = OclUndefined then
		let dimensions : Sequence(Integer) = self.variable.dimensions->collect(e |e.evaluate(node_data.temp_memory).value->get(0)) in
		let var : TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)) = 
		Tuple{
			name = self.identifier,
			type = 'float',
			value = thisModule.zeros(dimensions)->collect(z | 0.0),
			dims = dimensions
		} in
		Tuple{
			temp_memory = Tuple{variables=node_data.temp_memory.variables->including(var)},
			channels = node_data.channels,
			contextuals = node_data.contextuals->including(var)
		}
	else
		let a : OclAny = 'ATL transformation Error'.debug('Duplicate contextual with name "'+ self.name +'" ignored.') in
		node_data
	endif;


helper context chips!contextual_bool_declaration def: evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	if node_data.contextuals->any(e | e = self.identifier) = OclUndefined then
		let dimensions : Sequence(Integer) = self.variable.dimensions->collect(e |e.evaluate(node_data.temp_memory).value->get(0)) in
		let var : TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)) = 
		Tuple{
			name = self.identifier,
			type = 'bool',
			value = thisModule.zeros(dimensions)->collect(z | false),
			dims = dimensions
		} in
		Tuple{
			temp_memory = Tuple{variables=node_data.temp_memory.variables->including(var)},
			channels = node_data.channels,
			contextuals = node_data.contextuals->including(var)
		}
	else
		let a : OclAny = 'ATL transformation Error'.debug('Duplicate contextual with name "'+ self.name +'" ignored.') in
		node_data
	endif;


helper def: updatenodeswith(ndecl:OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : Map(
			String,
			TupleType(
				dimensions:Sequence(Integer),
				instances:Sequence(
					TupleType(
						channels:Map(String,String),
						contextuals:Map(String,TupleType(
							dimensions:Sequence(Integer),
							instances:Sequence(bip!ComponentDeclaration)
						))
					)
				)
			)
		) =
	let dims : Sequence(Integer) = ndecl.variable.dimensions->collect(e | e.evaluate(memory).value->get(0)) in
	let lin_indices : Sequence(Integer) = thisModule.range(dims) in
	let node_data : TupleType(
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = thisModule.getNodeData(ndecl."def") in
	if lin_indices->size() <> 0 then 
		memory.nodes->including(
			ndecl.variable.name->protect(),
			Tuple{
				dimensions = dims,
				instances = thisModule.zeros(dims)
				->collect( z | Tuple{
					channels = node_data.channels,
					contextuals = node_data.contextuals->iterate(
						t ; themap : Map(String, TupleType(dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))) = Map{} |
						themap->including(
							t.name->protect(), 
							Tuple{
								dimensions = t.dims, 
								instances = thisModule.zeros(t.dims)->collect(z | thisModule.MakeContextualAtomDeclaration(
									t.name->protect()+'_'+ndecl.variable.name->protect(),
									t.type
								))
							}
						)
					)
				})
			}
		)
	else 
		memory.nodes->including(
			ndecl.variable.name->protect(), 
			Tuple{
				dimensions = Sequence{1},
				instances = Sequence{
					Tuple{
						channels = node_data.channels,
						contextuals = node_data.contextuals->iterate(
							t ; themap : Map(String, TupleType(dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))) = Map{} |
							themap->including(
								t.name->protect(), 
								Tuple{
									dimensions = t.dims, 
									instances = thisModule.zeros(t.dims)->collect(z | thisModule.MakeContextualAtomDeclaration(
										t.name->protect()+'_'+ndecl.variable.name->protect(),
										t.type
									))
								}
							)
						)
					}
				}
			}
		)
	endif;



helper context chips!"chips::rvalues::primitive::direct_int" def : evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) =
	Tuple{
		name = 'direct',
		type = 'int',
		value = Sequence{self.value},
		dims = Sequence{1}
	};
