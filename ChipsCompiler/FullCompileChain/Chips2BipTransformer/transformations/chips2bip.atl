helper context chips!"chips::statements::system::feeding_logical_int" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	if Sequence{
			chips!"chips::systemspecific::expressions::feeder::int_logical_output",
			chips!"chips::systemspecific::expressions::feeder::logical_collective_cast"
		}->forAll( feeder_type | not self.feeder.oclIsTypeOf(feeder_type)) then
		self->handleSystemExpressions(memory)
	else
		Tuple {
			fblocks = memory.fblocks,
			dataflows =
			if self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::int_logical_output") then
				let fdim : Sequence(Integer) = self.feeder.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
				let findices : Sequence(Integer) = self.feeder.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(fdim) in
				let tdim : Sequence(Integer) = self.eater.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
				let tindices : Sequence(Integer) = self.eater.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(tdim) in
				memory.dataflows->including(
					Tuple{
						fcomp= self.feeder.variable_expression.variable.name,
						findex = findices,
						fparam= self.feeder.output.name,
						tcomp= self.eater.variable_expression.variable.name,
						tindex= tindices,
						tparam= self.eater.parameter.name
					},
					thisModule.MakeConnectorDeclaration(
						'from_'+self.feeder.variable_expression.variable.name->protect()
						+'_'+findices.toString()+'_'+self.feeder.output.name
						+'_to_'+self.eater.variable_expression.variable.name->protect()
						+'_'+ tindices.toString()+'_'+self.eater.parameter.name,
						thisModule.MakeFlowConnectorType(Sequence{'int'}),
						Sequence{
							let fdef : chips!function_definition = 
								self.feeder.variable_expression.variable.declaration."def" in
							thisModule.MakePortDeclarationReferenceParameter(
								thisModule.dictionary
									->get('FlowConnectorTypes')
									->get(Sequence{'int'})
									->get('s_port'),
								thisModule.MakeComponentSubPortDeclarationReference(
									thisModule.dictionary
										->get('FunctionalBlockCompoundTypes')
										->get(fdef.name)
										->get('eoutputs')
										->get(self.feeder.output.name),
									memory.fblocks
										->get(self.feeder.variable_expression.variable.name->protect())
										.instances->get(findices)
								)
							),
							let fdef :chips!function_definition = 
								self.eater.variable_expression.variable.declaration."def" in
							thisModule.MakePortDeclarationReferenceParameter(
								thisModule.dictionary
									->get('FlowConnectorTypes')
									->get(Sequence{'int'})
									->get('r_port'),
								thisModule.MakeComponentSubPortDeclarationReference(
									thisModule.dictionary
										->get('FunctionalBlockCompoundTypes')
										->get(fdef.name)
										->get('einputs')
										->get(self.eater.parameter.name),
									memory.fblocks
										->get(self.eater.variable_expression.variable.name->protect())
										.instances->get(tindices)
								)
							)
						}
					)
				)
			else -- I.E. self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::logical_collective_cast")
				-- TO DO (but less urgent than the rest)
				let a : OclType = 'ATL transformation Error'.debug('Collective cast operator not handled by the compiler yet') in
				memory.dataflows
			endif,
			links = memory.links,
			nodes = memory.nodes,
			connections = memory.connections,
			variables = memory.variables
		}
	endif;


helper context chips!"chips::statements::system::feeding_logical_float" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(ftype:chips!function_definition, dimensions:Sequence(Integer), instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		links: Set(TupleType(src:String,src_index:Integer, trg:String, trg_index:String)),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(
			TupleType(
				channels:Map(String,String),
				contextuals:Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration)))
			)
		))),
		connections: Set(TupleType(from_ob:String,from_index:Sequence(Integer),from_chan:String, to_ob:String,to_index:Sequence(Integer), to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	if Sequence{
			chips!"chips::systemspecific::expressions::feeder::float_logical_output",
			chips!"chips::systemspecific::expressions::feeder::logical_collective_cast"
		}->forAll( feeder_type | not self.feeder.oclIsTypeOf(feeder_type)) then
		self->handleSystemExpressions(memory)
	else
		Tuple {
			fblocks = memory.fblocks,
			dataflows =
			if self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::float_logical_output") then
				let fdim : Sequence(Integer) = self.feeder.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
				let findices : Sequence(Integer) = self.feeder.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(fdim) in
				let tdim : Sequence(Integer) = self.eater.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
				let tindices : Sequence(Integer) = self.eater.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(tdim) in
				memory.dataflows->including(
					Tuple{
						fcomp= self.feeder.variable_expression.variable.name,
						findex = findices,
						fparam= self.feeder.output.name,
						tcomp= self.eater.variable_expression.variable.name,
						tindex= tindices,
						tparam= self.eater.parameter.name
					},
					thisModule.MakeConnectorDeclaration(
						'from_'+self.feeder.variable_expression.variable.name->protect()
						+'_'+findices.toString()+'_'+self.feeder.output.name
						+'_to_'+self.eater.variable_expression.variable.name->protect()
						+'_'+ tindices.toString()+'_'+self.eater.parameter.name,
						thisModule.MakeFlowConnectorType(Sequence{'float'}),
						Sequence{
							let fdef : chips!function_definition = 
								self.feeder.variable_expression.variable.declaration."def" in
							thisModule.MakePortDeclarationReferenceParameter(
								thisModule.dictionary
									->get('FlowConnectorTypes')
									->get(Sequence{'float'})
									->get('s_port'),
								thisModule.MakeComponentSubPortDeclarationReference(
									thisModule.dictionary
										->get('FunctionalBlockCompoundTypes')
										->get(fdef.name)
										->get('eoutputs')
										->get(self.feeder.output.name),
									memory.fblocks
										->get(self.feeder.variable_expression.variable.name->protect())
										.instances->get(findices)
								)
							),
							let fdef :chips!function_definition = 
								self.eater.variable_expression.variable.declaration."def" in
							thisModule.MakePortDeclarationReferenceParameter(
								thisModule.dictionary
									->get('FlowConnectorTypes')
									->get(Sequence{'float'})
									->get('r_port'),
								thisModule.MakeComponentSubPortDeclarationReference(
									thisModule.dictionary
										->get('FunctionalBlockCompoundTypes')
										->get(fdef.name)
										->get('einputs')
										->get(self.eater.parameter.name),
									memory.fblocks
										->get(self.eater.variable_expression.variable.name->protect())
										.instances->get(tindices)
								)
							)
						}
					)
				)
			else -- I.E. self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::logical_collective_cast")
				-- TO DO (but less urgent than the rest)
				let a : OclType = 'ATL transformation Error'.debug('Collective cast operator not handled by the compiler yet') in
				memory.dataflows
			endif,
			links = memory.links,
			nodes = memory.nodes,
			connections = memory.connections,
			variables = memory.variables
		}
	endif;


