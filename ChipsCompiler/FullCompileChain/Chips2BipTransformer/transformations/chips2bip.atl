-- -- Flow control structures interpretation in system section
-- -------------------------------------------

helper context chips!"chips::statements::system::foreach" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let expr : TupleType(name:String, type: String, value:Sequence(OclAny), dims:Sequence(Integer)) = self.iterable_expr.evaluate(memory) in
	let iterable : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	Tuple{
		name=self.iterator.variable.name,
		type=
			if self.iterator.oclIsKindOf(chips!"chips::statements::system::int_declaration") then
				'int'
			else
				if self.iterator.oclIsKindOf(chips!"chips::statements::system::float_declaration") then
					'float'
				else 
					if self.iterator.oclIsKindOf(chips!"chips::statements::system::bool_declaration") then
						'bool'
					else 
						OclUndefined
					endif
				endif
			endif,
		value = expr.value,
		dims = expr.dims
	} in
	iterable.value->iterate(
		iterator ; 
		m1: TupleType(
			fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
			connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
		) = memory |
		let m1_prime : TupleType(
			fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
			connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
		) = self.statements->iterate( 
			stt ; 
			m2: TupleType(
				fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
				connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = Tuple{
					fblocks = m1.fblocks,
					dataflows = m1.dataflows,
					nodes = m1.nodes,
					connections = m1.connections,
					variables = m1.variables->including(Tuple{
						name=self.iterator.variable.name,
						value=Sequence{iterator},
						type=iterable.type,
						dims=
						if iterable.dims->size()>=2 then 
							iterable.dims->subSequence(2,iterable.dims->size())			
						else 
							if iterable.dims->size() = 1 then
								Sequence{1}
							else
								OclUndefined -- what happened??? How did you get here?
							endif
						endif
					})
				} | 
			stt.evaluate(m2)
		) in
		Tuple{
			fblocks = m1_prime.fblocks,
			dataflows = m1_prime.dataflows,
			nodes = m1_prime.nodes,
			connections = m1_prime.connections,
			variables = m1_prime.variables->reject(e | (e.name = self.iterator.variable.name) and (e.type = iterable.type))
		}
	);


helper context chips!"chips::statements::system::if" def :
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(memory).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
				connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	else
		memory
	endif;

helper context chips!"chips::statements::system::if_else" def :
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let condition : Boolean = self.condition.evaluate(memory).value->get(0) in
	if (condition) then 
		self.if_section.if_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
				connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	else
		self.else_section.else_statements->iterate(
			stt ;
			m1: TupleType(
				fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
				dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
				nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
				connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
				variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
			) = memory |
			stt.evaluate(m1)
		)
	endif;

-- -- feeding interpretation in system section
-- ----------------------------------------------------

helper context chips!"chips::statements::system::feeding_physical_int" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = Tuple {
		fblocks = memory.fblocks,
		dataflows =
		if self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::int_physical_output") then 
			let fdim : Sequence(Integer) = self.feeder.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
			let findices : Sequence(Integer) = self.feeder.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(fdim) in
			let tdim : Sequence(Integer) = self.eater.variable.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
			let tindices : Sequence(Integer) = self.eater.variable.index->collect( i | i.evaluate(memory).value->get(0))->linearize(tdim) in
			memory.dataflows->including(
				Tuple{
					fcomp= self.feeder.variable_expression.variable.name,
					findex = findices,
					fparam= self.feeder.output.name,
					tcomp= self.eater.variable.variable.name,
					tindex= tindices,
					tparam= self.eater.parameter.name
				},
				thisModule.MakeConnectorDeclaration(
					'from_'+self.feeder.variable_expression.variable.name->protect()
					+'_'+findices.toString()+'_'+self.feeder.output.name
					+'_to_'+self.eater.variable.variable.name->protect()
					+'_'+ tindices.toString()+'_'+self.eater.parameter.name,
					thisModule.MakeFlowConnectorType(Sequence{'int'}),
					Sequence{
						let fdef : chips!function_definition = 
							self.feeder.variable_expression.variable.declaration."def" in
						thisModule.MakePortDeclarationReferenceParameter(
							thisModule.dictionary
								->get('FlowConnectorTypes')
								->get(Sequence{'int'})
								->get('s_port'),
							thisModule.MakeComponentSubPortDeclarationReference(
								thisModule.dictionary
									->get('FunctionalBlockCompoundTypes')
									->get(fdef.name)
									->get('int')
									->get('eoutputs')
									->get(self.feeder.output.name),
								memory.fblocks
									->get(self.feeder.variable_expression.variable.name->protect())
									->get(findices)
							)
						),
						let fdef :chips!function_definition = 
							self.eater.variable.variable.declaration."def" in
						thisModule.MakePortDeclarationReferenceParameter(
							thisModule.dictionary
								->get('FlowConnectorTypes')
								->get(Sequence{'int'})
								->get('r_port'),
							thisModule.MakeComponentSubPortDeclarationReference(
								thisModule.dictionary
									->get('FunctionalBlockCompoundTypes')
									->get(fdef.name)
									->get('einputs')
									->get(self.eater.parameter.name),
								memory.fblocks
									->get(self.eater.variable.variable.name->protect())
									->get(tindices)
							)
						)
					}
				)
			)
		else 
			if self.feeder.oclIsTypeOf(chips!"chips::systemspecific::expressions::feeder::physical_collective_cast") then
				-- TO DO (but less urgent than the rest)
