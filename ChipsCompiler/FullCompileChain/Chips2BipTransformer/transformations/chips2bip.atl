helper context chips!"chips::rvalues::primitive::function" def : evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer)) = 
	let params: Sequence(TupleType(name:String, type:String,value:Sequence(OclAny),dims:Sequence(Integer))) 
			= self.parameters->collect(e | e.evaluate(node_data)) in
	let dimensions : Sequence(Integer) = params->collect(p | p.value->get(0)) in
	if (self.name = 'zeros') then
		Tuple{
			name = 'zeros',
			type = 'int',
			value = thisModule.zeros(dimensions),
			dims = dimensions
		}
	else 
		if(self.name = 'ones') then
			Tuple{
				name = 'ones',
				type = 'int',
				value = thisModule.ones(dimensions),
				dims = dimensions
			}
		else 
			if(self.name = 'range') then
				Tuple{
					name = 'range',
					type = 'int',
					value = thisModule.range(dimensions),
					dims = dimensions
				}
			else 
				let a : OclAny = 'ATL transformation Error'.debug('Unrecogized function name '+self.name) in
				Tuple{
					name = 'fcall',
					type = 'error',
					value = Sequence{0},
					dims = Sequence{1}
				}
			endif
		endif
	endif;


