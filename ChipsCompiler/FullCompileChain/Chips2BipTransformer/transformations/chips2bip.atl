-- -- assignment of primitive variables in system context
-- --------------------------------------------------------

helper context TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) def :
	getIndexInterval(index :Sequence(Integer)) : 
	TupleType(start:Integer, end:Integer)
	= 
	if index->isEmpty() then
		if self.dims->isEmpty() then
			Tuple{start = 0, end = 0}
		else
			Tuple{start = 0, end = thisModule.ones(Sequence{self.dims->size()})->linearize(self.dims)}
		endif
	else
		let startindex : Integer = index
			->union(thisModule.zeros(Sequence{self.dims->size() - index->size()}))
			->linearize(self.dims) in
		let endindex : Integer = index
			->union(thisModule.ones(Sequence{self.dims->size() - index->size()}))
			->linearize(self.dims) in
		Tuple{start = startindex, end = endindex}
	endif;

helper def : variableassignededupdate(assignment:OclAny, memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer))) = 
	if memory.variables->exists(e | e.name = assignment.lvalue.variable.name->protect()) then
		-- do the assignment

		let lvalue : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
			= memory.variables->any(e | e.name = assignment.lvalue.variable.name->protect()) in
		
		let lvalindexinterval : TupleType(start:Integer, end:Integer) =
			lvalue->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(memory).value->get(0))) in

		if 	assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::system::int_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::system::float_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::system::bool_variable_expression") then
			let rvalue :  TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
				= memory.variables->any(e | e.name=assignment.rvalue.variable.name) in

			let rvalindexinterval : TupleType(start:Integer, end:Integer) =
				memory.variables->any(e | e.name=assignment.rvalue.variable.name)
				->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(memory).value->get(0))) in

			memory.variables->excluding(lvalue)->including(
				Tuple{
					name=lvalue.name,
					type=lvalue.type,
					value=
					if (lvalindexinterval.start = 0 ) then 
						if (lvalindexinterval.end = lvalue.value->size()-1) then 
							rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1)
						else
							rvalue.value->subSequence(1, rvalindexinterval.start+1)
							->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
						endif 
					else
						if (lvalindexinterval.end = lvalue.value->size()-1) then 
							lvalue.value->subSequence(1,lvalindexinterval.start+1)
							->union(rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1))
						else
							lvalue.value->subSequence(1,lvalindexinterval.start)
							->union(rvalue.value->subSequence(rvalindexinterval.start + 1, rvalindexinterval.end + 1))
							->union(lvalue.value->subSequence(lvalindexinterval.end+1, lvalue.value->size()))
						endif
					endif,
					dims=lvalue.dims							
				}
			)
		else
			let newval : Integer = assignment.rvalue.evaluate(memory).value->get(0) in 

			memory.variables->excluding(lvalue)->including(
				Tuple{
					name=lvalue.name,
					type=lvalue.type,
					value=
					if (lvalindexinterval.start = 0 ) then 
						if (lvalindexinterval.end = lvalue.value->size()-1) then 
							thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
						else
							thisModule.ones(Sequence{lvalindexinterval.start+1})->collect(one | one*newval)
							->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
						endif 
					else
						if (lvalindexinterval.end = lvalue.value->size()-1) then 
							thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
							->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
						else
							lvalue.value->subSequence(1,lvalindexinterval.start)
							->union(thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval))
							->union(lvalue.value->subSequence(lvalindexinterval.end+1, lvalue.value->size()))
						endif
					endif,
					dims=lvalue.dims							
				}
			)
		endif
	else
		let error : OclAny = OclUndefined.debug('the lvalue of this assignment is not found...') in 
		memory.variables
	endif;

helper context chips!"chips::statements::system::int_assignment" def : 
	evaluate(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	Tuple {
		fblocks = memory.fblocks,
		dataflows = memory.dataflows,
		nodes = memory.nodes,
		connections = memory.connections,
		variables = thisModule.variableassignededupdate(self,memory)
	};

