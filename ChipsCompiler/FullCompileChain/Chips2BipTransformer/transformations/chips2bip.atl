helper context chips!"chips::statements::system::feeding_logical_int" def : 
	handleSystemExpressions(memory:TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))),
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	)) : TupleType(
		fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
		dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
		nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
		connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
		variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
	) = 
	let expression : OclAny = self.feeder.evaluate(memory) in
	if expression.dims->get(0) <> 1 then 
		let error : OclAny = expression.debug('Can\'t convert multi-valued expression into a constant logical input') in
		memory
	else
		let name : String = 'direct_expression'+thisModule.id->toString() in
		let partial_next_mem : TupleType(
			fblocks: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(bip!ComponentDeclaration))), 
			dataflows: Map(TupleType(fcomp:String,fparam:String,tcomp:String,tparam:String),bip!ConnectorDeclaration),
			nodes: Map(String,TupleType(dimensions:Sequence(Integer),instances:Sequence(Map(String,TupleType(channeltype:String, available:Boolean))))),
			connections: Set(TupleType(from_ob:String,from_chan:String, to_ob:String, to_chan:String)),
			variables:Sequence(TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)))
		) =  Tuple{
			fblocks = memory.fblocks
				->including(
					name,
					Tuple{
						dimensions = Sequence{1},
						instances = Sequence{
							thisModule.MakeIntegerConstantDeclaration(
								expression.value->get(0),
								thisModule.id
							)
						}
					}
				),
			dataflows = memory.dataflows,
			nodes = memory.nodes,
			connections = memory.connections,
			variables = memory.variables
		} in
		Tuple{
			fblocks = partial_next_mem.fblocks,
			dataflows = 
				let tdim : Sequence(Integer) = self.eater.variable_expression.variable.dimensions->collect( e | e.evaluate(memory).value->get(0)) in
				let tindices : Sequence(Integer) = self.eater.variable_expression.index->collect( i | i.evaluate(memory).value->get(0))->linearize(tdim) in
				partial_next_mem.dataflows->including(
				Tuple{
					fcomp= name,
					findex = 0,
					fparam= 'out',
					tcomp= self.eater.variable_expression.variable.name,
					tindex= tindices,
					tparam= self.eater.parameter.name
				},
				thisModule.MakeConnectorDeclaration(
					'from_'+name
					+'_to_'+self.eater.variable_expression.variable.name->protect()
					+'_'+ tindices.toString()+'_'+self.eater.parameter.name,
					thisModule.MakeFlowConnectorType(Sequence{'int'}),
					Sequence{
						thisModule.MakePortDeclarationReferenceParameter(
							thisModule.dictionary
								->get('FlowConnectorTypes')
								->get(Sequence{'int'})
								->get('s_port'),
							thisModule.MakeComponentSubPortDeclarationReference(
								thisModule.dictionary
									->get('ConstantAtomTypes')
									->get('int')
									->get('aepd'),
								partial_next_mem.fblocks->get(name).instances->get(0)
							)
						),
						let fdef :chips!function_definition = 
							self.eater.variable_expression.variable.declaration."def" in
						thisModule.MakePortDeclarationReferenceParameter(
							thisModule.dictionary
								->get('FlowConnectorTypes')
								->get(Sequence{'int'})
								->get('r_port'),
							thisModule.MakeComponentSubPortDeclarationReference(
								thisModule.dictionary
									->get('FunctionalBlockCompoundTypes')
									->get(fdef.name)
									->get('einputs')
									->get(self.eater.parameter.name),
								partial_next_mem.fblocks
									->get(self.eater.variable_expression.variable.name->protect())
									.instances->get(tindices)
							)
						)
					}
				)
			),
			nodes = partial_next_mem.nodes,
			connections = partial_next_mem.connections,
			variables = partial_next_mem.variables
		}
	endif;


