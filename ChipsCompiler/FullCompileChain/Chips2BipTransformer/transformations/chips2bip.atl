);

helper context TupleType(
	temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
	channels:Map(String,String),
	contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : assignEvaluatedRvalToLvalVariable(lvalue:OclAny, lvalindexinterval:TupleType(start:Integer, end:Integer), newval:OclAny)
: Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
 = self.temp_memory.variables->excluding(lvalue)->including(
	Tuple{
		name=lvalue.name,
		type=lvalue.type,
		value=
		if (lvalindexinterval.start = 0 ) then 
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
			else
				thisModule.ones(Sequence{lvalindexinterval.start+1})->collect(one | one*newval)
				->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
			endif 
		else
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
				->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
			else
				lvalue.value->subSequence(1,lvalindexinterval.start)
				->union(thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval))
				->union(lvalue.value->subSequence(lvalindexinterval.end+1, lvalue.value->size()))
			endif
		endif,
		dims=lvalue.dims							
	}
);

helper context TupleType(
	temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
	channels:Map(String,String),
	contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
) def : assignEvaluatedRvalToLvalContextual(lvalue:OclAny, lvalindexinterval:TupleType(start:Integer, end:Integer), newval:OclAny)
: Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
 = self.contextuals->excluding(lvalue)->including(
	Tuple{
		name=lvalue.name,
		type=lvalue.type,
		value=
		if (lvalindexinterval.start = 0 ) then 
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
			else
				thisModule.ones(Sequence{lvalindexinterval.start+1})->collect(one | one*newval)
				->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
			endif 
		else
			if (lvalindexinterval.end = lvalue.value->size()-1) then 
				thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval)
				->union(lvalue.value->subSequence(lvalindexinterval.start+1, lvalue.value->size()))
			else
				lvalue.value->subSequence(1,lvalindexinterval.start)
				->union(thisModule.ones(Sequence{lvalue.value->size()})->collect(one | one*newval))
				->union(lvalue.value->subSequence(lvalindexinterval.end+1, lvalue.value->size()))
			endif
		endif,
		dims=lvalue.dims							
	}
);

helper def : primitiveassignededupdate(
	assignment:OclAny, 
	node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 

	let new_variables : Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer))) = 
	if node_data.temp_memory.variables->exists(e | e.name = assignment.lvalue.variable.name->protect()) then
		-- do the assignment
		let lvalue : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
			= node_data.temp_memory.variables->any(e | e.name = assignment.lvalue.variable.name->protect()) in
		
		let lvalindexinterval : TupleType(start:Integer, end:Integer) =
			lvalue->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

		if assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::int_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::float_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::bool_variable_expression") then
			
			let rvalue :  TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
				= node_data.temp_memory.variables->any(e | e.name=assignment.rvalue.variable.name) in

			let rvalindexinterval : TupleType(start:Integer, end:Integer) =
				rvalue->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

			node_data->assignRvalToLvalVariable( lvalue, lvalindexinterval,rvalue, rvalindexinterval)
		else
			if assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_int_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_float_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_bool_expression") then 
				let rvalue :  TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
					= node_data.contextuals->any(e | e.name=assignment.rvalue.variable.name) in

				let rvalindexinterval : TupleType(start:Integer, end:Integer) =
					rvalue->getIndexInterval( assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

				node_data->assignRvalToLvalVariable( lvalue, lvalindexinterval, rvalue, rvalindexinterval)
			else 
				let newval : Integer = assignment.rvalue.evaluate(node_data).value->get(0) in 
				node_data->assignEvaluatedRvalToLvalVariable(lvalue, lvalindexinterval, newval)
			endif
		endif
	else
		node_data.temp_memory.variables
	endif in

	let new_contextuals : Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer))) = 
	if node_data.contextuals->exists(e | e.name = assignment.lvalue.variable.name->protect()) then
		-- do the assignment
		let lvalue : TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
			= node_data.contextuals->any(e | e.name = assignment.lvalue.variable.name->protect()) in
		
		let lvalindexinterval : TupleType(start:Integer, end:Integer) =
			lvalue->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

		if assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::int_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::float_variable_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::bool_variable_expression") then
			
			let rvalue :  TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
				= node_data.temp_memory.variables->any(e | e.name=assignment.rvalue.variable.name) in

			let rvalindexinterval : TupleType(start:Integer, end:Integer) =
				rvalue->getIndexInterval(assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

			node_data->assignRvalToLvalContextual( lvalue, lvalindexinterval,rvalue, rvalindexinterval)
		else
			if assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_int_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_float_expression")
			or assignment.rvalue.oclIsTypeOf(chips!"chips::xvalues::primitive::contextual_bool_expression") then 
				let rvalue :  TupleType(name:String,type:String,value:Sequence(OclAny),dims:Sequence(Integer)) 
					= node_data.contextuals->any(e | e.name=assignment.rvalue.variable.name) in

				let rvalindexinterval : TupleType(start:Integer, end:Integer) =
					rvalue->getIndexInterval( assignment.lvalue.index->collect(e | e.evaluate(node_data).value->get(0))) in

				node_data->assignRvalToLvalContextual( lvalue, lvalindexinterval, rvalue, rvalindexinterval)
			else 
				let newval : Integer = assignment.rvalue.evaluate(node_data).value->get(0) in 
				node_data->assignEvaluatedRvalToLvalContextual(lvalue, lvalindexinterval, newval)
			endif
		endif
	else
		node_data.temp_memory.variables
	endif in

	Tuple{
		temp_memory=Tuple{variables=new_variables},
		channels=node_data.channels,
		contextuals=new_contextuals
	};

helper context chips!"chips::statements::primitive::int_assignment" def : 
	evaluate(node_data : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	)) : TupleType(
		temp_memory : TupleType(variables:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))),
		channels:Map(String,String),
		contextuals:Sequence(TupleType(name:String,type:String,value:OclAny,dims:Sequence(Integer)))
	) = 
	thisModule.primitiveassignededupdate(self,node_data);

