	let operand : TupleType(name:String, value:Sequence(OclAny), type:String, dims:Sequence(Integer)) = self.left_operand->evaluate(memory) in
	if  (operand.type = 'int') then
		Tuple{
			name='cast',
			type= 'float',
			dims= operand.dims,
			value= operand.value
		}
	else
		let a : OclType = 'ATL transformation Error'.debug('Cannot cast '+operand.name+' as float') in
		Tuple{
			name='cast error',
			type= 'float',
			dims= Sequence{1},
			value= Sequence{0}
		}
	endif;

