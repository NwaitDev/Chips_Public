         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type flow_int_t (int_port_t s, int_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    atom type Drone_core (const bool starts)
    
        
        data chips_float u_aidd
        
        data chips_float dt_aidd
        
        data chips_float m_aidd
        
        data chips_float altitude_aidd
        
        data chips_float altitude__max_aidd
        
        data chips_float velocity_aidd
        
        data chips_float prevError_aidd
        
        data chips_float GRAVITY_aidd
        
        data chips_float KP_aidd
        
        data chips_float DRAG__COEFF_aidd
        
        data chips_float update_aidd
        
        
        export port float_port_t send_aipd(update_aidd)
        
        export port floatfloat_port_t recv_aipd(u_aidd, dt_aidd)
        
        port port_t start_aipd()
        
        port port_t then_aipd()
        
        place INIT, RECEIVE, THEN, SEND
        initial to INIT
            
            on start_aipd
                from INIT
                to RECEIVE
                provided (true)
            
            on start_aipd
                from INIT
                to SEND
                provided (true)
            
            on recv_aipd
                from RECEIVE
                to THEN
                provided (true)
            
            on then_aipd
                from THEN
                to SEND
                provided (true)
            
            on send_aipd
                from SEND
                to RECEIVE
                provided (true)
    
    
    end

    
    atom type PID_core (const bool starts)
    
        
        data chips_float target_aidd
        
        data chips_float current_aidd
        
        data chips_float kp_aidd
        
        data chips_float ki_aidd
        
        data chips_float kd_aidd
        
        data chips_float minOutput_aidd
        
        data chips_float maxOutput_aidd
        
        data chips_float dt_aidd
        
        data chips_float prevError_aidd
        
        data chips_float proportional_aidd
        
        data chips_float integral_aidd
        
        data chips_float derivative_aidd
        
        data chips_float correction_aidd
        
        
        export port float_port_t send_aipd(update_aidd)
        
        export port floatfloat_port_t recv_aipd(u_aidd, dt_aidd)
        
        port port_t start_aipd()
        
        port port_t then_aipd()
        
        place INIT, RECEIVE, THEN, SEND
        initial to INIT
            
            on start_aipd
                from INIT
                to RECEIVE
                provided (true)
            
            on start_aipd
                from INIT
                to SEND
                provided (true)
            
            on recv_aipd
                from RECEIVE
                to THEN
                provided (true)
            
            on then_aipd
                from THEN
                to SEND
                provided (true)
            
            on send_aipd
                from SEND
                to RECEIVE
                provided (true)
    
    
    end

    
    atom type int_buffer_t ()
    
        
        data chips_int int_data
        
        
        export port int_port_t in()
        
        export port int_port_t out(int_data)
        
        place DATA_RECEIVING, DATA_SENDING
        initial to DATA_RECEIVING
            
            on out
                from DATA_SENDING
                to DATA_RECEIVING
            
            on in
                from DATA_RECEIVING
                to DATA_SENDING
    
    
    end

    
