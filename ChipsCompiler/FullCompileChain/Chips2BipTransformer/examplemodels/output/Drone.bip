        component float_buffer_t float7_bd ()
    
        connector many2one_floatfloatfloatfloatfloatfloatfloatfloat_t floatfloatfloatfloatfloatfloatfloatfloat_input_connector (float0_bd.exp_out, float1_bd.exp_out, float2_bd.exp_out, float3_bd.exp_out, float4_bd.exp_out, float5_bd.exp_out, float6_bd.exp_out, float7_bd.exp_out)
    
        export port float0_bd.exp_in as float_input_0_cepd
