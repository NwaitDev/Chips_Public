
package Drone



    
    extern data type chips_int
    
    extern data type chips_float
    
    extern data type chips_bool




    
    port type int_port_t (chips_int v0)
    
    port type float_port_t (chips_float v0)
    
    port type bool_port_t (chips_bool v0)
    
    port type port_t ()
    
    port type floatfloat_port_t (chips_float v0, chips_float v1)
    
    port type floatfloatfloatfloatfloatfloatfloatfloat_port_t (chips_float v0, chips_float v1, chips_float v2, chips_float v3, chips_float v4, chips_float v5, chips_float v6, chips_float v7)

    
    connector type many2one_floatfloat_t (float_port_t p0_cppd, float_port_t p1_cppd)
        data chips_float v0
        data chips_float v1
        export port floatfloat_port_t r_exported_port(v0, v1)
        define (p0_cppd
         p1_cppd
        )
    
        on p0_cppd p1_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
                v1 = p1_cppd.v0;
            }
    end

    
    connector type many2one_floatfloatfloatfloatfloatfloatfloatfloat_t (float_port_t p0_cppd, float_port_t p1_cppd, float_port_t p2_cppd, float_port_t p3_cppd, float_port_t p4_cppd, float_port_t p5_cppd, float_port_t p6_cppd, float_port_t p7_cppd)
        data chips_float v0
        data chips_float v1
        data chips_float v2
        data chips_float v3
        data chips_float v4
        data chips_float v5
        data chips_float v6
        data chips_float v7
        export port floatfloatfloatfloatfloatfloatfloatfloat_port_t r_exported_port(v0, v1, v2, v3, v4, v5, v6, v7)
        define (p0_cppd
         p1_cppd
         p2_cppd
         p3_cppd
         p4_cppd
         p5_cppd
         p6_cppd
         p7_cppd
        )
    
        on p0_cppd p1_cppd p2_cppd p3_cppd p4_cppd p5_cppd p6_cppd p7_cppd
            provided (true)
            up {
                v0 = p0_cppd.v0;
                v1 = p1_cppd.v0;
                v2 = p2_cppd.v0;
                v3 = p3_cppd.v0;
                v4 = p4_cppd.v0;
                v5 = p5_cppd.v0;
                v6 = p6_cppd.v0;
                v7 = p7_cppd.v0;
            }
    end

    
    connector type one2many_float_t (float_port_t p0_cppd)
        data chips_float v0
        export port float_port_t s_exported_port(v0)
        define (p0_cppd
        )
    
        on p0_cppd
            provided (true)
            down {
                p0_cppd.v0 = v0;
            }
    end

    
    connector type flow_floatfloat_t (floatfloat_port_t s, floatfloat_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
                r.v1 = s.v1;
            }
    end

    
    connector type flow_floatfloatfloatfloatfloatfloatfloatfloat_t (floatfloatfloatfloatfloatfloatfloatfloat_port_t s, floatfloatfloatfloatfloatfloatfloatfloat_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
                r.v1 = s.v1;
                r.v2 = s.v2;
                r.v3 = s.v3;
                r.v4 = s.v4;
                r.v5 = s.v5;
                r.v6 = s.v6;
                r.v7 = s.v7;
            }
    end

    
    connector type flow_float_t (float_port_t s, float_port_t r)
        define (s
         r
        )
    
        on s r
            provided (true)
            down {
                r.v0 = s.v0;
            }
    end

    
    connector type flow_bool_t (bool_port_t s, bool_port_t r)
