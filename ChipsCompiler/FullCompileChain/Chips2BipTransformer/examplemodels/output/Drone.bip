    compound type float_output_buffer_t ()
    
        component float_buffer_t float0_bd ()
    
        connector one2many_float_t float_output_connector (float0_bd.exp_in)
    
        export port float0_bd.exp_out as float_output_0_cepd
        export port float_output_connector.s_exported_port as one_cepd
    
    end

    
    compound type SYSTEM_COMPOUND ()
    
        component int_constant_t cst3 (0.1)
        component int_constant_t cst2 (0.0)
        component int_constant_t cst5 (0.0)
        component int_constant_t cst4 (5.0)
        component PID_compoundtype ctrl_1_compounddecl (true)
        component int_constant_t cst1 (0.6)
        component int_constant_t cst0 (1.5)
        component int_constant_t cst7 (0.1)
        component int_constant_t cst6 (15.0)
        component Drone_compoundtype drone_1_compounddecl (true)
    
        connector flow_float_t from__direct__expression6__to__ctrl__0__maxOutput_cd (cst6.output_aepd, ctrl_1_compounddecl.maxOutput_input_cepd)
        connector flow_float_t from__drone__0__update__to__ctrl__0__current_cd (drone_1_compounddecl.update_output_cepd, ctrl_1_compounddecl.current_input_cepd)
        connector flow_float_t from__direct__expression3__to__ctrl__0__dt_cd (cst3.output_aepd, ctrl_1_compounddecl.dt_input_cepd)
        connector flow_float_t from__direct__expression5__to__ctrl__0__minOutput_cd (cst5.output_aepd, ctrl_1_compounddecl.minOutput_input_cepd)
        connector flow_float_t from__ctrl__0__correction__to__drone__0__u_cd (ctrl_1_compounddecl.correction_output_cepd, drone_1_compounddecl.u_input_cepd)
        connector flow_float_t from__direct__expression1__to__ctrl__0__ki_cd (cst1.output_aepd, ctrl_1_compounddecl.ki_input_cepd)
        connector flow_float_t from__direct__expression7__to__drone__0__dt_cd (cst7.output_aepd, drone_1_compounddecl.dt_input_cepd)
        connector flow_float_t from__direct__expression2__to__ctrl__0__kd_cd (cst2.output_aepd, ctrl_1_compounddecl.kd_input_cepd)
        connector flow_float_t from__direct__expression4__to__ctrl__0__target_cd (cst4.output_aepd, ctrl_1_compounddecl.target_input_cepd)
        connector flow_float_t from__direct__expression0__to__ctrl__0__kp_cd (cst0.output_aepd, ctrl_1_compounddecl.kp_input_cepd)
    
    end
