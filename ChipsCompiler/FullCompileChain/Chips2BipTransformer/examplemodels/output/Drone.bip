    compound type Drone_compoundtype (const chips_bool starts_componentdataparameterdeclaration)
    
        component Drone_core core (starts_componentdataparameterdeclaration)
        component floatfloat_input_buffer_t Drone_input_buffer_buffercompounddecl ()
        component float_output_buffer_t Drone_output_buffer_buffercompounddecl ()
    
        connector flow_floatfloat_t input__to__core_cd (Drone_input_buffer_buffercompounddecl.one_cepd, core.recv_aepd)
        connector flow_float_t core__to__output_cd (core.send_aepd, Drone_output_buffer_buffercompounddecl.one_cepd)
    
        export port Drone_input_buffer_buffercompounddecl.float_input_1_cepd as dt_input_cepd
        export port Drone_input_buffer_buffercompounddecl.float_input_0_cepd as u_input_cepd
        export port Drone_output_buffer_buffercompounddecl.float_output_0_cepd as update_output_cepd
    
    end

    
    compound type PID_compoundtype (const chips_bool starts_componentdataparameterdeclaration)
    
        component PID_core core (starts_componentdataparameterdeclaration)
        component floatfloatfloatfloatfloatfloatfloatfloat_input_buffer_t PID_input_buffer_buffercompounddecl ()
        component float_output_buffer_t PID_output_buffer_buffercompounddecl ()
    
        connector flow_floatfloatfloatfloatfloatfloatfloatfloat_t input__to__core_cd (PID_input_buffer_buffercompounddecl.one_cepd, core.recv_aepd)
        connector flow_float_t core__to__output_cd (core.send_aepd, PID_output_buffer_buffercompounddecl.one_cepd)
    
        export port PID_input_buffer_buffercompounddecl.float_input_7_cepd as dt_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_5_cepd as minOutput_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_1_cepd as current_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_6_cepd as maxOutput_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_2_cepd as kp_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_4_cepd as kd_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_3_cepd as ki_input_cepd
        export port PID_input_buffer_buffercompounddecl.float_input_0_cepd as target_input_cepd
        export port PID_output_buffer_buffercompounddecl.float_output_0_cepd as correction_output_cepd
    
    end

    
    compound type floatfloat_input_buffer_t ()
    
        component float_buffer_t float0_bd ()
        component float_buffer_t float1_bd ()
    
        connector many2one_floatfloat_t floatfloat_input_connector (float0_bd.exp_out, float1_bd.exp_out)
    
        export port float0_bd.exp_in as float_input_0_cepd
        export port float1_bd.exp_in as float_input_1_cepd
        export port floatfloat_input_connector.r_exported_port as one_cepd
    
    end

    
