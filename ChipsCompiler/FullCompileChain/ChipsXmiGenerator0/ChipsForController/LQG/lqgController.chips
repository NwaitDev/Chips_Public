logical LQGController(float targetValues, float currentOutput, float currentState, 
                      int nStates, int nInputs, int nOutputs, float Al, float Bl, float Ql, float Rl
                      float Fk, float Bk, float Hk, float Qk, float Rk) init {

    int _n = nStates;
    int _m = nInputs;
    int _p = nOutput;

    float[_p] _r = (float)zeros(_p);
    float[_p] _y = (float)zeros(_p);
    float[_n] _x_hat = (float)zeros(_n);
    float[_n] _u = (float)zeros(_n);
    float[_n] _last_applied_u = (float)zeros(_n);

}then{

    float est = KalmanFilter(_last_applied_u, currentOutput, currentState, nStates, nInputs, nOutputs, Fk, Bk, Hk, Qk, Rk).getControl;
    _x_hat = est;

    float ucmd = LQRController(_x_hat, currentOutput, currentState, nStates, nInputs, nOutput, Al, Bl, Ql, Rl).control;
    _u = ucmd;
    _last_applied_u = _u;

} -> correction(_u)
-> getEstimatorCovariance(KalmanFilter(_last_applied_u, currentOutput, currentState, nStates, nInputs, nOutputs, Fk, Bk, Hk, Qk, Rk).getCovariance)
-> getEstimatorKalmanGain(KalmanFilter(_last_applied_u, currentOutput, currentState, nStates, nInputs, nOutputs, Fk, Bk, Hk, Qk, Rk).getKalmanGain)
-> getEstimatorSigma(KalmanFilter(_last_applied_u, currentOutput, currentState, nStates, nInputs, nOutputs, Fk, Bk, Hk, Qk, Rk).getUncertainy)