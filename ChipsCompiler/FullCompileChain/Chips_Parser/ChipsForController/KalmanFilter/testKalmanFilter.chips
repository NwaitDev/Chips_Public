logical Clock() init {
    int time = 0;
}then{
    time = time + 1;
} -> time(time)

logical Acceleration(int steps) init {
    float acc = 0.05;
}then{
    if(step < 60){
        acc = 0.3;
    }else if(step < 120){
        acc = -0.15;
    }else{
        acc = 0.05;
    }
} -> acceleration(acc)

spread() spreadValue among Car {}
-> @(intput)
-> default(intput)

physical Car(float control_acc, float dt, float sigma_proc) init {
    float _true_pos = 0.;
    float _true_vel = 0.;
    float _rand = random();
    float _proc_noise  = normal_distribution(_rand, 0.0, sigma_proc);
    float _process_acc = 0.;
}then{

    _process_acc = control_acc + proc_noise;
    _true_pos = _true_pos + _true_vel * dt + 0.5 * _process_acc * dt * dt;
    _true_vel = _true_vel + process_acc * dt
} -> true_pos(_true_pos)
-> true_vel(_true_vel)

logical Noise(float true_pos, float sigma_meas) init {

    float rand = random();
    float meas_noise = normal_distribution(rand, 0.0, sigma_meas);

} -> meas_pos(true_pos + meas_noise)

system {

    float dt = 0.1;
    int steps = 180;

    // Bruits
    float sigma_meas = 0.8; // Bruit de mesure sur la position (m)
    float sigma_proc = 0.12; // Perturbation non modélisée (m/s²)

    int n = 2;
    int m = 1;
    int c = 1;

    float[n * n] F = [
        1., dt,
        0., 1.
    ];

    float[n * c] B = [0.5 * dt * dt, dt];

    float[m * n] H = [1., 1.];

    float[n * n] Q = [
        0.02 * 0.02, 0.,
        0.,          0.08 * 0.08 
    ];

    float[m * m] R = [sigma_meas * sigma_meas];

    KalmanFilter kf;
    Clock clock;
    Car car;
    Acceleration acc;
    Noise noise;

    link acc to car;

    kf.nStates(n);
    kf.nInputs(c);
    kf.nOutputs(m);
    kf.F(F);
    kf.B(B);
    kf.H(H);
    kf.Q(Q);
    kf.R(R);

    car.control_acc((spreadValue) acc.acceleration);
    car.dt(dt);
    car.sigma_proc(sigma_proc);

    acc.steps(clock.time);

    noise.true_pos(car.true_pos);
    noise.sigma_meas(sigma_meas);

    kf.currentOutput(noise.meas_pos);
    kf.targetValue((spreadValue) acc.acceleration); 

    kf.compute(dt);

    // Par soucis de simplicité, on considère que tous les outputs vont vers un logger 
    // pour afficher tous les résultats
}