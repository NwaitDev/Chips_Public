// Exemple utiliser par le groupe Model Under Control

logical FirstOrderProcess(float disturbance, float noiseAmplitude, float u) init {

    float m_a = 0.8; // Constante de dissipation
    float m_b = 1.; // Gain du système
    float m_dt = 0.1; // Pas de simulation
    float m_y = 0.; // Etat interne du système

} then {

    float noise;

    m_y = m_dt * (-m_a * m_y + m_b * u + m_disturbance);

    if(random() > 0.5){
        noise = noiseAmplitude + 1;
    }else{
        noise = noiseAmplitude - 1;
    }


} -> measured(m_y + noise)
-> update(m_y)

logical OutputClamp(float value, float min, float max) -> result(clamp(value, min, max))

logical logger(float t, float target, float y, float u) then {
    // Ou utiliser un logger
    print(t+" "+target+" "+y+" "+u);
}

logical Compute(float dt) init {

    float disturbance = 0.;
    float noiseAmplitude = 1.;
    float target = 0.;
    float t = 0.;

}then{

    t = t + dt;

    if(t > 1.){
        target = 100.;
    }

    if(t > 40.){
        disturbance = 5.;
    }

    if(t > 70.){
        disturbance = 8.;
    }

} -> disturbance(disturbance)
-> noiseAmplitude(noiseAmplitude)
-> target(target)
-> time(t)

object Broadcast with {}

spread () spreadValue among Broadcast {} 
-> @(input)
-> default(input)

system {
    float target = 0.;
    float simTime = 1000;

    PIDController ctrl;
    FirstOrderProcess process
    OutputClamp oClamp;
    Compute compute;
    Broadcast broadcaster;

    link compute to broadcaster;
    link ctrl to broadcaster

    oClamp.min(-999999999.);
    oClamp.max(999999999.);

    ctrl.kp(0.6);
    ctrl.ki(0.1);
    ctrl.kd(0.05);
    ctrl.minOutput(0.0);
    ctrl.maxOutput(255.);

    compute.dt(0.1);

    ctrl.targetValue((spreadValue) compute.target);
    
    process.disturbance(compute.disturbance);
    process.noiseAmplitude(compute.noiseAmplitude);

    ctrl.currentValue(process.measured);

    oClamp.value((spreadCorrection) ctrl.correction);

    process.u(oClamp.result);

    logger.t(compute.time);
    logger.target((spreadValue) compute.target);
    logger.y(process.update);
    logger.u((spreadCorrection) ctrl.correction);
}