// Toutes les fonctions sur les matrices n'existe pas en Chips
// La fonction size() n'existe pas encore en Chips


logical LQRController(float targetValues, float currentOutput, float currentState, int nStates, int nInputs, int nOutputs, float A, float B, float Q, float R) init {

    int _n = nStates; // states
    int _m = nInputs; // inputs
    int _p = nOutputs; // outputs

    float[_n * _n] _A = (float)zeros(_n * _n); 
    float[_n * _m] _B = (float)zeros(_n * _m); 
    float[_n * _n] _Q = (float)zeros(_n * _n);
    float[_m * _m] _R = (float)zeros(_m * _m);

    float[_n] _x = (float)zeros(_n);
    float[_p] _y = (float)zeros(_p);
    float[_p] _r = (float)zeros(_p);
    float[_m] _u = (float)zeros(_m);

    float[_m * _n] _K = (float)zeros(_m * _n);

    int _maxIter = 200;
    float _tol = 0.000000001;
    bool _dirtyGain = true;

    for  i in range(_n * _n){
        _A[i] = A[i];
    }

    for i in range(_n * _m){
        _B[i] = B[i];
    }

    for i in range(_n * _n){
        _Q[i] = Q[i];
    }

    for i in range(_m * _m){
        _R[i] = R[i];
    }



}then{

    if(_dirtyGain){

        float[size(Q)] P = Q;
        float[size(A)] At = transpose(A);
        float[size(B)] Bt = transpose(B);

        for it in range(maxIter){
            float[_n*_m] PB = P * B;
            float[_m*_m] BtPB = Bt * PB;
            float[size(R)] S = R + BtPB;
            float[size(S)] Sinv = inv(S);

            float[_n*_n] PA = P * A;
            float[_m*_n] BtPA = Bt * PA;

            float[_n*_m] term = PB * Sinv;
            float[_n*_n] term2 = term * BtPA;

            float[_n*_n] AtPA = At * PA;
            float[size(Q)] nextP = (AtPA - term2) + Q;

            float sum = 0.
            float[size(P)] norm = nextP - P;

            for v in norm{
                sum = sum + v * v;
            }
            float diff = sqrt(sum);
            P = nextP;

            if(diff < tol){
                it = maxIter + 1;
            }
        }

        Bt = transpose(B);
        float[_n*_m] PB = P * B;
        float[_m*_m] BtPB = Bt * PB;
        float[size(R)] S = R + BtPB;
        float[size(S)] Sinv = inv(S);

        float[_n*_n] PA = P*A;
        float[_m*_n] BtPA = Bt * PA;

        _K = Sinv * BtPA;
        _dirtyGain = false;
    }

    float[_n] xvec;

    for i in range(_n){
        xvec[i] = _x[i];
    }

    float[_m] uvec = _K * xvec;

    for i in range(_m){
        _u[i] = -uvec[i];
    }
    

} -> control(_u)