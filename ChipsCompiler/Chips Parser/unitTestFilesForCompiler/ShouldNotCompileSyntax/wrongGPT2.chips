import "network_utils" as net;
import "data_processor" as dp;

pure -> (int sum)
calculateSum(int a, int b) {
    sum = a + b;
}

pure -> (bool isValid)
checkThreshold(int value, int threshold) {
    if (value >= threshold) {
        isValid = true;
    } else {
        isValid = false;
    }
}

virtual -> (float processedData)
dataHandler(int input) init {
    temp = input * 3;
    result = dp.process(temp);
} then {
    this.knobs.gain = 5;
    this.sensors.temperature = 25.0;
}

physical -> (int networkStatus)
networkManager(int packetSize) init {
    net.initialize(packetSize);
} then {
    foreach idx in 100 {
        if (idx % 10 == 0) {
            net.sendPacket(idx);
        } else {
            net.checkConnection(idx);
        }
    }
}

SYSTEM dimensions(8) {
    link deviceA to deviceB;
    foreach i in 20 {
        if (i < 10) {
            result = calculateSum(i, i * 2);
        } else {
            result = dp.compute(i);
        }
    }
    foreach j in 5 {
        this.knobs.calibration = j * 1.5;
    }
    if (this.sensors.temperature > 30) {
        net.alert("High temperature detected");
    } else {
        net.log("Temperature normal");
    }
}")}
  ]
}
