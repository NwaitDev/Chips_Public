<?xml version="1.0" encoding="UTF-8"?>
<chips:program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:chips="http://chips"
    xmlns:chips.definitions="http://chips/defintions"
    xmlns:chips.expressions="http://chips/expressions"
    xmlns:chips.instances="http://chips/instances"
    xsi:schemaLocation="http://chips chips.ecore http://chips/defintions chips.ecore#//definitions http://chips/expressions chips.ecore#//expressions http://chips/instances chips.ecore#//instances">
  <preambles
      xsi:type="chips.definitions:pure_def"
      name="aPureFunction">
    <output>
      <expr
          xsi:type="chips.expressions:binary_expression"
          symbol="*">
        <left
            xsi:type="chips.expressions:binary_expression"
            symbol="-">
          <left
              xsi:type="chips.expressions:variable_expression"
              variable="foo"/>
          <right
              xsi:type="chips.expressions:variable_expression"
              variable="bar"/>
        </left>
        <right
            xsi:type="chips.expressions:binary_expression"
            symbol="-">
          <left
              xsi:type="chips.expressions:variable_expression"
              variable="bar"/>
          <right
              xsi:type="chips.expressions:variable_expression"
              variable="foo"/>
        </right>
      </expr>
    </output>
    <parameters>
      <variable
          xsi:type="chips.instances:float_variable"
          name="foo"/>
      <default_value
          xsi:type="chips.expressions:unary_expression"
          symbol="-">
        <sub_expression
            xsi:type="chips.expressions:direct_float"
            value="15.5"/>
      </default_value>
    </parameters>
    <parameters>
      <variable
          xsi:type="chips.instances:float_variable"
          name="bar"/>
    </parameters>
  </preambles>
</chips:program>
