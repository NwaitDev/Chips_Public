<?xml version="1.0" encoding="UTF-8"?>
<chips:program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:chips="http://chips"
    xmlns:chips.definitions="http://chips/defintions"
    xmlns:chips.expressions="http://chips/expressions"
    xmlns:chips.instances="http://chips/instances"
    xmlns:chips.statements="http://chips/statements"
    xmlns:chips.statements.dataflow="http://chips/statements/dataflow"
    xmlns:chips.statements.node="http://chips/statements/node"
    xsi:schemaLocation="http://chips chips.ecore http://chips/defintions chips.ecore#//definitions http://chips/expressions chips.ecore#//expressions http://chips/instances chips.ecore#//instances http://chips/statements chips.ecore#//statements http://chips/statements/dataflow chips.ecore#//statements/dataflow http://chips/statements/node chips.ecore#//statements/node">
  <preambles
      xsi:type="chips.definitions:physical_def"
      name="aPhysicalCounter"
      node="//@preambles.1">
    <init_statements
        xsi:type="chips.statements.dataflow:declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="counter"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements:attribute_declaration"
        decl_identifier="ctx_countSpeed">
      <attribute
          name="ctx_countSpeed"
          contextual="true"
          value="countSpeed"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="countSpeed"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:assignment"
        variable="counter">
      <expr
          xsi:type="chips.expressions:direct_int"/>
    </init_statements>
    <then_statements
        xsi:type="chips.statements.dataflow:if_else">
      <condition
          xsi:type="chips.expressions:variable_expression"
          variable="onOffButton"/>
      <if_statements
          xsi:type="chips.statements.dataflow:assignment"
          variable="counter">
        <expr
            xsi:type="chips.expressions:binary_expression"
            symbol="+">
          <left
              xsi:type="chips.expressions:variable_expression"
              variable="counter"/>
          <right
              xsi:type="chips.expressions:variable_expression"
              variable="countSpeed"/>
        </expr>
      </if_statements>
      <else_statements
          xsi:type="chips.statements.dataflow:assignment"
          variable="counter">
        <expr
            xsi:type="chips.expressions:direct_int"/>
      </else_statements>
    </then_statements>
    <channels
        type="SerialChannel"
        name="plug"/>
    <parameters
        sensor="true">
      <variable
          xsi:type="chips.instances:bool_variable"
          name="onOffButton"/>
    </parameters>
    <outputs
        name="cnt">
      <expression
          xsi:type="chips.expressions:variable_expression"
          variable="counter"/>
    </outputs>
  </preambles>
  <preambles
      xsi:type="chips.definitions:node_def"
      spec_filename="../devices/counterReferenceSuperBrand.json"
      support="//@preambles.0">
    <mappings
        xsi:type="chips.statements.node:channel_mapping"
        JSON_related_attribute="serial_PIN0"
        channel="//@preambles.0/@channels.0"/>
    <mappings
        xsi:type="chips.statements.node:contextual_mapping"
        JSON_related_attribute="counterSpeedDefaultConfig"
        ctx_attr="//@preambles.0/@init_statements.1"/>
  </preambles>
</chips:program>
