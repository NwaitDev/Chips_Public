<?xml version="1.0" encoding="UTF-8"?>
<chips:program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:chips="http://chips"
    xmlns:chips.instances="http://chips/instances"
    xmlns:chips.rvalues.expressions="http://chips/rvalues/expressions"
    xmlns:chips.statements.dataflow="http://chips/statements/dataflow"
    xmlns:chips.statements.implementation="http://chips/statements/implementation"
    xmlns:chips.statements.object="http://chips/statements/object"
    xmlns:chips.statements.system="http://chips/statements/system"
    xmlns:definitions="http://chips/definitions"
    xsi:schemaLocation="http://chips chips2.ecore http://chips/instances chips2.ecore#//instances http://chips/rvalues/expressions chips2.ecore#//rvalues/expressions http://chips/statements/dataflow chips2.ecore#//statements/dataflow http://chips/statements/implementation chips2.ecore#//statements/implementation http://chips/statements/object chips2.ecore#//statements/object http://chips/statements/system chips2.ecore#//statements/system http://chips/definitions chips2.ecore#//definitions"
    fileName="aPhysicalCounter.chips">
  <preambles
      xsi:type="definitions:physical_definition"
      name="aPhysicalCounter">
    <with_statements
        xsi:type="chips.statements.object:channel_declaration"
        type_identifier="SerialChannel"
        name="plug"/>
    <with_statements
        xsi:type="chips.statements.object:contextual_declaration"
        modelIdentifier="physicalCounteSpeed">
      <variable>
        <variable
            xsi:type="chips.instances:int_variable"
            name="countSpeed"/>
      </variable>
      <value
          xsi:type="chips.rvalues.expressions:direct_int"/>
    </with_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:dataflow_declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="counter"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:dataflow_assignment"
        variable="counter">
      <expr
          xsi:type="chips.rvalues.expressions:direct_int"/>
    </init_statements>
    <then_statements
        xsi:type="chips.statements.dataflow:dataflow_if_else">
      <condition
          xsi:type="chips.rvalues.expressions:variable_expression"
          variable="onOffButton"/>
      <if_statements
          xsi:type="chips.statements.dataflow:dataflow_assignment"
          variable="counter">
        <expr
            xsi:type="chips.rvalues.expressions:binary_expression"
            symbol="+">
          <left
              xsi:type="chips.rvalues.expressions:variable_expression"
              variable="counter"/>
          <right
              xsi:type="chips.rvalues.expressions:variable_expression"
              variable="countSpeed"/>
        </expr>
      </if_statements>
      <else_statements
          xsi:type="chips.statements.dataflow:dataflow_assignment"
          variable="counter">
        <expr
            xsi:type="chips.rvalues.expressions:direct_int"/>
      </else_statements>
    </then_statements>
    <parameters
        sensor="true">
      <declaration>
        <variable
            xsi:type="chips.instances:bool_variable"
            name="onOffButton"/>
      </declaration>
    </parameters>
    <outputs
        name="cnt">
      <expression
          xsi:type="chips.rvalues.expressions:variable_expression"
          variable="counter"/>
    </outputs>
  </preambles>
  <preambles
      xsi:type="definitions:node_definition"
      name="AbstractObject">
    <with_statements
        xsi:type="chips.statements.object:channel_declaration"
        type_identifier="SerialChannel"
        name="abstractPlug"/>
    <with_statements
        xsi:type="chips.statements.object:contextual_declaration"
        modelIdentifier="abstractContextualVariable">
      <variable>
        <variable
            xsi:type="chips.instances:int_variable"
            name="abstractObjectSpecificParameter"/>
      </variable>
    </with_statements>
  </preambles>
  <preambles
      xsi:type="definitions:implementation_definition"
      name="abstractObjectByCounter"
      implemented_object="//@preambles.1"
      implementing_object="//@preambles.0">
    <having_statements
        xsi:type="chips.statements.implementation:channel_aliasing"
        implementing_channel="//@preambles.0/@with_statements.0"
        implemented_channel="//@preambles.1/@with_statements.0"/>
    <having_statements
        xsi:type="chips.statements.implementation:contextual_aliasing"
        implementing_var="//@preambles.0/@with_statements.1"
        implemented_var="//@preambles.1/@with_statements.1"/>
  </preambles>
  <system xsi:type="chips.statements.system:system_function_declaration"
      definition="//@preambles.0">
    <function
        xsi:type="chips.instances:physical_function_variable"
        name="pc"/>
  </system>
  <system xsi:type="chips.statements.system:system_node_declaration"
      def="//@preambles.1">
    <node name="ao"/>
  </system>
  <system xsi:type="chips.statements.system:implements_statement"
      implemented_object="ao"
      implementing_object="pc"
      implmentation="//@preambles.2"/>
  <system xsi:type="chips.statements.system:system_dataflow_assignment"
      variable="onOffButton">
    <expr xsi:type="chips.rvalues.expressions:direct_bool"
        value="true"/>
  </system>
</chips:program>
