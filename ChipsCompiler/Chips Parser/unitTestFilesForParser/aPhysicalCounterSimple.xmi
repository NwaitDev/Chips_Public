<?xml version="1.0" encoding="UTF-8"?>
<chips:program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:chips="http://chips"
    xmlns:chips.instances="http://chips/instances"
    xmlns:chips.rvalues.expressions="http://chips/rvalues/expressions"
    xmlns:chips.statements.dataflow="http://chips/statements/dataflow"
    xmlns:chips.statements.object="http://chips/statements/object"
    xmlns:definitions="http://chips/definitions"
    xsi:schemaLocation="http://chips chips2.ecore http://chips/instances chips2.ecore#//instances http://chips/rvalues/expressions chips2.ecore#//rvalues/expressions http://chips/statements/dataflow chips2.ecore#//statements/dataflow http://chips/statements/object chips2.ecore#//statements/object http://chips/definitions chips2.ecore#//definitions"
    fileName="aPhysicalCounter.chips">
  <preambles
      xsi:type="definitions:physical_definition"
      name="aPhysicalCounter">
    <with_statements
        xsi:type="chips.statements.object:channel_declaration"
        type_identifier="SerialChannel"
        name="plug"/>
    <with_statements
        xsi:type="chips.statements.object:contextual_declaration"
        modelIdentifier="physicalCounteSpeed">
      <variable>
        <variable
            xsi:type="chips.instances:int_variable"
            name="countSpeed"/>
      </variable>
      <value
          xsi:type="chips.rvalues.expressions:direct_int"/>
    </with_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:dataflow_declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="counter"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:dataflow_assignment"
        variable="counter">
      <expr
          xsi:type="chips.rvalues.expressions:direct_int"/>
    </init_statements>
    <then_statements
        xsi:type="chips.statements.dataflow:dataflow_if_else">
      <condition
          xsi:type="chips.rvalues.expressions:variable_expression"
          variable="onOffButton"/>
      <if_statements
          xsi:type="chips.statements.dataflow:dataflow_assignment"
          variable="counter">
        <expr
            xsi:type="chips.rvalues.expressions:binary_expression"
            symbol="+">
          <left
              xsi:type="chips.rvalues.expressions:variable_expression"
              variable="counter"/>
          <right
              xsi:type="chips.rvalues.expressions:variable_expression"
              variable="countSpeed"/>
        </expr>
      </if_statements>
      <else_statements
          xsi:type="chips.statements.dataflow:dataflow_assignment"
          variable="counter">
        <expr
            xsi:type="chips.rvalues.expressions:direct_int"/>
      </else_statements>
    </then_statements>
    <parameters
        sensor="true">
      <declaration>
        <variable
            xsi:type="chips.instances:bool_variable"
            name="onOffButton"/>
      </declaration>
    </parameters>
    <outputs
        name="cnt">
      <expression
          xsi:type="chips.rvalues.expressions:variable_expression"
          variable="counter"/>
    </outputs>
  </preambles>
</chips:program>
