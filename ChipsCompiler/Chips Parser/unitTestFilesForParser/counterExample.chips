physical PhysicalCounter (sensor bool onOffButton) with {
    SerialChannel plug;
    ctx int countSpeed = 1;
} init {
    int counter = 0;
} then {
    if (onOffButton) {
        counter = counter + countSpeed;
    } else {
        counter = 0;
    }
} -> cnt(counter)

object AbstractObject with {
    AbstractChannel abstractPlug;
    ctx int specificParameter;
}

implementation abstractObjectByCounter : AbstractObject by aPhysicalCounter {
    having plug as abstractPlug; // [1]*
    having countSpeed as abstractObjectSpecificParameter;
}


physical ButtonPusher () -> actuator push(true)

system {
    PhysicalCounter pc;
    ButtonPusher bp;
    AbstractObject ao;
    pc implements ao using abstractObjectByCounter;

    pc.onOffButton(bp.push);
}