<?xml version="1.0" encoding="UTF-8"?>
<chips:program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:chips="http://chips"
    xmlns:chips.definitions="http://chips/defintions"
    xmlns:chips.expressions="http://chips/expressions"
    xmlns:chips.instances="http://chips/instances"
    xmlns:chips.statements.dataflow="http://chips/statements/dataflow"
    xsi:schemaLocation="http://chips chips.ecore http://chips/defintions chips.ecore#//definitions http://chips/expressions chips.ecore#//expressions http://chips/instances chips.ecore#//instances http://chips/statements/dataflow chips.ecore#//statements/dataflow">
  <preambles
      xsi:type="chips.definitions:logical_def"
      name="aLogicalComponent">
    <parameters>
      <variable
          xsi:type="chips.instances:int_variable"
          name="aParameter"/>
    </parameters>
    <parameters>
      <variable
          xsi:type="chips.instances:int_variable"
          name="anotherParameter"/>
    </parameters>
    <init_statements
        xsi:type="chips.statements.dataflow:declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="innerVar"/>
    </init_statements>
    <init_statements
        xsi:type="chips.statements.dataflow:assignment"
        variable="innerVar">
      <expr
          xsi:type="chips.expressions:binary_expression"
          symbol="+">
        <left
            xsi:type="chips.expressions:variable_expression"
            variable="aParameter"/>
        <right
            xsi:type="chips.expressions:variable_expression"
            variable="anotherParameter"/>
      </expr>
    </init_statements>
    <then_statements
        xsi:type="chips.statements.dataflow:if_else">
      <condition
          xsi:type="chips.expressions:binary_expression"
          symbol="&lt;=">
        <left
            xsi:type="chips.expressions:variable_expression"
            variable="innerVar"/>
        <right
            xsi:type="chips.expressions:direct_int"
            value="100"/>
      </condition>
      <if_statements
          xsi:type="chips.statements.dataflow:assignment"
          variable="tempOutput">
        <expr
            xsi:type="chips.expressions:direct_int"
            value="100"/>
      </if_statements>
      <else_statements
          xsi:type="chips.statements.dataflow:assignment"
          variable="tempOutput">
        <expr
            xsi:type="chips.expressions:variable_expression"
            variable="innerVar"/>
      </else_statements>
    </then_statements>
    <then_statements
        xsi:type="chips.statements.dataflow:declaration">
      <variable
          xsi:type="chips.instances:int_variable"
          name="tempOutput"/>
    </then_statements>
    <outputs
        name="theOutput">
      <expression
          xsi:type="chips.expressions:variable_expression"
          variable="tempOutput"/>
    </outputs>
  </preambles>
</chips:program>
