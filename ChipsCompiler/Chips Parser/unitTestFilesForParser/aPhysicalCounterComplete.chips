physical aPhysicalCounter (sensor bool onOffButton) with {
    SerialChannel plug;
    int countSpeed = 1;
} init {
    int counter = 0;
} then {
    if (onOffButton) {
        counter = counter + countSpeed;
    } else {
        counter = 0;
    }
} -> cnt(counter)

object AbstractObject with {
    SerialChannel abstractPlug;
    ctx int abstractObjectSpecificParameter;
}

implementation abstractObjectByCounter : AbstractObject by aPhysicalCounter {
    having plug as abstractPlug;
    having countSpeed as abstractObjectSpecificParameter;
}

system {
    aPhysicalCounter pc;
    AbstractObject ao;
    pc implements ao using abstractObjectByCounter;

    pc.onOffButton(true);
}