// Component producing a signal
logical aFirstComponent () init {
    int foo = 10;
} then {
    foo = foo -1;
} -> toBeSpread (foo)

// Some specification to mimic a spatial propagation of signals
node aPlaceholder with {
    Neighbor next;
    Neighbor previous;
}

// A function that outputs its coef if it is activated
logical aSubComponentOfTheSecondComponent(bool activation, int coef)
init {
    int output;
}
then {
    if (activation) {
        output = coef;
    } else {
        output = 0;
    }
} -> toBeCollected(output)

// A dummy component to complete the system ("print" is not yet defined)
logical aLastComponent(int bar) init {} then {
    // print(bar);
}

// spread operator that produces a list of "true"
// terminating with a "false" as long as
// the received message is positive
// propagation is stopped otherwise
spread (int msg = input) 
trueAsLongAsPositive among aPlaceholder {
    int myMsg = msg;
    bool currentActivation = false;
    bool msgToNext;
    if (myMsg > 1) {
        currentActivation = true;
        msgToNext = myMsg - 1;
    } else {
        msgToNext = stop;
    }
} -> @(currentActivation)
-> next(msgToNext)
-> default(stop)



// model simulating a 1D example
system {
    
    aFirstComponent componentOne;


    int nbSubComponents = 3;
    aSubComponentOfTheSecondComponent[nbSubComponents] componentTwo;
    aPlaceholder[nbSubComponents] placeholders;

    link componentOne to placeholders[0];

    // Really needs improvement on this part
    // currently assuming the following array
    // will contain {0, 1, 2} 
    int [nbSubComponents] range; // need for a range function like in python
    for i in range {

        // setting the virtual position of the function
        link componentTwo[i] to placeholders[i];

        // defining the configuring parameter of the function
        componentTwo[i].coef(i+1);

        
        componentTwo[i].activation((trueAsLongAsPositive) componentOne.toBeSpread);
        
        // plugging the channels together
        if (i > 0){
            placeholders[i].previous(placeholders[i-1].next);
            placeholders[i-1].next(placeholders[i].previous);
        }

    }

}