import "server.json" as server;
import "user_computer.json" as user_computer;


/* 
    User Computer action

    STAY || LEAVE
    ASK_FOR_NEW_PAGE ||  ASK_FOR_PREVIOUS_PAGE
    PRIVATE_PAGE || PUBLIC_PAGE
    PROVIDES_AUTH_DATA || NO_AUTH_DATA
*/


virtual user_computer_actions(enums resources) init {
    enums action = ASK_FOR_NEW_PAGE | PUBLIC_PAGE | NO_AUTH_DATA;
    navigation_step = 0;
} then {
    switch(navigation_step) {
        1: 
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_NEW_PAGE | PUBLIC_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        4: 
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_NEW_PAGE | PRIVATE_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        5:
            if( resources & (PAGE | CONNEXION_PAGE) != 0 ){
                action = STAY | ASK_FOR_NEW_PAGE | PRIVATE_PAGE | PROVIDES_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        6:
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_NEW_PAGE | PRIVATE_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        10: 
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_PREVIOUS_PAGE | PRIVATE_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        15: 
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_PREVIOUS_PAGE | PRIVATE_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        20: 
            if( resources & (PAGE | OTHER_PAGE) != 0 ){
                action = STAY | ASK_FOR_PREVIOUS_PAGE | PRIVATE_PAGE | NO_AUTH_DATA;
            } else {
                action = LEAVE;
            }
        30: action = LEAVE;
        default: // same action
    }
    navigation_step = navigation_step +1;
} -> (action)

/*
    User Input Interpreter data req

    IS_CONNECTED || IS_NOT_CONNECTED
    ASK_FOR_NEW_PAGE ||  ASK_FOR_PREVIOUS_PAGE
    PRIVATE_PAGE || PUBLIC_PAGE

    User Input Interpreter auth data

    PROVIDES_AUTH_DATA || NO_AUTH_DATA
*/

virtual user_action_interpreter (enums action) init {
    enums data_req = IS_NOT_CONNECTED | ASK_FOR_NEW_PAGE | PUBLIC_PAGE ;
    enums auth_data = NO_AUTH_DATA ;
    connected = false ;
} then {
    if(action & PROVIDES_AUTH_DATA != 0) {
        auth_data = PROVIDES_AUTH_DATA;
    } else {
        auth_data = NO_AUTH_DATA;
    }
    if(action & (STAY | ASK_FOR_NEW_PAGE | PUBLIC_PAGE) != 0 ){
        if (connected){
            data_req = IS_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE;
        } else {
            data_req = IS_NOT_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE;
        }
    }
    if(action & (STAY | ASK_FOR_PREVIOUS_PAGE | PUBLIC_PAGE) != 0 ){
        if (connected){
            data_req = IS_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE;
        } else {
            data_req = IS_NOT_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE;
        }
    }

    if(action & (STAY | ASK_FOR_NEW_PAGE | PRIVATE_PAGE) != 0 ){
        if (connected){
            data_req = IS_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE;
        } else {
            data_req = IS_NOT_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE;
        }
    }
    if(action & (STAY | ASK_FOR_PREVIOUS_PAGE | PRIVATE_PAGE) != 0 ){
        if (connected){
            data_req = IS_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE;
        } else {
            data_req = IS_NOT_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE;
        }
    }

    if(action & LEAVE != 0) {
        // maybe add a special command to specify the component end of use ?
    }
    
} -> (data_req, auth_data)




/*
    Request Validator auth required

    true||false

    Request Validator validated request

    VALIDATED || INVALIDATED
    ASK_FOR_NEW_PAGE || ASK_FOR_PREVIOUS_PAGE
    PRIVATE_PAGE || PUBLIC_PAGE
*/

virtual request_validator(enums data_req) init {
    enums validated_req = INVALIDATED;
    bool auth_required = false;
} then {
    if(data_req & (IS_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE) != 0 ){
        validated_req = VALIDATED | ASK_FOR_NEW_PAGE | PUBLIC_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_NOT_CONNECTED | PUBLIC_PAGE | ASK_FOR_NEW_PAGE) != 0 ){
        validated_req = VALIDATED | ASK_FOR_NEW_PAGE | PUBLIC_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE) != 0 ){
        validated_req = VALIDATED | ASK_FOR_NEW_PAGE | PRIVATE_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_NOT_CONNECTED | PRIVATE_PAGE | ASK_FOR_NEW_PAGE) != 0 ){
        validated_req = INVALIDATED;
        auth_required = true;
    }
    if(data_req & (IS_CONNECTED | PUBLIC_PAGE | ASK_FOR_PREVIOUS_PAGE) != 0 ){
        validated_req = VALIDATED | ASK_FOR_PREVIOUS_PAGE | PUBLIC_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_NOT_CONNECTED | PUBLIC_PAGE | ASK_FOR_PREVIOUS_PAGE) != 0 ){
        validated_req = VALIDATED | ASK_FOR_PREVIOUS_PAGE | PUBLIC_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_CONNECTED | PRIVATE_PAGE | ASK_FOR_PREVIOUS_PAGE) != 0 ){
        validated_req = VALIDATED | PREVIOUS_PAGE | PRIVATE_PAGE;
        auth_required = false;
    }
    if(data_req & (IS_NOT_CONNECTED | PRIVATE_PAGE | ASK_FOR_PREVIOUS_PAGE) != 0 ){
        validated_req = INVALIDATED;
        auth_required = true;
    }
} -> (validated_req, auth_required)


/* 
    Authentication Function

    PAGE || NO_PAGE
    CONNEXION_PAGE || PREVIOUS_PAGE
*/

virtual authentication_func(bool auth_required, bool auth_data) init {
    enums provided_page = NO_PAGE;
} then {
    if (auth_required && (auth_data == NO_AUTH_DATA)){
        provided_page = PAGE | CONNEXION_PAGE;
    }
    if (auth_required && (auth_data == PROVIDES_AUTH_DATA)) {
        provided_page = PAGE | PREVIOUS_PAGE;
    }
    if (!auth_required) {
        provided_page = NO_PAGE;
    }
} -> (provided_page)

/*
    Data Treatment Block DB request

    IMAGES_IDs || NOTHING

    Data Treatment Block requested data

    IMAGES || NOTHING
*/
virtual data_treatment(enums validated_req, enums db_responses) init {
    enums db_requests = NOTHING;
    enums data_requested = NOTHING;
} then {
    if( validated_req & (VALIDATED) != 0){
        if (validated_req & PREVIOUS_PAGE) {
            db_requests = NOTHING;
            data_requested = IMAGES; // previous page so supposedly already loaded
        } else {
            db_requests = IMAGES_IDs;
            data_requested = NOTHING;
        }
        if (db_responses & IMAGES != 0){
            data_requested = IMAGES;
        }
    }else{
        db_requests = NOTHING;
        data_requested = NOTHING;
    }
} -> (db_requests, data_requested)

/*
    Data Collection Block DB response

    IMAGES || NOTHING
*/
virtual data_collection(enums db_requests)init{
    enums db_responses = NOTHING;
}then{
    if(db_requests & IMAGES_IDs != 0){
        db_responses = IMAGES;
    }else{
        db_responses = NOTHING;
    }
}->(db_responses)


/*
    Web Page Service resources

    PAGE || NO_PAGE
    CONNEXION_PAGE || OTHER_PAGE
    PREVIOUS_PAGE || NEW_PAGE
*/
virtual page_service (enums data_requested, enums provided_page) init {
    enums resources = PAGE | OTHER_PAGE | NEW_PAGE;
} then {
    if(data_requested == NOTHING) {
        if (provided_page & NOTHING != 0 ){
            resources = NO_PAGE;
        } else {
            if (provided_page & CONNEXION_PAGE != 0){
                resources = PAGE | CONNEXION_PAGE;
            } else {
                resources = PAGE | OTHER_PAGE | PREVIOUS_PAGE;
            }
        }
    }else{
        resources = PAGE | OTHER_PAGE | NEW_PAGE;
    }
} -> (resources)

physical user_computer(enums in_actions, enums out_resources) init {
    this.out.port00 = in_actions;
    this.in.port00 = out_resources;
} then {
    this.out.port00 = in_actions;
    this.in.port00 = out_resources;
} -> (in_actions, out_resources)

physical server(enums in_resources, out_actions) init {
    this.in.port00 = out_actions;
    this.out.port00 = in_resources;
} then {
    this.in.port00 = out_actions;
    this.out.port00 = in_resources;
} -> (in_resources, out_actions)

system(3){

    user_computer_actions uca;      // virtual func
    user_action_interpreter uai;    // virtual func
    request_validator rv;           // virtual func
    data_treatment dt;              // virtual func
    data_collection dc;             // virtual func
    authentication_func af;         // virtual func
    page_service ps;                // virtual func

    user_computer uc;               // physical func
    server s;                       // physical func

    uca.in(uc.out[1]);
    uc.in(uca.out, s.out[0]);
    s.in(ps.out, uc.out[0]);
    uai.in(s.out[1]);
    rv.in(uai.out[0]);
    af.in(rv.out[1],uai.out[1]);
    dt.in(rv.out[0],dc.out);
    dc.in(dt.out[0]);
    ps.in(dt.out[1],af.out);

    link uca to uc;
    uc at (0,0,0);

    link uai to s;
    link rv to s;
    link dt to s;
    link dc to s;
    link af to s;
    link ps to s;
    s at (2,2,0);
}