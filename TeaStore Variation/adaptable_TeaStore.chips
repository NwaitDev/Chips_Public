//           CONSTANTS

// indicates that a new data is sent to the server
// in case of implementation of asynchronicity
pure SIGNAL() -> (0x1)

// indicates that the user is staying on the 
// web site
pure STAY() -> (0x1<<1)

// indicates that the user is leaving the 
// web site
pure LEAVE() -> (0x0<<1)

// indicating the qty of images requested
pure ASK_FOR_FEW_IMAGES() -> (0x0<<2)
pure ASK_FOR_MANY_IMAGES() -> (0x1<<2)

// the kind of pages requested
pure PUBLIC_PAGE() -> (0x0<<3)
pure PRIVATE_PAGE() -> (0x1<<3)

// the authentication data of the user
pure NO_AUTH_DATA() -> (0x0<<4)
pure AUTH_DATA() -> (0x1<<4)


pure DEFAULT_IMG_NUM() -> (2)
pure ADDITIONAL_IMG_CONNECTED() -> (1)
pure ADDITIONAL_IMG_BIG_REQ() -> (5)
pure ADDITIONAL_IMG_PRIVATE() -> (2)

pure DEFAULT_CACHE_SIZE() -> (20)

pure DB_REQ_TIME() -> (2.0)

pure CONNECTION_PAGE() -> (2)
pure PAGE() -> (1)
pure NO_PAGE() -> (0)

import "server.json" as server_interface;

/*
        Server Interface

            -----
virt out -->|///|--> phy out
            |///| 
            |///| 
virt in  <--|///|<-- phy in
            -----
*/
atom type server_interface(int phy_in, int virt_out) init {
    int virt_in = 0;
    int phy_out = 0;
} then {
    virt_in = phy_in;
    phy_out = virt_out;
} -> (phy_out, virt_in)



import "user_computer.json" as user_computer_interface;
/*
    User Computer Interface

            -----
virt out -->|///|--> phy out
            |///| 
            |///| 
virt in  <--|///|<-- phy in
            -----
*/
physical user_computer_interface(int phy_in, int virt_out) init {
    int virt_in = 0;
    int phy_out = 0;
} then {
    virt_in = phy_in;
    phy_out = virt_out;
} -> (phy_out, virt_in)




pure p() -> (-1)
pure i() -> (-0.01)
pure d() -> (0)

pure pid(float error, float ierror, float derror)
    -> (p*error + i*ierror + d*derror)


logical user_action_model(int resources) init {
    int nav_step = 0;
    int last_step = 850;
    int mode_change_step = 300;
    int user_action = 
        SIGNAL()
        +STAY()
        +ASK_FOR_FEW_IMAGES()
        +PUBLIC_PAGE()
        +NO_AUTH_DATA();
} then {
    if(nav_step == mode_change_step){
        user_action = 
            SIGNAL()
            +STAY()
            +ASK_FOR_MANY_IMAGES()
            +PUBLIC_PAGE()
            +NO_AUTH_DATA();
    }
    nav_step +=1;
    if(nav_step == last_step){
        deadlock;
    }
}

logical user_action_interpreter(int user_action) init {
    bool is_new_req = false;
    bool auth_data = false;
    int img_qty = 0;

    parameter_mask = STAY() | LEAVE() | ASK_FOR_FEW_IMAGES() | ASK_FOR_MANY_IMAGES() | PUBLIC_PAGE() | PRIVATE_PAGE()
} then {
    is_new_req = ( (user_action & SIGNAL) == SIGNAL);
    if (is_new_req) {
        auth_data = (user_action & AUTH_DATA() == AUTH_DATA());
        
        if ((user_action & parameter_mask) == 
            (STAY() | ASK_FOR_FEW_IMAGES() | PUBLIC_PAGE()) ){
            data_req = ASK_FOR_FEW_IMAGES() | PUBLIC_PAGE();
        }
        if ((user_action & parameter_mask) == 
            (STAY() | ASK_FOR_MANY_IMAGES() | PUBLIC_PAGE()) ){
            data_req = ASK_FOR_MANY_IMAGES() | PUBLIC_PAGE();
        }
        if ((user_action & parameter_mask) == 
            (STAY() | ASK_FOR_FEW_IMAGES() | PRIVATE_PAGE()) ){
            data_req = ASK_FOR_FEW_IMAGES() | PRIVATE_PAGE();
        }
        if ((user_action & parameter_mask) == 
            (STAY() | ASK_FOR_MANY_IMAGES() | PRIVATE_PAGE()) ){
            data_req = ASK_FOR_MANY_IMAGES() | PRIVATE_PAGE();
        }
    }
} -> (auth_data, is_new_req, data_req)

logical request_validator (bool is_authenticated, bool is_new_req, int data_req) init {
    int nb_imgs_to_provide = 0;
    bool validated = false;
} then {
    if(!is_new_req){
        nb_imgs_to_provide = 0;
    } else {
        if (is_authenticated) {
            if ( data_req == PUBLIC_PAGE() | ASK_FOR_FEW_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM() + ADDITIONAL_IMG_CONNECTED();
            }
            if ( data_req == PUBLIC_PAGE() | ASK_FOR_MANY_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM() + ADDITIONAL_IMG_BIG_REQ() + ADDITIONAL_IMG_CONNECTED();
            }
            if ( data_req == PRIVATE_PAGE() | ASK_FOR_FEW_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM() + ADDITIONAL_IMG_PRIVATE() + ADDITIONAL_IMG_CONNECTED();
            }
            if ( data_req == PRIVATE_PAGE() | ASK_FOR_MANY_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM() + ADDITIONAL_IMG_BIG_REQ() +ADDITIONAL_IMG_PRIVATE() + ADDITIONAL_IMG_CONNECTED();
            }
        } else {
            if ( data_req == PUBLIC_PAGE() | ASK_FOR_FEW_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM();
            }
            if ( data_req == PUBLIC_PAGE() | ASK_FOR_MANY_IMAGES() ){
                validated = true;
                nb_imgs_to_provide = DEFAULT_IMG_NUM() + ADDITIONAL_IMG_BIG_REQ();
            }
            if ( data_req == PRIVATE_PAGE() | ASK_FOR_FEW_IMAGES() ){
                validated = false;
                nb_imgs_to_provide = 0;
            }
            if ( data_req == PRIVATE_PAGE() | ASK_FOR_MANY_IMAGES() ){
                validated = false;
                nb_imgs_to_provide = 0;
            }
        }
    }
} -> (validated, nb_imgs_to_provide)

logical authentication_function(bool auth_data) init {
    bool is_authenticated = false;
} then {
    if(auth_data){
        is_authenticated = true;
    }
} -> (is_authenticated)

logical img_provider_controller(float requested_time, float resulting_time) init {
    float derivative = 0;
    float integral = 0;
    float error = 0;
    float dt = 0;
    int cache_size = 5;
    int minimum_cache_size = 20;
    int maximum_cache_size = 100;
} then {
    dt = resulting_time;
    error = expected - received;
    integral += error * dt;
    derivative = error / dt;
    cache_size = int(pid(error, integral, derivative));
    cache_size = min(maximum_cache_size, cache_size);
    cache_size = max(minimum_cache_size, cache_size);
} -> (cache_size)


logical image_provider(bool is_validated, int nb_imgs_to_provide, int cache_size) init {
    int [] cache = empty_priority_list_of_size(DEFAULT_CACHE_SIZE());
    float time_since_last_req = 0;
    int img_to_fetch = 0;
} then {
    if(is_validated){
        cache = resize(cache, cache_size);
        time_since_last_req = 0;
        for i in count_up_to(nb_imgs_to_provide) {
            img_to_fetch = rnd_img_id();
            if( !find(img_to_fetch,cache) ){
                // simulating db request and response
                time_since_last_req += DB_REQ_TIME();
            }
            lru_update(cache, img_to_fetch);
        }
    }
} -> (is_validated, time_since_last_req)

virtual web_page_service(bool is_validated) init{
    int page = NO_PAGE();
} then {
    if (is_validated) {
        page = PAGE();
    } else {
        page = CONNECTION_PAGE();
    }
} -> (page)

SYSTEM {
    // virtual modules
    web_page_service wpservice;
    image_provider iprovider;
    img_provider_controller ipcontroller;
    authentication_function afunction;
    request_validator rvalidator;
    user_action_interpreter uainterpreter;
    user_action_model uamodel;

    // physical interfaces
    user_computer_interface ucinterface;
    server_interface sinterface;

    // linking services to the devices they are on
    link uamodel to ucinterface
    link uainterpreter to sinterface
    link rvalidator to sinterface
    link afunction to sinterface
    link ipcontroller to sinterface
    link iprovider to sinterface
    link wpservice to sinterface

    // interconnections
    uamodel.in(ucinterface.out[1]);
    ucinterface.in(sinterface.out[0], uamodel.out);
    sinterface.in(ucinterface.out[0], wpservice.out);

    uainterpreter.in(sinterface.out[1]);
    afunction.in(uainterpreter.out[0]);
    rvalidator.in(afunction.out, uainterpreter.out[1], uainterpreter.out[2]);
    ipcontroller.in( 3/*seconds*/, iprovider.out[1]);
    iprovider.in(rvalidator.out[0], rvalidator.out[1], ipcontroller.out)
    wpservice.in(iprovider.out);
}