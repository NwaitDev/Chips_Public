    atom type web_page_service()
        data int response
        export port port1int_t send_response(response)

        data bool page_result
        export port port1bool_t get_requested_data(page_result)
        
        place RES_SENT, PAGE_RCVD

        initial to RES_SENT do {
            response = cst("R_NO_PAGE");
            page_result = false;
        }

        on get_requested_data from RES_SENT to PAGE_RCVD do {
            if (page_result) then 
                response = cst("R_PAGE") | cst("R_OTHER_PAGE") | cst("R_NEW_PAGE");
            else
                response = cst("R_PAGE") | cst("R_CONNEXION_PAGE");
            fi
        }
        on send_response from PAGE_RCVD to RES_SENT
        
    end

end