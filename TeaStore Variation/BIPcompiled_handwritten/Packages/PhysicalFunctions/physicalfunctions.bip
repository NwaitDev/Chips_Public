@cpp(include="filestuff.hpp,utils.hpp")
// need to include this anyway because otherwise, the cpp compiler is lost
// even if the associated bip files are used


package physicalfunctions

    use base // for the most basic ports of each components
    use utils // utility functions to make the semantic of the program easier
    use filestuff // to write into files

    atom type UserComputerInterface()
        
        data int user_data
        data int server_data
        

        /*
                User Computer Interface

                        -----
            virt out -->|///|--> phy out
                        |///| 
                        |///| 
             virt in <--|///|<-- phy in
                        -----
        */

        export port port1int_t virt_in(server_data)
        export port port1int_t phy_in(server_data)
        export port port1int_t phy_out(user_data)
        export port port1int_t virt_out(user_data)

        place VIRT_RCVD, PHY_SENT, VIRT_SENT, PHY_RCVD

        initial to VIRT_SENT do {
            user_data = 0;
            server_data = -1;
        }


        on virt_out from VIRT_SENT to VIRT_RCVD

        on phy_out from VIRT_RCVD to PHY_SENT

        on phy_in from PHY_SENT to PHY_RCVD

        on virt_in from PHY_RCVD to VIRT_SENT 
  
    end

    atom type ServerInterface()
        
        data int user_data
        data int server_data
        

        /*
                    Server Interface

                        -----
            virt out -->|///|--> phy out
                        |///| 
                        |///| 
             virt in <--|///|<-- phy in
                        -----
        */

        export port port1int_t virt_in(user_data)
        export port port1int_t phy_in(user_data)
        export port port1int_t phy_out(server_data)
        export port port1int_t virt_out(server_data)

        place VIRT_RCVD, PHY_SENT, VIRT_SENT, PHY_RCVD

        initial to PHY_SENT do {
            user_data = -1;
            server_data = 0;
        }

        on virt_in from PHY_RCVD to VIRT_SENT 

        on virt_out from VIRT_SENT to VIRT_RCVD

        on phy_out from VIRT_RCVD to PHY_SENT

        on phy_in from PHY_SENT to PHY_RCVD
  
    end

end