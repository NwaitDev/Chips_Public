@cpp(include="stdio.h,base.hpp")


package main

    use base
    use virtualfunctions
    use physicalfunctions
    
    compound type data_treatment_block()
        component img_provider_controller imgpcontroller()
        component img_provider imgprovider()

        connector flow1int_t cacheparameter(imgpcontroller.knob, imgprovider.get_cache_size)
        connector flow1floatAndExport_t responsetime(imgprovider.send_res_time, imgpcontroller.measure)

        export port responsetime.p as response_time
        export port imgprovider.send_requested_data as requested_data
        export port imgprovider.get_nb_new_images as get_nb_new_images
        export port imgprovider.get_validation as get_validation
        export port imgpcontroller.command_port as required_time

        export port imgprovider.send_db_req as db_req
        export port imgprovider.get_db_res as db_res
    end

    /*
        TeaStore Model from Chips a la mano compilation to BIP    
    */
    compound type mainCompound()

        //component actions_scenario_heavyweight_public actions()
        component actions_scenario_light2heavyweight_public actions()



        // physical devices
        component ServerInterface server()
        component UserComputerInterface usercomputer()

        // virtual functions
        component data_treatment_block dtb()
        component web_page_service wpservice()
        component data_collection dcollector()
        component authentication_function authfunc()
        component request_validator rqvalidator()
        component user_action_interpreter uainterpreter()
        component pid_controller generalcontroller()

        connector flow1int_t inner_computer_action(actions.virt_out, usercomputer.virt_out)
        connector flow1int_t inter_interfaces_action(usercomputer.phy_out, server.phy_in)
        connector flow1int_t inner_server_action(server.virt_in, uainterpreter.get_user_actions)
        connector flow1bool_t auth_data(uainterpreter.send_auth, authfunc.get_auth_data)
        connector flow1int_t data_req(uainterpreter.send_data_req, rqvalidator.get_data_req)
        connector flow1bool_t data_newness(uainterpreter.send_newness, rqvalidator.get_newness)
        connector flow1bool_t auth_state(authfunc.send_auth_state, rqvalidator.get_auth_state)
        connector flow1int_t nb_new_images(rqvalidator.send_nb_new_images, dtb.get_nb_new_images)
        connector flow1bool_t validation(rqvalidator.send_validation, dtb.get_validation)
        connector sync1to1port_t db_req(dtb.db_req,dcollector.get_request)
        connector sync1to1port_t db_res(dcollector.send_response, dtb.db_res)
        connector flow1bool_t requested_data(dtb.requested_data, wpservice.get_requested_data)
        connector flow1int_t inner_server_resources(wpservice.send_response, server.virt_out)
        connector flow1int_t inter_interfaces_resources(server.phy_out, usercomputer.phy_in)
        connector flow1int_t inner_computer_resources(usercomputer.virt_in, actions.virt_in)

        connector flow1float_t feedback_general_controller(dtb.response_time, generalcontroller.measure)
        connector flow1float_t command_general_controller(generalcontroller.knob ,dtb.required_time)

        connector sync1port_t earlydeadlock(actions.earlydeadlock)

    end
end
